# ==================== Servidor ====================
PORT=3100
# Endereço público do painel (usado nos links dos e-mails de acesso). Obrigatório em produção.
APP_BASE_URL=https://gestao.podcastpulso.com
# Onde ficam os convites públicos (/convite/:token). Opcional: padrão = APP_BASE_URL.
# Pode ser outro domínio apontando pro mesmo serviço, ex.: https://kit.podcastpulso.com
PUBLIC_BASE_URL=
PODCAST_NAME=Podcast Pulso
# WhatsApp da produção (DDI+DDD+número, só dígitos): destino dos botões "Aceitar" e "Falar com a produção" do convite.
PRODUCAO_WHATSAPP=5512991053852
# Segredo p/ assinar tokens CSRF. Obrigatório em produção. Gere com: openssl rand -hex 32
SESSION_SECRET=
# true = aplica as migrations ao subir (seguro com 1 réplica; usa advisory lock)
AUTO_MIGRATE=true

# ==================== PostgreSQL ====================
# Banco PRÓPRIO deste módulo (não use o banco do agente da clínica).
PODCAST_DATABASE_URL=postgresql://usuario:senha@localhost:5432/pulso

# ==================== Brevo (SMTP transacional) ====================
BREVO_SERVER=smtp-relay.brevo.com
BREVO_PORT=587
# Login SMTP (aparece em Brevo > SMTP & API > SMTP; algo como xxxx@smtp-brevo.com)
BREVO_USER=
# Chave SMTP (NÃO é a chave de API v3)
BREVO_CHAVE_SMTP=
# Remetente: precisa ser um remetente/domínio validado na Brevo
BREVO_EMAIL=
# Nome exibido no "De:" (padrão = PODCAST_NAME)
BREVO_FROM_NAME=

# ==================== YOURLS (links curtos dos convites) ====================
# Host do YOURLS (com ou sem https://) e a "signature" da página Tools do admin do YOURLS
YOURLS_LINK=link.podcastpulso.com
YOURLS_KEY=

# ==================== Backblaze B2 (arquivos dos patrocinadores: logo, áudios, moldura, QR Code) ====================
# Chave de aplicação restrita ao bucket (B2 > Application Keys). O endereço S3 é descoberto sozinho.
BB_KEY_ID=
BB_APPLICATION_KEY=
BUCKET_NAME=
# Opcional: força o endereço S3 (ex.: https://s3.us-east-005.backblazeb2.com)
BB_ENDPOINT=

# ==================== Gemini (títulos, descrições, thumbnails e leitura de quadros)
GEMINI_KEY=
# GEMINI_MODEL=gemini-3.8-flash

# ==================== Groq (transcrição de voz do formulário do patrocinador) ====================
GROQ_APIKEY=
# GROQ_WHISPER_MODEL=whisper-large-v3
# WhatsApp comercial (media kit do patrocinador): DDI+DDD+número, só dígitos
PATROCINIO_WHATSAPP=5511971739061

# ==================== Produção de episódios ====================
# Backblaze B2 (arquivos), Groq (transcrição) e Gemini (textos e leitura de quadros): veja as seções acima/abaixo.
# GEMINI_KEY=
# GEMINI_MODEL=gemini-3.8-flash
# Upload-Post (publicação nas redes, insights e automações de comentários/directs). Sem UPLOAD_POST_LIVE=true o painel só SIMULA:
# posts, edições, respostas e directs são montados e conferidos, nada vai para as redes (as leituras — números e comentários — são reais).
UPLOAD_POST_KEY=
UPLOAD_POST_USER=default
UPLOAD_POST_LIVE=false
# Papel do processo: web (painel), worker (fila de FFmpeg/IA/e-mails + rotinas) ou all (os dois; padrão)
# ROLE=all

# ==================== Só desenvolvimento/testes ====================
# true = não envia e-mail de verdade; só registra no console
MAIL_DRY_RUN=false
# Bootstrap do 1º superadmin (usado por: npm run create-superadmin)
# SUPERADMIN_EMAIL=
# SUPERADMIN_NAME=
# SUPERADMIN_PASSWORD=
