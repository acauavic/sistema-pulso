# Cloudflare na frente (nuvem laranja): o IP real de quem acessa vem no cabeçalho CF-Connecting-IP, que só vale quando a
# conexão chega de uma faixa do Cloudflare (https://www.cloudflare.com/ips). De qualquer outro lugar, vale o IP da conexão.
{
	servers {
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		client_ip_headers CF-Connecting-IP
	}
}

# HTTPS automático (Let's Encrypt) para o domínio do painel. O DNS do domínio precisa apontar para este servidor.
{$DOMINIO} {
	encode zstd gzip
	# as cópias do painel (serviço "web") são descobertas pelo DNS do Docker; uma que cair sai da roda por 30 s
	reverse_proxy {
		dynamic a {
			name web
			port 3100
			refresh 10s
		}
		lb_policy least_conn
		lb_try_duration 5s
		fail_duration 30s
		flush_interval -1   # tempo real (SSE) sem buffer
		# o painel recebe um IP só: o real (via Cloudflare) ou o da conexão; com "trust proxy 1" o Express usa este
		header_up X-Forwarded-For {client_ip}
	}
	request_body {
		max_size 300MB
	}
}

# Site do Pulso (estático, gerado pelo container "builder" do repositório site-pulso em /opt/site-pulso/www/dist).
{$SITE_DOMINIO} {
	root * /srv/www/dist
	encode zstd gzip
	header {
		Content-Security-Policy "default-src 'self'; script-src 'self' https://challenges.cloudflare.com; img-src 'self' data:; frame-src https://www.youtube-nocookie.com https://open.spotify.com https://challenges.cloudflare.com; connect-src 'self' https://sistema.podcastpulso.com; form-action 'self' https://podcastpulso.com https://sistema.podcastpulso.com; frame-ancestors 'none'; base-uri 'self'; object-src 'none'"
		# nunca no-referrer: com ele o formulário sem JavaScript chega ao sistema com Origin: null e leva 403
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Content-Type-Options "nosniff"
		Strict-Transport-Security "max-age=31536000"
		-Server
	}
	# imagens têm o hash no nome e as fontes não mudam: cache longo. O resto (HTML, CSS, JS) muda a cada build.
	@longo path /img/* /fonts/*
	header @longo Cache-Control "public, max-age=31536000, immutable"
	@curto not path /img/* /fonts/*
	header @curto Cache-Control "public, max-age=300"
	try_files {path} {path}/index.html
	file_server
	handle_errors {
		@naoexiste expression `{err.status_code} == 404`
		handle @naoexiste {
			rewrite * /404.html
			file_server {
				status 404
			}
		}
		respond "{err.status_code}" {err.status_code}
	}
}

www.{$SITE_DOMINIO} {
	redir https://{$SITE_DOMINIO}{uri} permanent
}
