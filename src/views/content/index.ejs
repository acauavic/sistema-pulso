<%- include('../partials/head') %>
<%
  var KINDS = { post_quote: 'Posts de frase', post_split: 'Tela dividida', carousel: 'Carrossel' };
  var epLabel = function (e) { return (e.number ? 'EP.' + String(e.number).padStart(3, '0') + ' · ' : '') + e.title; };
  var unassigned = clips.filter(function (c) { return !c.episode_id; });
  var assigned = clips.filter(function (c) { return c.episode_id; });
  var postCount = postGroups.reduce(function (n, g) { return n + g.covers.length; }, 0);
%>
<div class="page-head">
  <div><span class="kicker">Do pedido ao post publicado</span><h1>Conteúdo<%= onlyEpisode ? ' · ' + epLabel(onlyEpisode) : '' %></h1></div>
  <div class="row">
    <% if (only) { %><a class="btn ghost" href="/episodios/<%= only %>"><%- icon('arrow-left') %> Voltar ao episódio</a><a class="btn" href="/conteudo">Ver tudo</a><% } %>
    <% if (perm.cut && storageReady) { %><button class="btn <%= perm.request ? '' : 'primary' %>" type="button" data-modal-open="modal-cortes"><%- icon('upload') %> Enviar cortes</button><% } %>
    <% if (perm.request) { %><button class="btn primary" type="button" data-modal-open="modal-pedido"><%- icon('plus') %> Pedir conteúdo</button><% } %>
  </div>
</div>
<p class="lead">Tudo o que sai do podcast passa por aqui: pedidos para o editor, cortes, posts e carrosséis. Cada peça mostra em que ponto está, até ser publicada no Social.</p>

<%
  var colBadge = { pedido: 'b-st-prospect', producao: 'b-st-em_edicao', revisao: 'b-st-em_revisao', pronto: 'b-st-pronto_publicar', fila: 'b-st-agendado', publicado: 'b-st-publicado' };
  var dayShort = function (d) { return d ? new Intl.DateTimeFormat('pt-BR', { timeZone: 'America/Sao_Paulo', day: '2-digit', month: '2-digit' }).format(new Date(d)) : ''; };
  var dueShort = function (d) { if (!d) return ''; var iso = new Date(d).toISOString().slice(0, 10); return iso.slice(8, 10) + '/' + iso.slice(5, 7); };
  var boardHref = function (t) { return '/conteudo?vista=quadro' + (t ? '&tipo=' + t : '') + (only ? '&episodio=' + only : ''); };
%>
<div class="tabs-wrap" data-tabs data-default="<%= vista %>">
  <div class="tabbar" role="tablist" aria-label="Conteúdo">
    <button type="button" role="tab" data-tab-btn="quadro" aria-controls="pane-quadro"><%- icon('columns-3', 14) %> Quadro</button>
    <button type="button" role="tab" data-tab-btn="cortes" aria-controls="pane-cortes">Cortes <span class="count"><%= clips.length %></span></button>
    <button type="button" role="tab" data-tab-btn="posts" aria-controls="pane-posts">Posts e carrosséis <span class="count"><%= postCount %></span></button>
    <button type="button" role="tab" data-tab-btn="pedidos" aria-controls="pane-pedidos">Pedidos <span class="count"><%= openRequests.length %></span></button>
  </div>

  <div class="pane" id="pane-quadro" data-pane-id="quadro">
    <div class="board-filter">
      <div class="seg" role="group" aria-label="Filtrar o quadro">
        <% [['', 'Tudo'], ['video', 'Vídeos'], ['imagem', 'Imagens'], ['pedido', 'Pedidos']].forEach(function (f) { %><a class="<%= tipo === f[0] ? 'on' : '' %>" href="<%= boardHref(f[0]) %>"><%= f[1] %></a><% }) %>
      </div>
      <% if (hiddenOld) { %><a class="link small" href="<%= boardHref(tipo) %>&publicados=todos">Ver publicados há mais de 60 dias <span class="mono">(<%= hiddenOld %>)</span></a><% } %>
    </div>
    <div class="board board-wide pboard">
      <% columns.forEach(function (col) { %>
      <section class="column" data-stage="<%= col.key %>">
        <header><span class="badge <%= colBadge[col.key] %>" title="<%= col.hint %>"><%= col.label %></span><span class="count"><%= col.cards.length %></span></header>
        <div class="cards">
          <% if (!col.cards.length) { %><p class="small muted col-hint"><%= col.key === 'pedido' && perm.request ? 'Peça um trailer, um vídeo avulso ou um post no botão “Pedir conteúdo”.' : col.hint %></p><% } %>
          <% col.cards.forEach(function (k) { %>
          <a class="kcard has-thumb" href="<%= k.href %>">
            <% if (k.thumb) { %><img class="kthumb <%= k.media === 'video' && k.vertical === false ? '' : (k.media !== 'video' && k.type !== 'story' ? 'wide' : '') %>" src="<%= k.thumb %>" alt="" loading="lazy"><% } else { %><span class="kthumb ph"><%- icon(k.media === 'video' ? 'film' : 'image', 16) %></span><% } %>
            <span class="ktype"><%= k.kind %><%= k.episode ? ' · ' + k.episode.split(' · ')[0] : (k.type !== 'pedido' && k.media === 'video' && !k.warn ? ' · avulso' : '') %></span>
            <strong><%= k.title %></strong>
            <span class="meta">
              <% if (k.type === 'pedido') { %><% if (k.priority) { %><span class="warn">prioridade</span><% } %><span><%- icon('user', 12) %><%= k.who %></span><% if (k.due) { %><span class="<%= k.late ? 'late' : '' %>"><%- icon('calendar', 12) %><%= dueShort(k.due) %><%= k.late ? ' · atrasado' : '' %></span><% } %><% if (k.rounds) { %><span><%= k.rounds %>ª volta</span><% } %><% } %>
              <% if (k.chip) { %><span class="<%= k.chip === 'erro' ? 'late' : '' %>"><%= k.chip %></span><% } %>
              <% if (k.warn) { %><span class="warn"><%= k.warn %></span><% } %>
              <% if (k.slides) { %><span><%= k.slides %> slides</span><% } %>
              <% if (k.pub) { %><span class="nets"><%= k.pub.stage === 'fila' ? k.pub.label + ' · ' : '' %><%= k.pub.platforms.join(' · ') %><%= k.pub.at ? ' · ' + dayShort(k.pub.at) : '' %></span><% } %>
            </span>
          </a>
          <% }) %>
        </div>
      </section>
      <% }) %>
    </div>
  </div>

  <div class="pane" id="pane-cortes" data-pane-id="cortes" data-cortes data-running="<%= running ? '1' : '0' %>" data-url="/cortes/status">
    <% if (moments && moments.length) { %>
    <section class="card top-gap">
      <h2>Momentos que a IA sugere cortar</h2>
      <p class="small muted">Só uma dica, tirada da análise do episódio. Nada é cortado sozinho.</p>
      <ul class="plain moment-list">
        <% moments.forEach(function (m) { %><li><span class="handle"><%= fmt.formatClock(m.start_ms) %>–<%= fmt.formatClock(m.end_ms) %></span> <strong><%= m.titulo %></strong><% if (m.motivo) { %><span class="small muted"> — <%= m.motivo %></span><% } %></li><% }) %>
      </ul>
    </section>
    <% } %>

    <% if (!clips.length) { %>
    <div class="empty top-gap"><%- include('../partials/pulse-line') %><p><strong>Nenhum corte <%= only ? 'neste episódio' : 'ainda' %>.</strong></p><p class="muted small">Os vídeos editados aparecem aqui já com título, legenda e capas sugeridos.</p><% if (perm.cut && storageReady) { %><p><button class="btn sm" type="button" data-modal-open="modal-cortes"><%- icon('upload', 14) %> Enviar cortes</button></p><% } %></div>
    <% } %>

    <% var clipPick = perm.cut && clips.length > 1; %>
    <div<%- clipPick ? ' data-dl' : '' %>>
    <% if (clipPick) { %>
    <div class="row dl-toolbar">
      <button class="btn sm ghost" type="button" data-dl-select><%- icon('check-square', 14) %> Selecionar</button>
    </div>
    <div class="dl-bar" data-dl-bar role="group" aria-label="Ações nos cortes marcados" hidden>
      <span class="mono small" data-dl-count aria-live="polite">Nenhum item marcado</span>
      <span class="row dl-actions">
        <button class="btn sm ghost" type="button" data-dl-all>Selecionar todos</button>
        <button class="btn sm" type="button" data-dl-go disabled><%- icon('download', 14) %> Baixar</button>
        <button class="btn sm primary" type="button" data-dl-open="modal-massa-cortes" disabled>Atribuir ao episódio</button>
        <button class="link small danger-link" type="button" data-dl-do="excluir" data-confirm="Mandar {n} corte(s) para a lixeira? Ficam 15 dias lá e dá para restaurar." disabled>excluir</button>
        <button class="btn sm ghost" type="button" data-dl-cancel>Cancelar</button>
      </span>
    </div>
    <p class="small muted dl-note" data-dl-note role="status" aria-live="polite" hidden></p>
    <form method="post" action="/conteudo/em-massa/cortes" data-dl-form hidden><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="acao" value=""><input type="hidden" name="episodio" value="<%= only || '' %>"></form>
    <% } %>
    <% if (unassigned.length) { %>
    <h2 class="top-gap">Sem episódio (<%= unassigned.length %>)</h2>
    <p class="small muted">Escolha o episódio de cada corte. Só aparecem episódios que já foram gravados.</p>
    <div class="clip-grid">
      <% unassigned.forEach(function (c) { %><%- include('_clip_card', { c: c, pick: clipPick }) %><% }) %>
    </div>
    <% } %>

    <% if (assigned.length) { %>
    <h2 class="top-gap">Atribuídos (<%= assigned.length %>)</h2>
    <div class="clip-grid">
      <% assigned.forEach(function (c) { %><%- include('_clip_card', { c: c, pick: clipPick }) %><% }) %>
    </div>
    <% } %>
    </div>
  </div>

  <div class="pane" id="pane-posts" data-pane-id="posts" hidden>
    <% if (!postGroups.length) { %>
    <div class="empty"><%- include('../partials/pulse-line') %><p><strong>Nenhum post ainda.</strong></p><p class="muted small">Quando o episódio for analisado pela IA (ao entrar em finalização), o sistema monta posts de frase, tela dividida e carrossel.</p></div>
    <% } %>
    <% postGroups.forEach(function (g) { %>
    <% var postCount = g.covers.length; var epTag = g.episode.number ? 'ep' + String(g.episode.number).padStart(3, '0') : 'episodio'; %>
    <section class="card top-gap"<%- postCount > 1 ? ' data-dl' : '' %>>
      <div class="row spread">
        <div><span class="kicker"><%= g.episode.number ? 'EP.' + String(g.episode.number).padStart(3, '0') : 'Episódio' %></span><h2><a href="/episodios/<%= g.episode.id %>"><%= g.episode.title %></a></h2><% if (g.episode.guest_name) { %><p class="small muted"><%= g.episode.guest_name %></p><% } %></div>
        <% if (perm.cut && g.canGenerate && aiReady) { %>
        <form method="post" action="/episodios/<%= g.episode.id %>/capas/gerar" class="inline">
          <input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="voltar" value="conteudo">
          <% ['post_quote', 'post_split', 'carousel'].forEach(function (k) { %><input type="hidden" name="kinds" value="<%= k %>"><% }) %>
          <button class="btn sm" type="submit"><%= g.covers.length ? 'Gerar de novo' : 'Gerar posts' %></button>
        </form>
        <% } %>
      </div>
      <% if (!g.covers.length) { %><p class="muted">Ainda sem posts.</p><% } %>
      <% if (postCount > 1) { %>
      <div class="row dl-toolbar">
        <button class="btn sm ghost" type="button" data-dl-select><%- icon('check-square', 14) %> Selecionar</button>
        <button class="btn sm" type="button" data-dl-everything title="Baixa as <%= postCount %> imagens deste episódio, uma depois da outra"><%- icon('download', 14) %> Baixar tudo</button>
      </div>
      <div class="dl-bar" data-dl-bar role="group" aria-label="Ações nos posts marcados" hidden>
        <span class="mono small" data-dl-count aria-live="polite">Nenhum item marcado</span>
        <span class="row dl-actions">
          <button class="btn sm ghost" type="button" data-dl-all>Selecionar todos</button>
          <% if (perm.approve) { %><button class="btn sm" type="button" data-dl-do="aprovar" disabled>Aprovar</button><button class="link small" type="button" data-dl-do="desaprovar" disabled>tirar aprovação</button><% } %>
          <button class="btn sm primary" type="button" data-dl-go disabled><%- icon('download', 14) %> Baixar selecionados</button>
          <% if (perm.cut) { %><button class="link small danger-link" type="button" data-dl-do="excluir" data-confirm="Mandar {n} post(s) para a lixeira? Ficam 15 dias lá e dá para restaurar." disabled>excluir</button><% } %>
          <button class="btn sm ghost" type="button" data-dl-cancel>Cancelar</button>
        </span>
      </div>
      <p class="small muted dl-note" data-dl-note role="status" aria-live="polite" hidden></p>
      <form method="post" action="/conteudo/em-massa/posts" data-dl-form hidden><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="acao" value=""><input type="hidden" name="episodio" value="<%= only || '' %>"></form>
      <% } %>
      <% ['post_quote', 'post_split', 'carousel'].forEach(function (kind) { var list = g.covers.filter(function (c) { return c.kind === kind; }); if (!list.length) return; %>
      <h3 class="capas-kind"><%= KINDS[kind] %></h3>
      <div class="cover-grid">
        <% list.forEach(function (c) { var l = c.lint || {}; var issues = (l.issues || []).length; var warns = (l.warnings || []).length; %>
        <figure class="cover-card <%= c.approved ? 'approved' : '' %>"<% if (postCount > 1) { %> data-dl-item data-id="<%= c.id %>" data-href="/capas/<%= c.id %>/imagem?baixar=1" data-name="<%= epTag + '-' + c.kind.replace(/_/g, '-') + '-' + (c.position + 1) + '.jpg' %>" data-bytes="<%= Number(c.size_bytes || 0) %>"<% } %>>
          <% if (postCount > 1) { %><input type="checkbox" class="dl-check" data-dl-check aria-label="Selecionar <%= c.label || KINDS[kind] %>"><% } %>
          <a href="/capas/<%= c.id %>/imagem" target="_blank" rel="noopener" data-dl-pick><img src="/capas/<%= c.id %>/imagem?v=<%= new Date(c.updated_at).getTime() %>" alt="<%= c.label || KINDS[kind] %>" loading="lazy" width="<%= c.width %>" height="<%= c.height %>"></a>
          <figcaption>
            <span class="small"><%= c.label || '' %></span>
            <span class="row small">
              <% if (c.approved) { %><span class="badge b-green">aprovada</span><% } %>
              <% if (!c.auto) { %><span class="badge b-gray">editada</span><% } %>
              <% if (issues) { %><span class="badge b-red" title="<%= (l.issues || []).join(' ') %>"><%= issues %> problema(s)</span><% } else if (warns) { %><span class="badge b-amber" title="<%= (l.warnings || []).join(' ') %>"><%= warns %> aviso(s)</span><% } else { %><span class="badge b-gray">conferida</span><% } %>
              <span class="handle muted"><%= c.width %>×<%= c.height %> · <%= fmt.formatBytes(c.size_bytes) %></span>
            </span>
            <span class="row">
              <a class="btn sm" href="/capas/<%= c.id %>/imagem?baixar=1"><%- icon('download', 14) %> Baixar</a>
              <% if (perm.cut) { %><a class="btn sm" href="/capas/<%= c.id %>/editar">Editar</a><% } %>
              <% if (perm.publish) { %>
              <form method="post" action="/capas/<%= c.id %>/aprovar" class="inline"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="aprovar" value="<%= c.approved ? '0' : '1' %>"><button class="btn sm <%= c.approved ? '' : 'primary' %>" type="submit"><%= c.approved ? 'Tirar aprovação' : 'Aprovar' %></button></form>
              <% } %>
              <% if (perm.cut) { %><form method="post" action="/capas/<%= c.id %>/excluir" class="inline" data-confirm="Excluir esta imagem?"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="link small" type="submit">excluir</button></form><% } %>
            </span>
          </figcaption>
        </figure>
        <% }) %>
      </div>
      <% }) %>
    </section>
    <% }) %>
  </div>

  <div class="pane" id="pane-pedidos" data-pane-id="pedidos" hidden>
    <% var closed = requests.filter(function (r) { return openRequests.indexOf(r) < 0; }); %>
    <% if (!openRequests.length) { %>
    <div class="empty"><%- include('../partials/pulse-line') %><p><strong>Nenhum pedido em aberto.</strong></p><p class="muted small">Trailer do canal, vídeo avulso, um corte específico, post ou story: peça ao editor por aqui, com briefing e prazo. A entrega volta para você aprovar e já fica pronta no Social.</p><% if (perm.request) { %><p><button class="btn sm" type="button" data-modal-open="modal-pedido"><%- icon('plus', 14) %> Pedir conteúdo</button></p><% } %></div>
    <% } else { %>
    <% var reqPick = openRequests.length > 1 && openRequests.some(function (r) { return perm.review || String(r.created_by) === String(currentUser.id); }); %>
    <div<%- reqPick ? ' data-dl' : '' %>>
    <% if (reqPick) { %>
    <div class="row dl-toolbar">
      <button class="btn sm ghost" type="button" data-dl-select><%- icon('check-square', 14) %> Selecionar</button>
    </div>
    <div class="dl-bar" data-dl-bar role="group" aria-label="Ações nos pedidos marcados" hidden>
      <span class="mono small" data-dl-count aria-live="polite">Nenhum item marcado</span>
      <span class="row dl-actions">
        <button class="btn sm ghost" type="button" data-dl-all>Selecionar todos</button>
        <button class="btn sm primary" type="button" data-dl-open="modal-massa-pedidos" disabled><%- icon('pencil', 14) %> Responsável e prazo</button>
        <button class="link small" type="button" data-dl-do="cancelar" data-confirm="Cancelar {n} pedido(s)? O editor deixa de vê-los como pendentes." disabled>cancelar pedidos</button>
        <button class="link small danger-link" type="button" data-dl-do="excluir" data-confirm="Mandar {n} pedido(s) para a lixeira? Ficam 15 dias lá e dá para restaurar." disabled>excluir</button>
        <button class="btn sm ghost" type="button" data-dl-cancel>Fechar</button>
      </span>
    </div>
    <form method="post" action="/conteudo/em-massa/pedidos" data-dl-form hidden><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="acao" value=""><input type="hidden" name="episodio" value="<%= only || '' %>"></form>
    <% } %>
    <div class="req-list<%= reqPick ? ' top-gap' : '' %>">
      <% openRequests.forEach(function (r) { var late = isLate(r, today); var mayPick = reqPick && (perm.review || String(r.created_by) === String(currentUser.id)); %>
      <div class="req-pick"<% if (mayPick) { %> data-dl-item data-id="<%= r.id %>"<% } %>>
      <% if (mayPick) { %><input type="checkbox" class="dl-check" data-dl-check aria-label="Selecionar <%= r.title %>"><% } %>
      <a class="req-row" href="/conteudo/pedidos/<%= r.id %>"<%- mayPick ? ' data-dl-pick' : '' %>>
        <span><span class="ktype mono small muted"><%= K[r.kind].label %><%= r.episode_number ? ' · EP.' + String(r.episode_number).padStart(3, '0') : '' %></span><br><strong><%= r.title %></strong>
          <span class="meta"><span><%- icon('user', 12) %><%= r.assignee_name || 'qualquer editor' %></span><% if (r.due_on) { %><span class="<%= late ? 'err' : '' %>"><%- icon('calendar', 12) %><%= dueShort(r.due_on) %><%= late ? ' · atrasado' : '' %></span><% } %><% if (r.rounds) { %><span><%= r.rounds %>ª volta</span><% } %></span></span>
        <span class="badge <%= { pedido: 'b-st-prospect', producao: 'b-st-em_edicao', revisao: 'b-st-em_revisao' }[r.status] %>"><%= S[r.status] %></span>
      </a>
      </div>
      <% }) %>
    </div>
    </div>
    <% } %>
    <% if (closed.length) { %>
    <details class="top-gap"><summary>Aprovados e cancelados <span class="mono muted"><%= closed.length %></span></summary>
      <div class="req-list top-gap">
        <% closed.slice(0, 40).forEach(function (r) { %>
        <a class="req-row" href="/conteudo/pedidos/<%= r.id %>"><span><span class="ktype mono small muted"><%= K[r.kind].label %></span><br><strong><%= r.title %></strong></span><span class="badge <%= r.status === 'aprovado' ? 'b-st-pronto_publicar' : 'b-st-cancelado' %>"><%= S[r.status] %></span></a>
        <% }) %>
      </div>
    </details>
    <% } %>
  </div>
</div>

<% if (perm.request) { %><%- include('_request_form', { id: 'modal-pedido', r: null, preset: { kind: pedir, episode: only }, openOnLoad: Boolean(pedir) }) %><% } %>
<% if (perm.cut && clips.length > 1) { %>
<dialog class="modal" id="modal-massa-cortes" aria-labelledby="mmc-h">
  <form method="post" action="/conteudo/em-massa/cortes" class="stack" data-busy="Atribuindo…">
    <input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="acao" value="atribuir"><input type="hidden" name="episodio" value="<%= only || '' %>"><span data-dl-ids></span>
    <h2 id="mmc-h">Atribuir <span class="mono" data-dl-n>0</span> corte(s)</h2>
    <label>Episódio
      <select name="episode_id" required>
        <option value="">Escolha…</option>
        <% episodes.forEach(function (e) { %><option value="<%= e.id %>"><%= e.number ? 'EP.' + String(e.number).padStart(3, '0') + ' · ' : '' %><%= e.title %></option><% }) %>
      </select>
    </label>
    <p class="small muted">Só aparecem episódios já gravados. Os cortes que já tinham episódio mudam para este, e as capas são refeitas.</p>
    <div class="row modal-actions"><button class="btn primary" type="submit">Atribuir</button><button class="btn ghost" type="button" data-modal-close>Cancelar</button></div>
  </form>
</dialog>
<% } %>
<% if (openRequests.length > 1) { %>
<dialog class="modal" id="modal-massa-pedidos" aria-labelledby="mmp-h">
  <form method="post" action="/conteudo/em-massa/pedidos" class="stack">
    <input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="acao" value="alterar"><input type="hidden" name="episodio" value="<%= only || '' %>"><span data-dl-ids></span>
    <h2 id="mmp-h">Mudar <span class="mono" data-dl-n>0</span> pedido(s)</h2>
    <p class="small muted">Só muda o que você escolher; o resto fica como está em cada pedido.</p>
    <label>Responsável
      <select name="assignee_id">
        <option value="">Manter</option>
        <option value="ninguem">Qualquer editor</option>
        <% people.forEach(function (p) { %><option value="<%= p.id %>"><%= p.name %></option><% }) %>
      </select>
    </label>
    <div class="row">
      <label>Novo prazo<input type="date" name="due_on"></label>
      <label class="check"><input type="checkbox" name="sem_prazo" value="1"> Tirar o prazo</label>
    </div>
    <label>Prioridade
      <select name="priority"><option value="">Manter</option><option value="1">Prioritário</option><option value="0">Normal</option></select>
    </label>
    <div class="row modal-actions"><button class="btn primary" type="submit">Salvar</button><button class="btn ghost" type="button" data-modal-close>Cancelar</button></div>
  </form>
</dialog>
<% } %>
<% if (perm.cut && storageReady) { %>
<dialog class="modal modal-wide" id="modal-cortes" aria-labelledby="mc-h">
  <div class="stack">
    <h2 id="mc-h">Enviar cortes</h2>
    <p class="small muted">Selecione vários vídeos de uma vez (MP4, MOV, M4V, WebM ou MKV). Cada um recebe um nome interno (Corte 1, Corte 2…) que você pode trocar.<%= aiReady ? ' O sistema lê cada vídeo e sugere título, legenda e capas.' : ' A leitura por IA (fala, rostos, título e capas) não está completa neste servidor.' %> Para um pedido (trailer, vídeo avulso), envie pela página do pedido.</p>
    <div class="uploader" data-uploader data-base="/cortes/" data-csrf="<%= csrf %>" data-edited="0" data-mode="clip" data-where="Cortes" data-hash="cortes">
      <input type="file" multiple accept="video/*,.mp4,.mov,.m4v,.mkv,.webm" data-files>
      <button class="btn primary" type="button" data-start><%- icon('upload') %> Enviar</button>
      <ul class="plain upload-queue" data-queue aria-live="polite"></ul>
      <p class="flash flash-ok small" data-refresh-note hidden>Envio concluído. <button class="link" type="button" data-refresh>Atualizar a página</button></p>
    </div>
    <div class="row modal-actions"><button class="btn ghost" type="button" data-modal-close>Fechar</button></div>
  </div>
</dialog>
<% } %>
