<%- include('../partials/head') %>
<%
  var KINDS = { post_quote: 'Posts de frase', post_split: 'Tela dividida', carousel: 'Carrossel' };
  var epLabel = function (e) { return (e.number ? 'EP.' + String(e.number).padStart(3, '0') + ' · ' : '') + e.title; };
  var unassigned = clips.filter(function (c) { return !c.episode_id; });
  var assigned = clips.filter(function (c) { return c.episode_id; });
  var postCount = postGroups.reduce(function (n, g) { return n + g.covers.length; }, 0);
%>
<div class="page-head">
  <div><span class="kicker">Do pedido ao post publicado</span><h1>Conteúdo<%= onlyEpisode ? ' · ' + epLabel(onlyEpisode) : '' %></h1></div>
  <div class="row">
    <% if (only) { %><a class="btn ghost" href="/episodios/<%= only %>"><%- icon('arrow-left') %> Voltar ao episódio</a><a class="btn" href="/conteudo">Ver tudo</a><% } %>
    <% if (perm.cut && storageReady) { %><button class="btn <%= perm.request ? '' : 'primary' %>" type="button" data-modal-open="modal-cortes"><%- icon('upload') %> Enviar cortes</button><% } %>
    <% if (perm.request) { %><button class="btn primary" type="button" data-modal-open="modal-pedido"><%- icon('plus') %> Pedir conteúdo</button><% } %>
  </div>
</div>

<%
  var colBadge = { pedido: 'b-st-prospect', producao: 'b-st-em_edicao', revisao: 'b-st-em_revisao', pronto: 'b-st-pronto_publicar', fila: 'b-st-agendado', publicado: 'b-st-publicado' };
  var dayShort = function (d) { return d ? new Intl.DateTimeFormat('pt-BR', { timeZone: 'America/Sao_Paulo', day: '2-digit', month: '2-digit' }).format(new Date(d)) : ''; };
  var dueShort = function (d) { if (!d) return ''; var iso = new Date(d).toISOString().slice(0, 10); return iso.slice(8, 10) + '/' + iso.slice(5, 7); };
  var fq = filterUi && filterUi.query ? filterUi.query : ''; // os filtros combináveis seguem ao trocar tipo, situação, episódio e ordem (na mesma aba)
  var boardHref = function (t) { return '/conteudo?vista=quadro' + (t ? '&tipo=' + t : '') + (only ? '&episodio=' + only : '') + (fq && vista === 'quadro' ? '&' + fq : ''); };
  var cutsHref = function (sit) { return '/conteudo?vista=cortes' + (sit ? '&situacao=' + sit : '') + (ordem !== 'recentes' ? '&ordem=' + ordem : '') + (only ? '&episodio=' + only : '') + (fq && vista === 'cortes' ? '&' + fq : ''); };
%>
<%# Cada aba é uma página: só a aba aberta é montada no servidor (antes, as quatro vinham juntas). %>
<% var tabHref = function (v) { return '/conteudo?vista=' + v + (only ? '&episodio=' + only : ''); }; %>
<div class="tabs-wrap">
  <nav class="tabbar" aria-label="Conteúdo">
    <a href="<%= tabHref('quadro') %>" class="<%= vista === 'quadro' ? 'on' : '' %>"<%- vista === 'quadro' ? ' aria-current="page"' : '' %>><%- icon('columns-3', 14) %> Quadro</a>
    <a href="<%= tabHref('cortes') %>" class="<%= vista === 'cortes' ? 'on' : '' %>"<%- vista === 'cortes' ? ' aria-current="page"' : '' %>>Cortes <span class="count"><%= tabCounts.cortes %></span></a>
    <a href="<%= tabHref('posts') %>" class="<%= vista === 'posts' ? 'on' : '' %>"<%- vista === 'posts' ? ' aria-current="page"' : '' %>>Posts e carrosséis <span class="count"><%= tabCounts.posts %></span></a>
    <a href="<%= tabHref('pedidos') %>" class="<%= vista === 'pedidos' ? 'on' : '' %>"<%- vista === 'pedidos' ? ' aria-current="page"' : '' %>>Pedidos <span class="count"><%= openRequests.length %></span></a>
  </nav>

  <% if (vista === 'quadro') { %>
  <div class="pane" id="pane-quadro">
    <div class="board-filter">
      <div class="seg" role="group" aria-label="Filtrar o quadro">
        <% [['', 'Tudo'], ['video', 'Vídeos'], ['imagem', 'Imagens'], ['pedido', 'Pedidos']].forEach(function (f) { %><a class="<%= tipo === f[0] ? 'on' : '' %>" href="<%= boardHref(f[0]) %>"><%= f[1] %></a><% }) %>
      </div>
      <form method="get" action="/conteudo" class="inline ep-filter"><input type="hidden" name="vista" value="quadro"><% if (tipo) { %><input type="hidden" name="tipo" value="<%= tipo %>"><% } %>
        <% if (fq) { new URLSearchParams(fq).forEach(function (v, k) { %><input type="hidden" name="<%= k %>" value="<%= v %>"><% }); } %>
        <select name="episodio" data-autosubmit aria-label="Filtrar por episódio">
          <option value="">Todos os episódios</option>
          <% episodes.forEach(function (e) { %><option value="<%= e.id %>" <%= only === e.id ? 'selected' : '' %>><%= e.number ? 'EP.' + String(e.number).padStart(3, '0') + ' · ' : '' %><%= e.title %></option><% }) %>
        </select>
      </form>
      <% if (hiddenOld) { %><a class="link small" href="<%= boardHref(tipo) %>&publicados=todos">Ver publicados há mais de 60 dias <span class="mono">(<%= hiddenOld %>)</span></a><% } %>
    </div>
    <div class="board-tools"><%- include('../partials/filter-builder') %><%- include('../partials/card-fields') %></div>
    <div class="board board-wide pboard">
      <% columns.forEach(function (col) { %>
      <section class="column" data-stage="<%= col.key %>">
        <header><span class="badge <%= colBadge[col.key] %>" title="<%= col.hint %>"><%= col.label %></span><span class="count"><%= col.total != null ? col.total : col.cards.length %></span></header>
        <div class="cards">
          <% if (!col.cards.length) { %><p class="small muted col-hint"><%= col.key === 'pedido' && perm.request ? 'Peça um trailer, um vídeo avulso ou um post no botão “Pedir conteúdo”.' : col.hint %></p><% } %>
          <% col.cards.forEach(function (k) { var kTitle = k.episode && String(k.title).toLowerCase() === String(k.kind).toLowerCase() ? (k.episode.split(' · ').slice(1).join(' · ') || k.title) : k.title; %>
          <a class="kcard has-thumb" href="<%= k.href %>">
            <% if (k.thumb) { %><img class="kthumb <%= k.media === 'video' && k.vertical === false ? '' : (k.media !== 'video' && k.type !== 'story' ? 'wide' : '') %>" src="<%= k.thumb %>" alt="" loading="lazy"<%- cardUi.attr('capa') %>><% } else { %><span class="kthumb ph"<%- cardUi.attr('capa') %>><%- icon(k.media === 'video' ? 'film' : 'image', 16) %></span><% } %>
            <span class="ktype"<%- cardUi.attr('tipo') %>><%= k.kind %><%= k.episode ? ' · ' + k.episode.split(' · ')[0] : (k.type !== 'pedido' && k.media === 'video' && !k.warn ? ' · avulso' : '') %></span>
            <strong><%= kTitle %></strong>
            <span class="meta">
              <% if (k.type === 'pedido') { %><% if (k.priority) { %><span class="warn"<%- cardUi.attr('pedido') %>>prioridade</span><% } %><span<%- cardUi.attr('pedido') %>><%- icon('user', 12) %><%= k.who %></span><% if (k.due) { %><span class="<%= k.late ? 'late' : '' %>"<%- cardUi.attr('pedido') %>><%- icon('calendar', 12) %><%= dueShort(k.due) %><%= k.late ? ' · atrasado' : '' %></span><% } %><% if (k.rounds) { %><span<%- cardUi.attr('pedido') %>><%= k.rounds %>ª volta</span><% } %><% } %>
              <% if (k.chip) { %><span class="<%= k.chip === 'erro' ? 'late' : '' %>"<%- cardUi.attr('situacao') %>><%= k.chip %></span><% } %>
              <% if (k.warn) { %><span class="warn"<%- cardUi.attr('situacao') %>><%= k.warn %></span><% } %>
              <% if (k.slides) { %><span<%- cardUi.attr('situacao') %>><%= k.slides %> slides</span><% } %>
              <% if (k.views) { %><span class="views"<%- cardUi.attr('views') %>><%- icon('eye', 12) %><%= fmt.compact(k.views) %></span><% } %>
              <% if (k.pub) { %><span class="nets"<%- cardUi.attr('redes') %>><%= k.pub.stage === 'fila' ? k.pub.label + ' · ' : '' %><%= k.pub.platforms.join(' · ') %><%= k.pub.at ? ' · ' + dayShort(k.pub.at) : '' %></span><% if (k.pub.trial) { %> <span class="badge b-trial" title="Reel de teste no Instagram: aparece primeiro só para quem não segue"<%- cardUi.attr('redes') %>>Reel de teste</span><% } %><% } %>
              <% if (k.created) { %><span class="mono" title="Criado em"<%- cardUi.attr('criado') %>>criado <%= dayShort(k.created) %></span><% } %>
              <% if (k.updated) { %><span class="mono" title="Atualizado em"<%- cardUi.attr('atualizado') %>>atual. <%= dayShort(k.updated) %></span><% } %>
            </span>
          </a>
          <% }) %>
          <% if (col.total > col.cards.length) { %><a class="link small col-more" href="<%= cutsHref(col.key === 'pronto' ? 'pronto' : '') %>">+ <span class="mono"><%= col.total - col.cards.length %></span> na lista de cortes</a><% } %>
          <% if (col.key === 'pronto' && perm.cut && readyCount > 1) { %><a class="link small col-more" href="<%= cutsHref('pronto') %>">Selecionar para publicar em massa</a><% } %>
          <% if (col.key === 'pronto' && perm.publish && readyCount > 1) { %><a class="link small col-more" href="/conteudo/semana">Montar a agenda da semana</a><% } %>
          <% if (col.key === 'publicado' && hiddenOld) { %><a class="link small col-more" href="<%= boardHref(tipo) %>&publicados=todos">+ <span class="mono"><%= hiddenOld %></span> publicados há mais de 60 dias</a><% } %>
        </div>
      </section>
      <% }) %>
    </div>
  </div>
  <% } %>

  <% if (vista === 'cortes') { %>
  <div class="pane" id="pane-cortes" data-cortes data-running="<%= running ? '1' : '0' %>" data-url="/cortes/status">
    <% if (moments && moments.length) { %>
    <section class="card top-gap">
      <h2>Momentos que a IA sugere cortar</h2>
      <p class="small muted">Só uma dica, tirada da análise do episódio. Nada é cortado sozinho.</p>
      <ul class="plain moment-list">
        <% moments.forEach(function (m) { %><li><span class="handle"><%= fmt.formatClock(m.start_ms) %>–<%= fmt.formatClock(m.end_ms) %></span> <strong><%= m.titulo %></strong><% if (m.motivo) { %><span class="small muted"> — <%= m.motivo %></span><% } %></li><% }) %>
      </ul>
    </section>
    <% } %>

    <% if (!clips.length && !(filterUi && filterUi.count)) { %>
    <div class="empty top-gap"><%- include('../partials/signal') %><p><strong>Nenhum corte <%= only ? 'neste episódio' : 'ainda' %>.</strong></p><p class="muted small">Os vídeos editados aparecem aqui já com título, legenda e capas sugeridos.</p><% if (perm.cut && storageReady) { %><p><button class="btn sm" type="button" data-modal-open="modal-cortes"><%- icon('upload', 14) %> Enviar cortes</button></p><% } %></div>
    <% } %>

    <div class="board-filter cuts-filter">
      <div class="seg" role="group" aria-label="Situação dos cortes">
        <a class="<%= situacao ? '' : 'on' %>" href="<%= cutsHref('') %>">Todos</a><a class="<%= situacao === 'pronto' ? 'on' : '' %>" href="<%= cutsHref('pronto') %>">Prontos para postar <span class="mono"><%= readyCount %></span></a>
      </div>
      <form method="get" action="/conteudo" class="inline ep-filter"><input type="hidden" name="vista" value="cortes"><% if (situacao) { %><input type="hidden" name="situacao" value="<%= situacao %>"><% } %>
        <% if (fq) { new URLSearchParams(fq).forEach(function (v, k) { %><input type="hidden" name="<%= k %>" value="<%= v %>"><% }); } %>
        <select name="episodio" data-autosubmit aria-label="Filtrar por episódio">
          <option value="">Todos os episódios</option>
          <% episodes.forEach(function (e) { %><option value="<%= e.id %>" <%= only === e.id ? 'selected' : '' %>><%= e.number ? 'EP.' + String(e.number).padStart(3, '0') + ' · ' : '' %><%= e.title %></option><% }) %>
        </select>
        <select name="ordem" data-autosubmit aria-label="Ordenar">
          <% [['recentes', 'Mais recentes'], ['antigos', 'Mais antigos'], ['episodio', 'Por episódio'], ['duracao', 'Mais curtos primeiro']].forEach(function (o) { %><option value="<%= o[0] %>" <%= ordem === o[0] ? 'selected' : '' %>><%= o[1] %></option><% }) %>
        </select>
      </form>
    </div>
    <div class="board-tools"><%- include('../partials/filter-builder') %><% if (clips.length) { %><%- include('../partials/card-fields') %><% } %></div>
    <% if (filterUi.count && !clips.length) { %><div class="empty top-gap"><%- include('../partials/signal') %><p><strong>Nenhum vídeo com esses filtros.</strong></p><p class="muted small">Tire algum filtro ou troque para "qualquer um" (OU) no painel.</p></div><% } %>

    <% var clipPick = perm.cut && clips.length > 1; %>
    <div<%- clipPick ? ' data-dl data-dl-zip="cortes"' : '' %>>
    <% if (clipPick) { %>
    <div class="row dl-toolbar">
      <button class="btn sm ghost" type="button" data-dl-select><%- icon('check-square', 14) %> Selecionar</button>
      <% if (perm.publish && readyCount > 1) { %><a class="btn sm" href="/conteudo/semana" title="A semana montada com os prontos para postar, um episódio de cada vez"><%- icon('calendar', 14) %> Agenda da semana</a><% } %>
    </div>
    <div class="dl-bar" data-dl-bar role="group" aria-label="Ações nos cortes marcados" hidden>
      <span class="mono small" data-dl-count aria-live="polite">Nenhum item marcado</span>
      <span class="row dl-actions">
        <button class="btn sm ghost" type="button" data-dl-all>Selecionar todos</button>
        <% if (perm.publish) { %><button class="btn sm primary" type="button" data-dl-open="modal-massa-publicar" disabled><%- icon('send', 14) %> Publicar</button><% } %>
        <% if (perm.cover) { %><button class="btn sm" type="button" data-dl-open="modal-capas-lote" disabled><%- icon('image', 14) %> Capas e textos</button><% } %>
        <button class="btn sm <%= perm.publish ? '' : 'primary' %>" type="button" data-dl-open="modal-massa-cortes" disabled>Atribuir ao episódio</button>
        <button class="btn sm" type="button" data-dl-open="modal-massa-categoria" disabled><%- icon('tag', 14) %> Categoria</button>
        <button class="btn sm ghost" type="button" data-dl-go disabled><%- icon('download', 14) %> Baixar</button>
        <button class="link small danger-link" type="button" data-dl-do="excluir" data-confirm="Mandar {n} corte(s) para a lixeira? Ficam 15 dias lá e dá para restaurar." disabled>excluir</button>
        <button class="btn sm ghost" type="button" data-dl-cancel>Cancelar</button>
      </span>
    </div>
    <p class="small muted dl-note" data-dl-note role="status" aria-live="polite" hidden></p>
    <form method="post" action="/conteudo/em-massa/cortes" data-dl-form hidden><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="acao" value=""><input type="hidden" name="episodio" value="<%= only || '' %>"></form>
    <% } %>
    <% if (unassigned.length) { %>
    <h2 class="top-gap">Sem episódio (<%= unassigned.length %>)</h2>
    <p class="small muted">Escolha o episódio de cada corte. Só aparecem episódios que já foram gravados.</p>
    <div class="clip-grid">
      <% unassigned.forEach(function (c) { %><%- include('_clip_card', { c: c, pick: clipPick }) %><% }) %>
    </div>
    <% } %>

    <% if (assigned.length) { %>
    <% var assignedTotal = typeof clipTotals !== 'undefined' && clipTotals ? clipTotals.assigned : assigned.length; %>
    <h2 class="top-gap">Atribuídos <span class="mono muted">(<%= assignedTotal %>)</span><% if (assignedTotal > assigned.length) { %> <span class="small muted">mostrando <%= assigned.length %></span><% } %></h2>
    <div class="clip-grid">
      <% assigned.forEach(function (c) { %><%- include('_clip_card', { c: c, pick: clipPick }) %><% }) %>
    </div>
    <% } %>
    </div>
    <%- include('../partials/pager', { pager: clipPager }) %>
  </div>
  <% } %>

  <% if (vista === 'posts') { %>
  <div class="pane" id="pane-posts">
    <%- include('../partials/filter-builder') %>
    <% if (!postGroups.length && filterUi.count) { %>
    <div class="empty"><%- include('../partials/signal') %><p><strong>Nenhum post com esses filtros.</strong></p><p class="muted small">Tire algum filtro ou troque para "qualquer um" (OU) no painel.</p></div>
    <% } else if (!postGroups.length) { %>
    <div class="empty"><%- include('../partials/signal') %><p><strong>Nenhum post ainda.</strong></p><p class="muted small">Quando o episódio for analisado pela IA (ao entrar em finalização), o sistema monta posts de frase, tela dividida e carrossel.</p></div>
    <% } %>
    <% postGroups.forEach(function (g) { %>
    <% var postCount = g.covers.length; var epTag = g.episode.number ? 'ep' + String(g.episode.number).padStart(3, '0') : 'episodio'; %>
    <section class="card top-gap"<%- postCount > 1 ? ' data-dl data-dl-zip="' + epTag + '-posts"' : '' %>>
      <div class="row spread">
        <div><span class="kicker"><%= g.episode.number ? 'EP.' + String(g.episode.number).padStart(3, '0') : 'Episódio' %></span><h2><a href="/episodios/<%= g.episode.id %>"><%= g.episode.title %></a></h2><% if (g.episode.guest_name) { %><p class="small muted"><%= g.episode.guest_name %></p><% } %></div>
        <% if (perm.cut && g.canGenerate && aiReady) { %>
        <form method="post" action="/episodios/<%= g.episode.id %>/capas/gerar" class="inline" data-busy="Gerando as capas…"<%- g.covers.length ? ' data-confirm="Gerar os posts de novo? As imagens automáticas que ainda não foram aprovadas são refeitas; as aprovadas e as editadas ficam."' : '' %>>
          <input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="voltar" value="conteudo">
          <% ['post_quote', 'post_split', 'carousel'].forEach(function (k) { %><input type="hidden" name="kinds" value="<%= k %>"><% }) %>
          <button class="btn sm" type="submit"><%= g.covers.length ? 'Gerar de novo' : 'Gerar posts' %></button>
        </form>
        <% } %>
      </div>
      <% if (!g.covers.length) { %><p class="muted">Ainda sem posts.</p><% } %>
      <% if (postCount > 1) { %>
      <div class="row dl-toolbar">
        <button class="btn sm ghost" type="button" data-dl-select><%- icon('check-square', 14) %> Selecionar</button>
        <button class="btn sm" type="button" data-dl-everything title="Baixa as <%= postCount %> imagens deste episódio num ZIP só"><%- icon('download', 14) %> Baixar tudo</button>
      </div>
      <div class="dl-bar" data-dl-bar role="group" aria-label="Ações nos posts marcados" hidden>
        <span class="mono small" data-dl-count aria-live="polite">Nenhum item marcado</span>
        <span class="row dl-actions">
          <button class="btn sm ghost" type="button" data-dl-all>Selecionar todos</button>
          <% if (perm.approve) { %><button class="btn sm" type="button" data-dl-do="aprovar" disabled>Aprovar</button><button class="link small" type="button" data-dl-do="desaprovar" disabled>tirar aprovação</button><% } %>
          <button class="btn sm primary" type="button" data-dl-go disabled><%- icon('download', 14) %> Baixar selecionados</button>
          <% if (perm.cut) { %><button class="link small danger-link" type="button" data-dl-do="excluir" data-confirm="Mandar {n} post(s) para a lixeira? Ficam 15 dias lá e dá para restaurar." disabled>excluir</button><% } %>
          <button class="btn sm ghost" type="button" data-dl-cancel>Cancelar</button>
        </span>
      </div>
      <p class="small muted dl-note" data-dl-note role="status" aria-live="polite" hidden></p>
      <form method="post" action="/conteudo/em-massa/posts" data-dl-form hidden><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="acao" value=""><input type="hidden" name="episodio" value="<%= only || '' %>"></form>
      <% } %>
      <%# uma grade só por episódio (antes, um bloco por tipo deixava grupos de um cartão e muito vazio); o tipo vai no cartão %>
      <% var ordered = ['post_quote', 'post_split', 'carousel'].reduce(function (acc, kind) { return acc.concat(g.covers.filter(function (c) { return c.kind === kind; })); }, []); %>
      <% if (ordered.length) { %>
      <div class="cover-grid">
        <% ordered.forEach(function (c) { var kind = c.kind; var l = c.lint || {}; var issues = (l.issues || []).length; var warns = (l.warnings || []).length; %>
        <figure class="cover-card <%= c.approved ? 'approved' : '' %>"<% if (postCount > 1) { %> data-dl-item data-id="<%= c.id %>" data-zip="k<%= c.id %>" data-href="/capas/<%= c.id %>/imagem?baixar=1" data-name="<%= epTag + '-' + c.kind.replace(/_/g, '-') + '-' + (c.position + 1) + '.jpg' %>" data-bytes="<%= Number(c.size_bytes || 0) %>"<% } %>>
          <% if (postCount > 1) { %><input type="checkbox" class="dl-check" data-dl-check aria-label="Selecionar <%= c.label || KINDS[kind] %>"><% } %>
          <a href="/capas/<%= c.id %>/imagem" target="_blank" rel="noopener" data-dl-pick><img src="/capas/<%= c.id %>/imagem?v=<%= new Date(c.updated_at).getTime() %>&w=640" alt="<%= c.label || KINDS[kind] %>" loading="lazy" width="<%= c.width %>" height="<%= c.height %>"></a>
          <figcaption>
            <span class="mono small muted cover-kind"><%= KINDS[kind] %></span>
            <% if (c.label) { %><span class="small"><%= c.label %></span><% } %>
            <span class="row small">
              <% if (c.approved) { %><span class="badge b-green">aprovada</span><% } %>
              <% if (!c.auto) { %><span class="badge b-gray">editada</span><% } %>
              <% if (issues) { %><span class="badge b-red" title="<%= (l.issues || []).join(' ') %>"><%= fmt.plural(issues, 'problema', 'problemas') %></span><% } else if (warns) { %><span class="badge b-amber" title="<%= (l.warnings || []).join(' ') %>"><%= fmt.plural(warns, 'aviso', 'avisos') %></span><% } else { %><span class="badge b-gray">conferida</span><% } %>
              <span class="handle muted"><%= c.width %>×<%= c.height %> · <%= fmt.formatBytes(c.size_bytes) %></span>
            </span>
            <span class="row cover-actions">
              <% if (perm.publish) { %>
              <form method="post" action="/capas/<%= c.id %>/aprovar" class="inline"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="aprovar" value="<%= c.approved ? '0' : '1' %>"><button class="btn sm <%= c.approved ? 'ghost' : '' %>" type="submit"><%= c.approved ? 'Tirar aprovação' : 'Aprovar' %></button></form>
              <% } %>
              <% if (perm.cover) { %><a class="btn sm ghost" href="/capas/<%= c.id %>/editar">Editar</a><% } %>
              <a class="icon-btn" href="/capas/<%= c.id %>/imagem?baixar=1" title="Baixar" aria-label="Baixar <%= c.label || KINDS[kind] %>" data-no-skeleton><%- icon('download', 14) %></a>
              <% if (perm.cover) { %><form method="post" action="/capas/<%= c.id %>/excluir" class="inline push-right" data-confirm="Mandar esta imagem para a lixeira? Fica 15 dias lá e dá para restaurar."><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="icon-btn row-del" type="submit" title="Mandar para a lixeira" aria-label="Mandar para a lixeira"><%- icon('trash-2', 14) %></button></form><% } %>
            </span>
          </figcaption>
        </figure>
        <% }) %>
      </div>
      <% } %>
    </section>
    <% }) %>
  </div>
  <% } %>

  <% if (vista === 'pedidos') { %>
  <div class="pane" id="pane-pedidos">
    <%- include('../partials/filter-builder') %>
    <% var closed = requests.filter(function (r) { return openRequests.indexOf(r) < 0; }); %>
    <% if (!openRequests.length && filterUi.count) { %>
    <div class="empty"><%- include('../partials/signal') %><p><strong>Nenhum pedido em aberto com esses filtros.</strong></p><p class="muted small">Tire algum filtro ou troque para "qualquer um" (OU) no painel. Os concluídos que passam no filtro continuam embaixo.</p></div>
    <% } else if (!openRequests.length) { %>
    <div class="empty"><%- include('../partials/signal') %><p><strong>Nenhum pedido em aberto.</strong></p><p class="muted small">Trailer do canal, vídeo avulso, um corte específico, post ou story: peça ao editor por aqui, com briefing e prazo. A entrega volta para você aprovar e já fica pronta no Social.</p><% if (perm.request) { %><p><button class="btn sm" type="button" data-modal-open="modal-pedido"><%- icon('plus', 14) %> Pedir conteúdo</button></p><% } %></div>
    <% } else { %>
    <% var reqPick = openRequests.length > 1 && openRequests.some(function (r) { return perm.review || String(r.created_by) === String(currentUser.id); }); %>
    <div<%- reqPick ? ' data-dl' : '' %>>
    <% if (reqPick) { %>
    <div class="row dl-toolbar">
      <button class="btn sm ghost" type="button" data-dl-select><%- icon('check-square', 14) %> Selecionar</button>
    </div>
    <div class="dl-bar" data-dl-bar role="group" aria-label="Ações nos pedidos marcados" hidden>
      <span class="mono small" data-dl-count aria-live="polite">Nenhum item marcado</span>
      <span class="row dl-actions">
        <button class="btn sm ghost" type="button" data-dl-all>Selecionar todos</button>
        <button class="btn sm primary" type="button" data-dl-open="modal-massa-pedidos" disabled><%- icon('pencil', 14) %> Responsável e prazo</button>
        <button class="link small" type="button" data-dl-do="cancelar" data-confirm="Cancelar {n} pedido(s)? O editor deixa de vê-los como pendentes." disabled>cancelar pedidos</button>
        <button class="link small danger-link" type="button" data-dl-do="excluir" data-confirm="Mandar {n} pedido(s) para a lixeira? Ficam 15 dias lá e dá para restaurar." disabled>excluir</button>
        <button class="btn sm ghost" type="button" data-dl-cancel>Fechar</button>
      </span>
    </div>
    <form method="post" action="/conteudo/em-massa/pedidos" data-dl-form hidden><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="acao" value=""><input type="hidden" name="episodio" value="<%= only || '' %>"></form>
    <% } %>
    <% var mineOf = function (r) { return String(r.assignee_id || '') === String(currentUser.id) || String(r.created_by) === String(currentUser.id); };
       var reqCount = function (st) { return openRequests.filter(function (r) { return st === 'meus' ? mineOf(r) : r.status === st; }).length; }; %>
    <% if (openRequests.length > 4) { %>
    <div class="seg req-filter" role="group" aria-label="Filtrar pedidos" data-row-filter="req-open">
      <button type="button" class="on" aria-pressed="true" data-value="">Todos <span class="mono"><%= openRequests.length %></span></button>
      <% [['pedido', 'Na fila'], ['producao', 'Em produção'], ['revisao', 'Em revisão'], ['meus', 'Meus']].forEach(function (f) { var n = reqCount(f[0]); if (!n) return; %><button type="button" aria-pressed="false" data-value="<%= f[0] %>"><%= f[1] %> <span class="mono"><%= n %></span></button><% }) %>
    </div>
    <% } %>
    <div class="req-list<%= reqPick ? ' top-gap' : '' %>" id="req-open">
      <% openRequests.forEach(function (r) { var late = isLate(r, today); var mayPick = reqPick && (perm.review || String(r.created_by) === String(currentUser.id)); %>
      <div class="req-pick" data-filter-value="<%= r.status %><%= mineOf(r) ? ' meus' : '' %>"<% if (mayPick) { %> data-dl-item data-id="<%= r.id %>"<% } %>>
      <% if (mayPick) { %><input type="checkbox" class="dl-check" data-dl-check aria-label="Selecionar <%= r.title %>"><% } %>
      <a class="req-row" href="/conteudo/pedidos/<%= r.id %>"<%- mayPick ? ' data-dl-pick' : '' %>>
        <% var sameAsKind = String(r.title).toLowerCase() === String(K[r.kind].label).toLowerCase(); %>
        <span><span class="ktype mono small muted"><%= sameAsKind && r.episode_title ? (r.episode_number ? 'EP.' + String(r.episode_number).padStart(3, '0') + ' · ' : '') + r.episode_title : K[r.kind].label + (r.episode_number ? ' · EP.' + String(r.episode_number).padStart(3, '0') : '') %></span><br><strong><%= r.title %></strong>
          <span class="meta"><span><%- icon('user', 12) %><%= r.assignee_name || 'qualquer editor' %></span><% if (r.due_on) { %><span class="<%= late ? 'err' : '' %>"><%- icon('calendar', 12) %><%= dueShort(r.due_on) %><%= late ? ' · atrasado' : '' %></span><% } %><% if (r.rounds) { %><span><%= r.rounds %>ª volta</span><% } %></span></span>
        <span class="badge <%= { pedido: 'b-st-prospect', producao: 'b-st-em_edicao', revisao: 'b-st-em_revisao' }[r.status] %>"><%= S[r.status] %></span>
      </a>
      </div>
      <% }) %>
    </div>
    </div>
    <% } %>
    <% if (closed.length) { %>
    <details class="top-gap"><summary>Aprovados e cancelados <span class="mono muted"><%= closed.length %></span></summary>
      <div class="req-list top-gap">
        <% closed.slice(0, 40).forEach(function (r) { %>
        <a class="req-row" href="/conteudo/pedidos/<%= r.id %>"><span><span class="ktype mono small muted"><%= K[r.kind].label %></span><br><strong><%= r.title %></strong></span><span class="badge <%= r.status === 'aprovado' ? 'b-st-pronto_publicar' : 'b-st-cancelado' %>"><%= S[r.status] %></span></a>
        <% }) %>
      </div>
    </details>
    <% } %>
  </div>
  <% } %>
</div>

<% if (perm.request) { %><%- include('_request_form', { id: 'modal-pedido', r: null, preset: { kind: pedir, episode: only }, openOnLoad: Boolean(pedir) }) %><% } %>
<% if (perm.cut && clips.length > 1) { %>
<% if (vista === 'cortes' && perm.cut) { %>
<dialog class="modal" id="modal-massa-categoria" aria-labelledby="mmcat-h">
  <form method="post" action="/conteudo/em-massa/cortes" class="stack" data-busy="Salvando…">
    <input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="acao" value="categoria"><input type="hidden" name="episodio" value="<%= only || '' %>"><input type="hidden" name="voltar" value="<%= currentUrl %>"><span data-dl-ids></span>
    <h2 id="mmcat-h">Categoria de <span class="mono" data-dl-n>0</span> <span data-dl-word="vídeo|vídeos">vídeos</span></h2>
    <label>Categoria
      <select name="video_type" required>
        <option value="">Escolha…</option>
        <% videoTypes.forEach(function (k) { %><option value="<%= k %>"><%= (K[k] && K[k].label) || k %></option><% }) %>
      </select>
    </label>
    <p class="small muted">Ex.: um corte que era bastidor, ou um vídeo longo horizontal. Novas categorias se criam em Gestão &gt; Sistema &gt; Categorias.</p>
    <div class="row modal-actions"><button class="btn primary" type="submit">Salvar</button><button class="btn ghost" type="button" data-modal-close>Cancelar</button></div>
  </form>
</dialog>
<% } %>
<dialog class="modal" id="modal-massa-cortes" aria-labelledby="mmc-h">
  <form method="post" action="/conteudo/em-massa/cortes" class="stack" data-busy="Atribuindo…">
    <input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="acao" value="atribuir"><input type="hidden" name="episodio" value="<%= only || '' %>"><span data-dl-ids></span>
    <h2 id="mmc-h">Atribuir <span class="mono" data-dl-n>0</span> <span data-dl-word="corte|cortes">cortes</span></h2>
    <label>Episódio
      <select name="episode_id" required>
        <option value="">Escolha…</option>
        <% episodes.forEach(function (e) { %><option value="<%= e.id %>"><%= e.number ? 'EP.' + String(e.number).padStart(3, '0') + ' · ' : '' %><%= e.title %></option><% }) %>
      </select>
    </label>
    <p class="small muted">Só aparecem episódios já gravados. Os cortes que já tinham episódio mudam para este, e as capas são refeitas.</p>
    <div class="row modal-actions"><button class="btn primary" type="submit">Atribuir</button><button class="btn ghost" type="button" data-modal-close>Cancelar</button></div>
  </form>
</dialog>
<% } %>
<% if (perm.cut && clips.length > 1 && perm.publish) { %>
<dialog class="modal modal-wide" id="modal-massa-publicar" aria-labelledby="mmpub-h">
  <form method="post" action="/conteudo/em-massa/publicar/previa" class="stack" data-remember="publicar-em-massa" data-remember-skip="_csrf,ids,inicio,episodio">
    <input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="episodio" value="<%= only || '' %>"><span data-dl-ids></span>
    <h2 id="mmpub-h">Publicar <span class="mono" data-dl-n>0</span> <span data-dl-word="corte|cortes">cortes</span></h2>
    <p class="small muted">Cada corte sai com o próprio título, legenda, capa escolhida e a chamada de cada rede, na ordem da lista. Antes de agendar, você confere a agenda.</p>
    <fieldset class="channels"><legend>Redes</legend>
      <% Object.keys(uploadPost.PLATFORMS).filter(function (k) { return uploadPost.PLATFORMS[k].clip; }).forEach(function (k) { %>
      <label class="check"><input type="checkbox" name="platforms" value="<%= k %>" <%= uploadPost.DEFAULTS.clip.indexOf(k) >= 0 ? 'checked' : '' %>> <%= uploadPost.PLATFORMS[k].clipLabel || uploadPost.PLATFORMS[k].label %></label>
      <% }) %>
    </fieldset>
    <div class="grid-3">
      <label>Começar em<input type="date" name="inicio" value="<%= today %>" required></label>
      <label>Das<input type="time" name="de" value="08:00" step="300" required></label>
      <label>Até<input type="time" name="ate" value="22:00" step="300" required></label>
    </div>
    <div class="grid-3">
      <label>Por dia<input type="number" name="por_dia" min="1" max="24" value="3" class="num-input" required></label>
      <label>Reel de teste por dia <small class="muted">(Instagram)</small><input type="number" name="teste_por_dia" min="0" max="24" value="0" class="num-input"></label>
      <label>Reel de teste libera
        <select name="teste_modo"><option value="auto">Sozinho, se for bem</option><option value="manual">Eu libero no app</option></select>
      </label>
    </div>
    <p class="small muted m-0">Os horários do dia ficam espalhados entre o começo e o fim. O Reel de teste aparece primeiro só para quem não segue o Pulso; as outras redes recebem o post normal.</p>
    <%- include('../partials/auto-fields', { auto: autoDefaults, bulk: true }) %>
    <div class="row modal-actions"><button class="btn primary" type="submit">Ver a agenda</button><button class="btn ghost" type="button" data-modal-close>Cancelar</button></div>
  </form>
</dialog>
<% } %>
<% if (perm.cut && clips.length > 1 && perm.cover) { %>
<dialog class="modal" id="modal-capas-lote" aria-labelledby="mcl-h">
  <form method="get" action="/conteudo/capas-em-lote" class="stack">
    <input type="hidden" name="episodio" value="<%= only || '' %>"><span data-dl-ids></span>
    <h2 id="mcl-h">Capas de <span class="mono" data-dl-n>0</span> <span data-dl-word="corte|cortes">cortes</span></h2>
    <p class="small muted">Abre uma página com os cortes marcados, um por linha: escolha a capa de cada um e reescreva o texto, com a IA sugerindo para todos de uma vez.</p>
    <div class="row modal-actions"><button class="btn primary" type="submit">Abrir as capas</button><button class="btn ghost" type="button" data-modal-close>Cancelar</button></div>
  </form>
</dialog>
<% } %>
<% if (openRequests.length > 1) { %>
<dialog class="modal" id="modal-massa-pedidos" aria-labelledby="mmp-h">
  <form method="post" action="/conteudo/em-massa/pedidos" class="stack">
    <input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="acao" value="alterar"><input type="hidden" name="episodio" value="<%= only || '' %>"><span data-dl-ids></span>
    <h2 id="mmp-h">Mudar <span class="mono" data-dl-n>0</span> <span data-dl-word="pedido|pedidos">pedidos</span></h2>
    <p class="small muted">Só muda o que você escolher; o resto fica como está em cada pedido.</p>
    <label>Responsável
      <select name="assignee_id">
        <option value="">Manter</option>
        <option value="ninguem">Qualquer editor</option>
        <% people.forEach(function (p) { %><option value="<%= p.id %>"><%= p.name %></option><% }) %>
      </select>
    </label>
    <div class="row">
      <label>Novo prazo<input type="date" name="due_on"></label>
      <label class="check"><input type="checkbox" name="sem_prazo" value="1"> Tirar o prazo</label>
    </div>
    <label>Prioridade
      <select name="priority"><option value="">Manter</option><option value="1">Prioritário</option><option value="0">Normal</option></select>
    </label>
    <div class="row modal-actions"><button class="btn primary" type="submit">Salvar</button><button class="btn ghost" type="button" data-modal-close>Cancelar</button></div>
  </form>
</dialog>
<% } %>
<% if (perm.cut && storageReady) { %>
<dialog class="modal modal-wide" id="modal-cortes" aria-labelledby="mc-h">
  <div class="stack">
    <h2 id="mc-h">Enviar cortes</h2>
    <p class="small muted">Selecione vários vídeos de uma vez (MP4, MOV, M4V, WebM ou MKV). Cada um recebe um nome interno (Corte 1, Corte 2…) que você pode trocar.<%= aiReady ? ' O sistema lê cada vídeo e sugere título, legenda e capas.' : ' A leitura por IA (fala, rostos, título e capas) não está completa neste servidor.' %> Para um pedido (trailer, vídeo avulso), envie pela página do pedido.</p>
    <div class="uploader" data-uploader data-base="/cortes/" data-csrf="<%= csrf %>" data-edited="0" data-mode="clip" data-where="Cortes" data-hash="cortes">
      <input type="file" multiple accept="video/*,.mp4,.mov,.m4v,.mkv,.webm" data-files>
      <button class="btn primary" type="button" data-start><%- icon('upload') %> Escolher os vídeos</button>
      <ul class="plain upload-queue" data-queue aria-live="polite"></ul>
      <p class="flash flash-ok small" data-refresh-note hidden>Envio concluído. <button class="link" type="button" data-refresh>Atualizar a página</button></p>
    </div>
    <div class="row modal-actions"><button class="btn ghost" type="button" data-modal-close>Fechar</button></div>
  </div>
</dialog>
<% } %>
<script src="/static/baixar.js?v=<%= assetV %>" defer></script>
<script src="/static/producao.js?v=<%= assetV %>" defer></script>
<script src="/static/autocta.js?v=<%= assetV %>" defer></script>
<script src="/static/lembrar.js?v=<%= assetV %>" defer></script>
<%- include('../partials/foot') %>
