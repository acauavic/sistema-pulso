<%- include('../partials/head') %>
<div class="page-head">
  <div><span class="kicker">CRM · Funil de convidados</span><h1>Convidados</h1></div>
  <div class="row">
    <div class="seg">
      <% var fq = filterUi.query ? '&' + filterUi.query : ''; /* os filtros combináveis seguem entre Quadro e Lista */ %>
      <a class="<%= view === 'quadro' ? 'on' : '' %>" href="/convidados?view=quadro&q=<%= encodeURIComponent(q) %>&owner=<%= encodeURIComponent(ownerFilter) %><%= fq %>"><%- icon('columns-3') %> Quadro</a>
      <a class="<%= view === 'lista' ? 'on' : '' %>" href="/convidados?view=lista&q=<%= encodeURIComponent(q) %>&owner=<%= encodeURIComponent(ownerFilter) %><%= fq %>"><%- icon('list') %> Lista</a>
    </div>
    <% if (can('guests.write')) { %>
    <a class="btn primary" href="/convidados/novo"><%- icon('plus') %> Novo convidado</a>
    <details class="row-menu">
      <summary class="btn icon-only" aria-label="Mais ações" title="Mais ações"><%- icon('ellipsis') %></summary>
      <div class="row-menu-list"><a class="link" href="/convidados/importar"><%- icon('file-text', 14) %> Importar uma planilha (CSV)</a></div>
    </details>
    <% } %>
  </div>
</div>

<form method="get" action="/convidados" class="filters">
  <input type="hidden" name="view" value="<%= view %>">
  <% if (filterUi.query) { new URLSearchParams(filterUi.query).forEach(function (v, k) { %><input type="hidden" name="<%= k %>" value="<%= v %>"><% }); } %>
  <input type="search" name="q" value="<%= q %>" placeholder="Buscar nome, Instagram, e-mail ou tema" aria-label="Buscar convidado" enterkeyhint="search">
  <select name="owner" aria-label="Responsável" data-autosubmit>
    <option value="">Todos os responsáveis</option>
    <option value="eu" <%= ownerFilter === 'eu' ? 'selected' : '' %>>Só os meus</option>
    <% owners.forEach(function (o) { %><option value="<%= o.id %>" <%= ownerFilter === o.id ? 'selected' : '' %>><%= o.name %></option><% }) %>
  </select>
  <% if (view === 'lista') { %>
  <select name="status" aria-label="Etapa" data-autosubmit>
    <option value="">Todas as etapas</option>
    <% statuses.forEach(function (s) { %><option value="<%= s.key %>" <%= status === s.key ? 'selected' : '' %>><%= s.label %></option><% }) %>
  </select>
  <% } %>
  <% if (followupCount || followupOnly) { %><label class="check"><input type="checkbox" name="followup" value="1" <%= followupOnly ? 'checked' : '' %> data-autosubmit> Só follow-ups pendentes (<%= followupCount %>)</label><% } %>
  <% if (q || ownerFilter || status || followupOnly || filterUi.count) { %><a class="link small" href="/convidados?view=<%= view %>">Limpar filtros</a><% } %>
</form>
<div class="board-tools"><%- include('../partials/filter-builder') %><% if (view === 'quadro') { %><%- include('../partials/card-fields') %><% } %></div>

<% if (view === 'quadro') { %>
<div class="board" data-board data-can-move="<%= can('guests.write') ? '1' : '0' %>">
  <% columns.forEach(function (col) { %>
  <section class="column" data-status="<%= col.key %>">
    <header><span class="badge b-st-<%= col.key %>"><%= col.label %></span><span class="count"><%= col.guests.length %></span></header>
    <div class="cards" data-dropzone>
      <% col.guests.forEach(function (g) { %>
      <a class="kcard" href="/convidados/<%= g.id %>" data-guest-id="<%= g.id %>" draggable="<%= can('guests.write') ? 'true' : 'false' %>">
        <strong><%= g.name %></strong><% if (g.origin === 'site') { %> <span class="file-tag" title="Pediu pelo site">site</span><% } %>
        <% if (g.instagram || g.profile) { %><span class="muted small handle"<%- cardUi.attr('perfil') %>><%= [g.instagram ? '@' + g.instagram : '', g.profile ? profileLabels[g.profile].label : ''].filter(Boolean).join(' · ') %></span><% } %>
        <% if (g.company || g.job_title) { %><span class="muted small"<%- cardUi.attr('empresa') %>><%= [g.job_title, g.company].filter(Boolean).join(' · ') %></span><% } %>
        <% if (g.topic) { %><span class="small topic"<%- cardUi.attr('tema') %>><%= g.topic %></span><% } %>
        <span class="meta small muted"><%- include('../partials/project-tag', { id: g.project_id }) %>
          <% if (g.status === 'perdido' && g.loss_reason) { %><span class="mono"<%- cardUi.attr('perda') %>><%= lossReasons[g.loss_reason] %></span><% } %>
          <% if (g.proposed_at) { %><span<%- cardUi.attr('gravacao') %>><%- icon('calendar', 12) %><%= fmt.shortDate(g.proposed_at) %></span><% } %>
          <% if (g.status === 'gravado') { %><% if (g.premiere_on) { %><span title="Estreia prevista"<%- cardUi.attr('estreia') %>><%- icon('play', 12) %>estreia <%= fmt.formatDayShort(g.premiere_on) %></span><% } else { %><span class="warn" title="Preencha a estreia prevista no cadastro"<%- cardUi.attr('estreia') %>><%- icon('play', 12) %>estreia não preenchida</span><% } %><% } %>
          <% if (g.outreach && g.outreach.state !== 'respondeu') { %><span class="outreach-chip <%= g.outreach.tone %>" title="<%= g.outreach.attempts %> abordagem(ns). <%= g.outreach.text %>"<%- cardUi.attr('followup') %>><%- icon('message-circle', 12) %><%= g.outreach.short %></span><% } %>
          <% if (g.invite_viewed_at) { %><span title="Abriu o convite em <%= fmt.formatDateTime(g.invite_viewed_at) %>"<%- cardUi.attr('convite') %>><%- icon('eye', 12) %>abriu o convite</span><% } else if (g.invite_sent_at) { %><span title="Convite enviado em <%= fmt.formatDateTime(g.invite_sent_at) %>"<%- cardUi.attr('convite') %>><%- icon('send', 12) %>convite enviado</span><% } else if (g.invite_token) { %><span title="O link do convite está pronto, ainda não foi enviado"<%- cardUi.attr('convite') %>><%- icon('link', 12) %>link pronto</span><% } %>
          <% if (g.email) { %><span class="mono"<%- cardUi.attr('email') %>><%= g.email %></span><% } %>
          <% if (g.phone) { %><span class="mono"<%- cardUi.attr('whatsapp') %>><%= fmt.phone(g.phone) %></span><% } %>
          <% if (g.reach) { %><span<%- cardUi.attr('alcance') %>><%- icon('users', 12) %><%= g.reach %></span><% } %>
          <span class="mono" title="Cadastrado em"<%- cardUi.attr('cadastro') %>>cad. <%= fmt.shortDate(g.created_at) %></span>
          <span class="mono" title="Atualizado em"<%- cardUi.attr('atualizado') %>>atual. <%= fmt.shortDate(g.updated_at) %></span>
        </span>
        <span class="card-foot"<%- cardUi.attr('responsavel') %>><%- include('../partials/dot', { type: 'guest', id: g.id, user: g.owner_id ? { id: g.owner_id, name: g.owner_name } : null, editable: can('guests.write'), inLink: true }) %></span>
      </a>
      <% }) %>
    </div>
  </section>
  <% }) %>
</div>
<% } else { %>
<% var canBulk = can('guests.write') && guests.length > 0; %>
<% if (canBulk) { %>
<div data-bulk>
  <p class="small muted" data-bulk-hint>Marque os convidados para mudar etapa, responsável, perfil, gênero ou patrocinador de vários de uma vez.</p>
  <div class="bulk-bar" data-bulk-bar hidden>
    <strong><span data-bulk-count class="mono">0</span> <span data-bulk-word="selecionado|selecionados">selecionados</span></strong>
    <div class="row">
      <button class="btn primary sm" type="button" data-modal-open="modal-massa">Editar em massa</button>
      <button class="link small" type="button" data-bulk-clear>Limpar seleção</button>
    </div>
  </div>
</div>
<% } %>
<div class="table-wrap">
<table>
  <thead><tr><% if (canBulk) { %><th class="check-col"><input type="checkbox" data-bulk-all aria-label="Marcar todos os convidados da lista"></th><% } %><th>Convidado</th><th>Perfil</th><th>Etapa</th><th class="nowrap">Gravação</th><th class="nowrap">Convite</th><th class="nowrap">Responsável</th></tr></thead>
  <tbody>
    <% if (!guests.length) { %><tr><td colspan="<%= canBulk ? 7 : 6 %>"><div class="empty"><%- include('../partials/signal') %><strong>Nenhum convidado por aqui ainda</strong><span>Cadastre o primeiro convidado ou ajuste os filtros.</span></div></td></tr><% } %>
    <% guests.forEach(function (g) { %>
    <tr>
      <% if (canBulk) { %><td class="check-col"><input type="checkbox" form="form-massa" name="ids" value="<%= g.id %>" data-bulk-pick aria-label="Marcar <%= g.name %>"></td><% } %>
      <td><a href="/convidados/<%= g.id %>"><strong><%= g.name %></strong></a> <%- include('../partials/project-tag', { id: g.project_id }) %><% if (g.origin === 'site') { %> <span class="file-tag" title="Pediu pelo site">site</span><% } %><br><span class="muted small handle"><%= g.instagram ? '@' + g.instagram : '' %></span><% if (g.outreach && g.outreach.state !== 'respondeu') { %> <span class="outreach-chip <%= g.outreach.tone %>" title="<%= g.outreach.attempts %> abordagem(ns). <%= g.outreach.text %>"><%- icon('message-circle', 12) %><%= g.outreach.short %></span><% } %></td>
      <td><%= g.profile ? profileLabels[g.profile].label : '—' %></td>
      <td><span class="badge b-st-<%= g.status %>"><%= statuses.find(function (s) { return s.key === g.status; }).label %></span></td>
      <td class="nowrap mono"><%= g.proposed_at ? fmt.formatDateTime(g.proposed_at) : '—' %></td>
      <td class="small nowrap"<%- g.invite_viewed_at ? ' title="Abriu o convite em ' + fmt.formatDateTime(g.invite_viewed_at) + '"' : '' %>><%= g.invite_viewed_at ? 'Abriu' : g.invite_sent_at ? 'Enviado' : g.invite_token ? 'Link pronto' : '—' %></td>
      <td><%- include('../partials/dot', { type: 'guest', id: g.id, user: g.owner_id ? { id: g.owner_id, name: g.owner_name } : null, editable: can('guests.write'), label: true }) %></td>
    </tr>
    <% }) %>
  </tbody>
</table>
</div>
<% if (typeof pager !== 'undefined' && pager) { %><%- include('../partials/pager', { pager }) %><% } %>
<% if (canBulk) { %>
<dialog class="modal" id="modal-massa" aria-labelledby="m-massa-h">
  <form method="post" action="/convidados/em-massa" id="form-massa" class="stack" data-bulk-form>
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <h2 id="m-massa-h">Editar <span data-bulk-count class="mono">0</span> <span data-bulk-word="convidado|convidados">convidados</span></h2>
    <p class="small muted">Só muda o que você escolher. Em branco, fica como está.</p>
    <label>Etapa
      <select name="status" data-bulk-status>
        <option value="">Não alterar</option>
        <% bulkStatuses.forEach(function (s) { %><option value="<%= s.key %>"><%= s.label %></option><% }) %>
      </select>
    </label>
    <p class="small muted">Agendado e Gravado pedem os dados de cada convidado: mude um a um. Quem não tiver o que a etapa exige (contato, foto) fica onde está e aparece no resultado.</p>
    <div class="stack" data-bulk-loss hidden>
      <label>Motivo da perda
        <select name="loss_reason" data-loss-select>
          <option value="">Escolha o motivo</option>
          <% Object.keys(lossReasons).forEach(function (k) { %><option value="<%= k %>"><%= lossReasons[k] %></option><% }) %>
        </select>
      </label>
      <label data-loss-note hidden>Qual o motivo?<input type="text" name="loss_note" maxlength="500"></label>
    </div>
    <label>Responsável
      <select name="owner_id">
        <option value="">Não alterar</option>
        <option value="nenhum">Sem responsável</option>
        <% owners.forEach(function (o) { %><option value="<%= o.id %>"><%= o.name %></option><% }) %>
      </select>
    </label>
    <div class="row-2">
      <label>Perfil
        <select name="profile"><option value="">Não alterar</option><% profiles.forEach(function (p) { %><option value="<%= p.key %>"><%= p.label %></option><% }) %></select>
      </label>
      <label>Gênero
        <select name="gender"><option value="">Não alterar</option><% genders.forEach(function (gd) { %><option value="<%= gd[0] %>"><%= gd[1] %></option><% }) %></select>
      </label>
    </div>
    <label>Patrocinador
      <select name="sponsor_id" data-bulk-sponsor>
        <option value="">Não alterar</option>
        <option value="nenhum">Desvincular</option>
        <% sponsors.forEach(function (s) { %><option value="<%= s.id %>"><%= s.company %></option><% }) %>
      </select>
    </label>
    <label data-bulk-relation hidden>Quem são
      <select name="sponsor_relation"><option value="indicado">Indicados pelo patrocinador</option><option value="representante">Pessoas do patrocinador</option></select>
    </label>
    <div class="row modal-actions"><button class="btn primary" type="submit">Aplicar</button><button class="btn ghost" type="button" data-modal-close>Cancelar</button></div>
  </form>
</dialog>
<% } %>
<% } %>
<%- include('../partials/foot') %>
