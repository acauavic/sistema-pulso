<%- include('../partials/head') %>
<%
  var C_TASK = { a_fazer: 'A fazer', fazendo: 'Fazendo', feito: 'Feito', bloqueada: 'Bloqueada' };
  var canW = can('guests.write');
  var canInv = can('guests.invite');
  var FUNNEL = ['prospect', 'convite_enviado', 'em_agendamento', 'agendado', 'gravado'];
  var idx = FUNNEL.indexOf(guest.status);
  var closed = idx < 0;
  var inviteUrl = guest.short_url || longUrl;
  var canEmail = canInv && guest.email && mailReady;
  var epNo = episode && episode.number ? 'EP.' + String(episode.number).padStart(3, '0') : 'Episódio';
  var agendaMissing = [!guest.scheduled_studio && 'estúdio', !guest.scheduled_hosts && 'hosts', !guest.scheduled_guest && 'convidado'].filter(Boolean);
  var showInvite = guest.invite_token || idx <= 2;
  var future = guest.proposed_at && new Date(guest.proposed_at).getTime() > Date.now();
  var whenUpper = function (d) { return fmt.formatLong(d).replace(' de ' + new Date(d).getFullYear(), '').toUpperCase(); };
  var hidden = function (name, value) { return '<input type="hidden" name="' + name + '" value="' + value + '">'; };
  var csrfField = '<input type="hidden" name="_csrf" value="' + csrf + '">';
  var advance = function (to, label, tone, confirm) {
    return '<form method="post" action="/convidados/' + guest.id + '/avancar" class="inline"' + (confirm ? ' data-confirm="' + confirm.replace(/&/g, '&amp;').replace(/"/g, '&quot;').replace(/</g, '&lt;') + '"' : '') + '>' + csrfField + hidden('para', to) +
      '<button class="btn ' + (tone || '') + '" type="submit">' + label + '</button></form>';
  };
  var openOnLoad = function (name) { return openModal === name ? 'data-open-on-load' : ''; };
%>
<div class="page-head">
  <div>
    <span class="kicker">Convidado<%= guest.instagram ? ' · @' + guest.instagram : '' %></span>
    <h1><%= guest.name %>
      <% if (canW) { %><button class="badge badge-btn b-st-<%= guest.status %>" type="button" data-modal-open="modal-etapa" aria-label="Mudar a etapa (agora: <%= statusInfo.label %>)" title="Mudar a etapa"><%= statusInfo.label %> <%- icon('chevron-down', 12) %></button>
      <% } else { %><span class="badge b-st-<%= guest.status %>"><%= statusInfo.label %></span><% } %></h1>
    <p class="muted top-gap"><%= [guest.profile ? profileLabels[guest.profile].label : '', guest.job_title, guest.company].filter(Boolean).join(' · ') %></p>
  </div>
  <div class="row">
    <a class="btn ghost" href="/convidados"><%- icon('arrow-left') %> Voltar</a>
    <% if (episode) { %><a class="btn" href="/episodios/<%= episode.id %>"><%- icon('film') %> <%= epNo %></a><% } %>
    <% if (canW) { %><a class="btn" href="/convidados/<%= guest.id %>/editar"><%- icon('pencil') %> Editar</a><% } %>
    <% if (can('guests.delete')) { %>
    <form method="post" action="/convidados/<%= guest.id %>/excluir" class="inline" data-confirm="Excluir <%= guest.name %> e todo o histórico? Esta ação não pode ser desfeita.">
      <input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn danger" type="submit"><%- icon('trash-2') %> Excluir</button>
    </form>
    <% } %>
  </div>
</div>

<ol class="stepper s5" aria-label="Etapas do convidado">
  <% FUNNEL.forEach(function (k, i) { %>
  <li class="<%= closed ? '' : (i < idx ? 'done' : (i === idx ? 'now' : '')) %>"><span class="step-n mono"><%= String(i + 1).padStart(2, '0') %></span><span class="step-l"><%= statuses.find(function (s) { return s.key === k; }).label %></span></li>
  <% }) %>
</ol>

<section class="card next-step" id="proximo">
  <span class="kicker">Próximo passo</span>

  <% if (guest.status === 'prospect') { %>
    <% if (!guest.invite_token) { %>
      <h2>Convidar <%= fmt.firstName(guest.name) %></h2>
      <p class="muted">Gere o link do convite: uma página com os dados da conversa, para mandar por e-mail ou WhatsApp.</p>
      <% if (canInv) { %>
      <div class="next-actions">
        <form method="post" action="/convidados/<%= guest.id %>/convite" class="inline"><%- csrfField %><button class="btn primary" type="submit"><%- icon('link') %> Gerar link do convite</button></form>
      </div>
      <% } %>
    <% } else { %>
      <h2>Enviar o convite</h2>
      <p class="muted">O link está pronto. Mande por e-mail daqui ou copie para o WhatsApp.<%= !guest.email ? ' Sem e-mail cadastrado: dá para enviar só pelo WhatsApp.' : '' %></p>
      <div class="next-actions">
        <% if (canEmail) { %><button class="btn primary" type="button" data-modal-open="modal-email"><%- icon('mail') %> Enviar por e-mail</button><% } %>
        <button class="btn" type="button" data-copy="<%= inviteUrl %>">Copiar link</button>
        <% if (canW) { %><%- advance('convite_enviado', 'Já enviei pelo WhatsApp', canEmail ? 'ghost' : '') %><% } %>
      </div>
    <% } %>

  <% } else if (guest.status === 'convite_enviado') { %>
    <h2>Aguardando resposta</h2>
    <p class="muted mono-line">
      <span>ENVIADO <%= guest.invite_sent_at ? fmt.formatDateTime(guest.invite_sent_at) : '—' %></span>
      <span><%= guest.invite_viewed_at ? 'ABERTO ' + fmt.formatDateTime(guest.invite_viewed_at) : 'AINDA NÃO ABRIU' %></span>
    </p>
    <% if (outreachCtx.d) { %><p class="small <%= outreachCtx.d.tone === 'bad' ? 'err' : outreachCtx.d.tone === 'warn' ? 'warn' : 'muted' %>"><%= outreachCtx.d.text %></p><% } %>
    <p class="small muted">Quando <%= fmt.firstName(guest.name) %> responder pelo convite, a etapa muda sozinha. Se a resposta veio por outro canal, registre a abordagem e depois marque que aceitou.</p>
    <% if (canW) { %>
    <div class="next-actions">
      <button class="btn primary" type="button" data-modal-open="modal-abordagem"><%- icon('send') %> Registrar abordagem</button>
      <% if (guest.email || guest.phone) { %><%- advance('em_agendamento', 'Aceitou o convite', '') %>
      <% } else { %><button class="btn" type="button" data-modal-open="modal-contato">Aceitou o convite</button><% } %>
    </div>
    <details class="more top-gap">
      <summary>Mais ações</summary>
      <div class="next-actions">
        <% if (canEmail) { %><button class="btn sm" type="button" data-modal-open="modal-email"><%- icon('mail') %> Reenviar o convite por e-mail</button><% } %>
        <% if (inviteUrl) { %><button class="btn sm" type="button" data-copy="<%= inviteUrl %>">Copiar link do convite</button><% } %>
        <button class="btn sm ghost" type="button" data-modal-open="modal-perda">Marcar como perdido</button>
      </div>
    </details>
    <% } %>

  <% } else if (guest.status === 'em_agendamento') { %>
    <h2>Marcar a gravação</h2>
    <% if (guest.proposed_at) { %>
      <p class="big-date mono"><%= whenUpper(guest.proposed_at) %></p>
      <p class="small warn">Data proposta. Falta confirmar com: <%= agendaMissing.join(', ') %>.</p>
    <% } else { %>
      <p class="muted"><%= fmt.firstName(guest.name) %> aceitou. Combine a data e confirme com o estúdio, os hosts e <%= guest.gender === 'f' ? 'a convidada' : 'o convidado' %>.</p>
    <% } %>
    <% if (canW) { %>
    <div class="next-actions">
      <button class="btn primary" type="button" data-modal-open="modal-agenda"><%- icon('calendar') %> <%= guest.proposed_at ? 'Confirmar a data' : 'Definir data da gravação' %></button>
      <%- advance('cancelado', 'Cancelar', 'ghost', 'Cancelar a participação de ' + guest.name + '?') %>
    </div>
    <% } %>

  <% } else if (guest.status === 'agendado') { %>
    <h2>Gravação marcada</h2>
    <p class="big-date mono"><%= whenUpper(guest.proposed_at) %> <span class="rel"><%= fmt.relativeDays(guest.proposed_at) %></span></p>
    <p class="small muted">Confirmada com estúdio, hosts e <%= guest.gender === 'f' ? 'convidada' : 'convidado' %>. Já aparece na agenda (media kit e portal dos patrocinadores). O episódio nasce quando a conversa for gravada.</p>
    <% if (bookings.length) { %><p class="small muted">Reservada por: <% bookings.forEach(function (b, i) { %><%= i ? ', ' : '' %><a href="/patrocinadores/<%= b.id %>"><%= b.company %></a> (<%= b.role === 'exclusivo' ? 'exclusivo' : 'inserção' %>)<% }) %></p><% } %>
    <% if (canW) { %>
    <div class="next-actions">
      <%- advance('gravado', 'Marcar como gravado', 'primary', future ? 'A gravação está marcada para ' + fmt.formatDateTime(guest.proposed_at) + '. Marcar como gravado mesmo assim?' : null) %>
      <button class="btn" type="button" data-modal-open="modal-agenda">Remarcar</button>
      <%- advance('cancelado', 'Cancelar gravação', 'ghost', 'Cancelar a gravação com ' + guest.name + '?') %>
    </div>
    <% } %>

  <% } else if (guest.status === 'gravado') { %>
    <% var aired = episode && episode.status === 'publicado'; %>
    <h2><%= aired ? 'No ar' : 'Conversa gravada' %></h2>
    <p class="muted"><%= aired ? 'Obrigado por sentar à mesa. Os links ficam aqui para compartilhar com ' + (guest.gender === 'f' ? 'a convidada' : 'o convidado') + '.' : 'A parte do convidado terminou. Daqui em diante é o episódio: edição, revisão e publicação.' %></p>
    <% if (episode && !aired) { %><p class="mono-line muted"><span><%= epNo %> · <%= (episodeStages[episode.status] || '').toUpperCase() %></span></p><% } %>
    <div class="next-actions">
      <% if (episode) { %><a class="btn <%= aired ? '' : 'primary' %>" href="/episodios/<%= episode.id %>"><%- icon('film') %> Abrir <%= epNo %></a><% } %>
      <% if (aired && episode.youtube_url) { %><a class="btn" href="<%= episode.youtube_url %>" target="_blank" rel="noopener noreferrer"><%- icon('external-link') %> YouTube</a><% } %>
      <% if (aired && episode.spotify_url) { %><a class="btn" href="<%= episode.spotify_url %>" target="_blank" rel="noopener noreferrer"><%- icon('external-link') %> Spotify</a><% } %>
    </div>

  <% } else { %>
    <% if (guest.status === 'perdido') { %>
    <h2>Perdido</h2>
    <p class="mono-line muted"><span>MOTIVO: <%= (lossReasons[guest.loss_reason] || '—').toUpperCase() %></span></p>
    <% if (guest.loss_note) { %><p class="quote pre"><%= guest.loss_note %></p><% } %>
    <% } else { %>
    <h2>Participação cancelada</h2>
    <% if (guest.rsvp_message) { %><p class="quote pre"><%= guest.rsvp_message %></p><% } %>
    <% } %>
    <% if (canW) { %><div class="next-actions"><%- advance('prospect', 'Retomar contato', '') %></div><% } %>
  <% } %>

</section>

<div class="tabs-wrap top-gap" data-tabs data-default="resumo">
  <div class="tabbar" role="tablist" aria-label="Seções do convidado">
    <button type="button" role="tab" data-tab-btn="resumo" aria-controls="pane-resumo">Resumo</button>
    <% if (showInvite) { %><button type="button" role="tab" data-tab-btn="convite" aria-controls="pane-convite">Convite</button><% } %>
    <% if (pagePlateia) { %><button type="button" role="tab" data-tab-btn="pagina" aria-controls="pane-pagina">Página da plateia<% if (guest.audience_page_enabled) { %> <span class="count"><%= pagePlateia.partners.filter(function (p) { return p.active; }).length || '' %></span><% } %></button><% } %>
    <% if (portalTab) { %><button type="button" role="tab" data-tab-btn="portal" aria-controls="pane-portal">Portal<% if (portalTab.pending.length) { %> <span class="count"><%= portalTab.pending.length %></span><% } %></button><% } %>
    <button type="button" role="tab" data-tab-btn="historico" aria-controls="pane-historico">Histórico <span class="count"><%= events.length %></span></button>
  </div>

  <div class="pane" id="pane-resumo" data-pane-id="resumo">
    <div class="grid-2 align-start">
      <div class="stack-lg">
        <section class="card" id="sobre">
          <h2>Sobre</h2>
          <dl class="kv">
            <dt>Responsável</dt><dd><%- include('../partials/dot', { type: 'guest', id: guest.id, user: guest.owner_id ? { id: guest.owner_id, name: guest.owner_name } : null, editable: canW, label: true }) %></dd>
            <% if (guest.phone) { %><dt>WhatsApp</dt><dd class="handle"><%= guest.phone %></dd><% } %>
            <% if (guest.email) { %><dt>E-mail</dt><dd><%= guest.email %></dd><% } %>
            <% if (guest.invite_reason) { %><dt>Motivo do convite</dt><dd class="pre"><%= guest.invite_reason %></dd><% } %>
            <% if (guest.positioning) { %><dt>Posicionamento</dt><dd class="pre"><%= guest.positioning %></dd><% } %>
            <% if (guest.topic) { %><dt>Temas</dt><dd class="pre"><%= guest.topic %></dd><% } %>
            <% if (guest.bio) { %><dt>Biografia</dt><dd class="pre"><%= guest.bio %></dd><% } %>
            <% if (linkedSponsor) { %><dt>Patrocinador</dt><dd><a href="/patrocinadores/<%= linkedSponsor.id %>"><%= linkedSponsor.company %></a> <span class="muted small">· <%= guest.sponsor_relation === 'representante' ? 'pessoa do patrocinador' : 'indicado pelo patrocinador' %></span></dd><% } %>
            <% if (guest.proposed_at && idx >= 4) { %><dt>Gravação</dt><dd class="mono"><%= fmt.formatDateTime(guest.proposed_at) %></dd><% } %>
            <% if (guest.notes) { %><dt>Observações</dt><dd class="pre"><%= guest.notes %></dd><% } %>
            <% if (guest.rsvp_message && !closed) { %><dt>Recado</dt><dd class="quote pre"><%= guest.rsvp_message %></dd><% } %>
          </dl>
          <% var gaps = [!guest.phone && !guest.email && 'contato', !guest.positioning && 'posicionamento', !guest.topic && 'temas', !guest.bio && 'biografia'].filter(Boolean); %>
          <% if (canW && gaps.length) { %><p class="small muted top-gap">Sem <%= gaps.join(', ') %>. <a href="/convidados/<%= guest.id %>/editar">Completar cadastro</a></p><% } %>
        </section>
        <%- include('../partials/comments', { type: 'guest', id: guest.id, items: comments, back: '/convidados/' + guest.id }) %>
      </div>

      <div class="stack-lg">
      <% if (outreachCtx.sm || outreachCtx.hist.length) { %><%- include('../partials/outreach-card', Object.assign({ canWrite: canW }, outreachCtx)) %><% } %>
      <% if (reminderList.length) { var R_STATE = { enviado: ['b-gray', 'enviado'], agora: ['b-amber', 'na hora'], agendado: ['b-gray', 'agendado'], passou: ['b-gray', 'não enviado'] }; %>
      <section class="card" id="lembretes">
        <h2>Lembretes da gravação</h2>
        <p class="small muted">A produtora manda pelo WhatsApp. Na hora de cada um, o sistema avisa.</p>
        <ul class="plain reminder-list">
          <% reminderList.forEach(function (r) { %>
          <li class="<%= r.current ? 'is-current' : '' %>">
            <div class="reminder-head">
              <span><strong><%= r.label %></strong> <span class="small muted">· <%= r.hint %><%= r.withAddress ? ' (com o endereço)' : '' %></span></span>
              <span class="badge <%= R_STATE[r.state][0] %>"><%= R_STATE[r.state][1] %></span>
            </div>
            <span class="handle muted"><%= r.state === 'enviado' ? 'Enviado ' + (r.sendCount > 1 ? r.sendCount + '× · último ' : '') + fmt.formatDateTime(r.sentAt) + (r.sentBy ? ' · ' + r.sentBy : '') : fmt.formatDateTime(r.due) %></span>
            <% if (canW && (r.current || r.state === 'enviado' || r.state === 'passou')) { %>
            <details class="more"><summary>Ver mensagem</summary><p class="pre small"><%= r.text %></p></details>
            <%- include('../partials/reminder-actions', { it: r, guestId: guest.id, guestName: guest.name }) %>
            <% } %>
          </li>
          <% }) %>
        </ul>
      </section>
      <% } %>
      <% if (['em_agendamento', 'agendado'].indexOf(guest.status) >= 0) { %>
      <section class="card" id="plateia">
        <div class="row spread"><h2>Podcast com plateia</h2><% if (plateia.leads && plateia.canSeeLeads) { %><a class="small" href="/plateia/painel?convidado=<%= guest.id %>"><span class="mono"><%= plateia.leads %></span> inscrição<%= plateia.leads === 1 ? '' : 'ões' %></a><% } %></div>
        <% if (canW) { %>
        <form method="post" action="/convidados/<%= guest.id %>/plateia" class="stack">
          <input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="enabled" value="0">
          <label class="check"><input type="checkbox" name="enabled" value="1" <%= guest.audience_enabled ? 'checked' : '' %> data-autosubmit> Aberto para plateia</label>
          <% if (guest.audience_enabled) { %>
          <label>Vagas<select name="status" data-autosubmit><% [['disponivel', 'Disponível'], ['lotado', 'Lotado'], ['encerrado', 'Inscrições encerradas']].forEach(function (o) { %><option value="<%= o[0] %>" <%= guest.audience_status === o[0] ? 'selected' : '' %>><%= o[1] %></option><% }) %></select></label>
          <% } else { %><input type="hidden" name="status" value="<%= guest.audience_status %>"><% } %>
        </form>
        <% } else { %><p class="small"><%= guest.audience_enabled ? 'Aberto para plateia' : 'Fora da plateia' %></p><% } %>
        <% if (guest.audience_enabled) { %><p class="small"><a href="#pagina"><%= guest.audience_page_enabled ? 'Página própria da gravação e links de parceiro' : 'Criar uma página só desta gravação' %></a></p><% } %>
        <p class="small muted"><%= guest.audience_enabled ? (guest.status === 'agendado' && guest.proposed_at && new Date(guest.proposed_at) > new Date() ? 'Aparece na agenda pública da plateia.' : 'Entra na agenda pública quando a gravação estiver Agendada, com data futura.') : 'Fora da agenda pública da plateia.' %></p>
        <% if (canW) { %>
        <div data-image-scope>
        <div class="row top-gap">
          <% if (guest.photo_key) { %><img class="guest-photo" src="/convidados/<%= guest.id %>/foto" alt="Foto <%= guest.gender === 'f' ? 'da convidada' : 'do convidado' %> na moldura padrão" width="96" height="72" loading="lazy"><% } %>
          <button class="btn sm" type="button" data-image-pick="" <%= plateia.storageReady ? '' : 'disabled' %>><%- icon('upload', 14) %> <%= guest.photo_key ? 'Trocar foto' : 'Enviar foto' %></button>
          <span class="small muted"><%= guest.photo_key ? '' : 'A página pública usa a foto do convidado.' %></span>
        </div>
        <input type="file" accept="image/png,image/jpeg,image/webp" hidden data-image-input data-crop="<%= photoFrame.ratio %>" data-csrf="<%= csrf %>" data-base="/convidados/<%= guest.id %>/foto">
        </div>
        <% } %>
      </section>
      <% } %>
      <section class="card" id="tarefas">
        <div class="row spread"><h2>Tarefas<%= linkedTasks.length ? ' (' + linkedTasks.length + ')' : '' %></h2><% if (can('tasks.write')) { %><a class="btn sm" href="/tarefas?nova=1&convidado=<%= guest.id %>"><%- icon('plus') %> Nova tarefa</a><% } %></div>
        <% if (!linkedTasks.length) { %><p class="muted small">Nenhuma tarefa ligada a este convidado.</p><% } %>
        <ul class="plain mini-tasks"><% linkedTasks.forEach(function (t) { %><li class="st-<%= t.status %>"><a href="/tarefas/<%= t.id %>"><%= t.title %></a><span class="handle muted"><%= C_TASK[t.status] %><%= t.due_on ? ' · ' + fmt.formatDueShort(t.due_on, t.due_time) : '' %><%= t.assignee_name ? ' · ' + t.assignee_name : '' %></span></li><% }) %></ul>
      </section>
      </div>
    </div>
  </div>

  <% if (showInvite) { %>
  <div class="pane" id="pane-convite" data-pane-id="convite">
    <section class="card" id="convite">
      <% if (!guest.invite_token) { %>
        <h2>Convite</h2>
        <p class="muted">Ainda não há link. Ao gerar, criamos uma página exclusiva do convite com os dados deste convidado<%= yourlsReady ? ' e um link curto' : '' %>.</p>
      <% } else { %>
        <div class="grid-2 align-start">
          <div class="stack">
            <h2>Link do convite</h2>
            <label class="copy-field">Link curto (para enviar)
              <div class="row">
                <input type="text" readonly value="<%= inviteUrl %>" class="grow" data-select-on-focus>
                <button class="btn" type="button" data-copy="<%= inviteUrl %>">Copiar</button>
              </div>
            </label>
            <% if (!guest.short_url) { %>
              <p class="small muted">Sem link curto (encurtador indisponível). Este é o link completo.</p>
              <% if (canInv && yourlsReady) { %><form method="post" action="/convidados/<%= guest.id %>/convite" class="inline"><%- csrfField %><button class="link small" type="submit">Tentar encurtar de novo</button></form><% } %>
            <% } else { %>
              <p class="small muted">Link completo: <a href="<%= longUrl %>" target="_blank" rel="noopener"><%= longUrl %></a></p>
            <% } %>
            <p class="small muted">O convite trata como <strong><%= guest.is_plural ? (guest.gender === 'f' ? 'convidadas' : 'convidados') : (guest.gender === 'f' ? 'convidada' : 'convidado') %></strong>. Ajuste em Editar.</p>
            <div class="row">
              <a class="btn" href="/convidados/<%= guest.id %>/previa" target="_blank" rel="noopener"><%- icon('eye') %> Ver convite</a>
              <% if (canEmail) { %><button class="btn" type="button" data-modal-open="modal-email"><%- icon('mail') %> <%= guest.invite_sent_at ? 'Reenviar' : 'Enviar' %> por e-mail</button><% } %>
              <% if (canInv) { %>
              <form method="post" action="/convidados/<%= guest.id %>/convite" class="inline" data-confirm="Gerar um novo link? O link atual deixará de funcionar.">
                <%- csrfField %><input type="hidden" name="regenerar" value="1"><button class="btn ghost" type="submit">Gerar novo link</button>
              </form>
              <% } %>
            </div>
          </div>
          <div class="stack">
            <h2>Acompanhamento</h2>
            <dl class="kv">
              <dt>Gerado</dt><dd class="handle"><%= fmt.formatDateTime(guest.invite_generated_at) %></dd>
              <dt>Enviado</dt><dd class="handle"><%= guest.invite_sent_at ? fmt.formatDateTime(guest.invite_sent_at) : 'ainda não' %></dd>
              <dt>Aberto</dt><dd class="handle"><%= guest.invite_viewed_at ? fmt.formatDateTime(guest.invite_viewed_at) : 'ainda não' %></dd>
              <dt>Resposta</dt><dd class="handle"><%= guest.responded_at ? fmt.formatDateTime(guest.responded_at) + ' · ' + (guest.status === 'perdido' && guest.loss_reason === 'recusado' ? 'recusou' : idx >= 2 ? 'aceitou' : 'respondeu') : 'sem resposta' %></dd>
              <% Object.keys(clickKinds).forEach(function (k) { %>
              <dt><%= clickKinds[k] %></dt>
              <dd><strong class="mono"><%= clicks[k].total %></strong><% if (clicks[k].total) { %> <span class="handle muted">· último <%= fmt.formatDateTime(clicks[k].last) %></span><% } %></dd>
              <% }) %>
            </dl>
            <% if (canW && ['agendado', 'gravado'].indexOf(guest.status) < 0 && (clicks.aceitar.total || guest.responded_at || ['em_agendamento', 'perdido', 'cancelado'].indexOf(guest.status) >= 0)) { %>
            <form method="post" action="/convidados/<%= guest.id %>/zerar-aceite" class="inline" data-confirm="Zerar o aceite de <%= guest.name %>? O contador volta a zero, a resposta é apagada e <%= fmt.firstName(guest.name) %> volta para Prospecção.">
              <input type="hidden" name="_csrf" value="<%= csrf %>"><button class="link small" type="submit">Zerar aceite e voltar para Prospecção</button>
            </form>
            <% } %>
          </div>
        </div>
      <% } %>
    </section>
  </div>
  <% } %>

  <% if (pagePlateia) { var P = pagePlateia; var csrfF = '<input type="hidden" name="_csrf" value="' + csrf + '">'; %>
  <div class="pane" id="pane-pagina" data-pane-id="pagina">
    <% if (!guest.audience_page_enabled) { %>
    <section class="card empty page-off">
      <%- include('../partials/pulse-line') %>
      <h2>Página só da gravação com <%= fmt.firstName(guest.name) %></h2>
      <p class="muted">Além da agenda geral, <%= fmt.firstName(guest.name) %> pode ter uma página própria para divulgar: fotos, como será a gravação, horário de chegada da plateia e links de parceiro com participação isenta. Os pedidos caem no mesmo painel da plateia.</p>
      <% if (canW) { %><form method="post" action="/convidados/<%= guest.id %>/plateia/pagina" class="inline"><%- csrfF %><input type="hidden" name="on" value="1"><button class="btn primary" type="submit"><%- icon('globe') %> Ativar página</button></form><% } %>
    </section>
    <% } else { %>
    <div class="grid-2 align-start">
      <div class="stack-lg">
        <section class="card">
          <div class="row spread"><h2>Página</h2><span class="badge <%= P.live && guest.audience_status === 'disponivel' ? 'b-green' : 'b-gray' %>"><%= !P.live ? 'fora do ar' : guest.audience_status === 'disponivel' ? 'no ar' : guest.audience_status === 'lotado' ? 'lotado' : 'encerrado' %></span></div>
          <p class="mono small page-url"><%= P.url %></p>
          <div class="row">
            <button class="btn primary" type="button" data-copy="<%= P.url %>"><%- icon('copy') %> Copiar link</button>
            <a class="btn ghost" href="<%= P.url %>" target="_blank" rel="noopener"><%- icon('external-link') %> Abrir</a>
          </div>
          <% if (!P.live) { %><p class="small muted top-gap">A página recebe pedidos quando a gravação estiver Agendada, com data futura. Até lá, quem abrir vê "Inscrições encerradas".</p><% } %>
          <dl class="kv top-gap">
            <dt>Chegada da plateia</dt><dd class="mono"><%= P.arrival || '—' %></dd>
            <dt>Como será</dt><dd class="pre<%= guest.audience_intro ? '' : ' muted' %>"><%= guest.audience_intro || 'Sem texto: a seção não aparece.' %></dd>
            <dt>Bloco extra</dt><dd class="pre<%= guest.audience_extra ? '' : ' muted' %>"><% if (guest.audience_extra) { %><% if (guest.audience_extra_title) { %><strong><%= guest.audience_extra_title %></strong><br><% } %><%= guest.audience_extra %><% } else { %>Vazio: não aparece.<% } %></dd>
          </dl>
          <% if (canW) { %>
          <div class="row top-gap">
            <button class="btn sm" type="button" data-modal-open="modal-pagina"><%- icon('pencil', 14) %> Editar página</button>
            <form method="post" action="/convidados/<%= guest.id %>/plateia/pagina" class="inline push-right" data-confirm="Desativar a página? O endereço e os links de parceiro deixam de funcionar (os pedidos já feitos continuam no painel)."><%- csrfF %><input type="hidden" name="on" value="0"><button class="link small danger-link" type="submit">desativar página</button></form>
          </div>
          <% } %>
        </section>

        <section class="card" data-image-scope>
          <div class="row spread"><h2>Fotos <span class="mono muted small"><%= P.photos.length %>/<%= P.max %></span></h2>
            <% if (canW && P.photos.length < P.max) { %><button class="btn sm" type="button" data-image-pick="" <%= storageReady ? '' : 'disabled' %>><%- icon('upload', 14) %> Enviar foto</button><% } %></div>
          <% if (!P.photos.length) { %><p class="small muted">Sem fotos: a seção não aparece. O topo da página já usa a foto principal de <%= fmt.firstName(guest.name) %>.</p><% } %>
          <ul class="plain page-photos">
            <% P.photos.forEach(function (ph) { %><li><img class="guest-photo" src="/plateia/com/<%= guest.audience_slug %>/fotos/<%= ph.id %>" alt="Foto da página" width="160" height="120" loading="lazy"><% if (canW) { %><form method="post" action="/convidados/<%= guest.id %>/plateia/pagina/fotos/<%= ph.id %>/excluir" class="inline" data-confirm="Tirar esta foto da página?"><%- csrfF %><button class="link small" type="submit">tirar</button></form><% } %></li><% }) %>
          </ul>
          <% if (canW) { %><input type="file" accept="image/png,image/jpeg,image/webp" hidden data-image-input data-crop="<%= photoFrame.ratio %>" data-csrf="<%= csrf %>" data-base="/convidados/<%= guest.id %>/plateia/pagina/fotos"><% } %>
        </section>
      </div>

      <section class="card">
        <div class="row spread"><h2>Links de parceiro</h2><% if (canW) { %><button class="btn sm" type="button" data-fill-modal="modal-parceiro" data-fill-mode="new" data-fill-action="/convidados/<%= guest.id %>/plateia/parceiros" data-fill='{"name":"","slots":""}'><%- icon('plus', 14) %> Novo link</button><% } %></div>
        <% if (!P.partners.length) { %><p class="small muted">Um parceiro manda o link dele para os próprios clientes: quem pede por ele vê a participação isenta dos <%= plateia.price || 'valores' %> e, se for selecionado, não paga. Dá para limitar as vagas; esgotado, o link mostra o valor normal.</p><% } %>
        <ul class="plain partner-list">
          <% P.partners.forEach(function (p) { var link = P.url + '/' + p.token; %>
          <li class="<%= p.active ? '' : 'is-off' %>">
            <div class="row spread">
              <strong class="display"><%= p.name %></strong>
              <span class="badge <%= !p.active ? 'b-gray' : p.left === 0 ? 'b-amber' : 'b-gray' %>"><%= !p.active ? 'desativado' : p.left === 0 ? 'vagas esgotadas' : 'ativo' %></span>
            </div>
            <span class="mono small muted"><%= p.slots ? p.used + ' de ' + p.slots + ' vagas' : 'sem limite · ' + p.used + ' pedido' + (p.used === 1 ? '' : 's') %><%= p.total > p.used ? ' · ' + (p.total - p.used) + ' fora (não selecionado ou desistiu)' : '' %></span>
            <span class="mono small page-url"><%= link %></span>
            <div class="row">
              <% if (p.active) { %><button class="btn sm" type="button" data-copy="<%= link %>"><%- icon('copy', 14) %> Copiar link</button><% } %>
              <% if (canW) { %>
              <button class="link small" type="button" data-fill-modal="modal-parceiro" data-fill-mode="edit" data-fill-action="/convidados/<%= guest.id %>/plateia/parceiros/<%= p.id %>" data-fill='<%- JSON.stringify({ name: p.name, slots: p.slots ? String(p.slots) : "" }).replace(/'/g, "&#39;") %>'>editar</button>
              <form method="post" action="/convidados/<%= guest.id %>/plateia/parceiros/<%= p.id %>" class="inline"<% if (p.active) { %> data-confirm="Desativar o link de <%= p.name %>? Quem abrir passa a ver a página normal, com o valor."<% } %>><%- csrfF %><input type="hidden" name="active" value="<%= p.active ? '0' : '1' %>"><button class="link small" type="submit"><%= p.active ? 'desativar' : 'ativar de novo' %></button></form>
              <% } %>
            </div>
          </li>
          <% }) %>
        </ul>
        <% if (P.partners.length && plateia.canSeeLeads) { %><p class="small top-gap"><a href="/plateia/painel?convidado=<%= guest.id %>">Ver os pedidos no painel da plateia</a></p><% } %>
      </section>
    </div>
    <% if (canW) { %>
    <dialog class="modal modal-wide" id="modal-pagina" aria-labelledby="mpg-h">
      <form method="post" action="/convidados/<%= guest.id %>/plateia/pagina/editar" class="stack">
        <%- csrfF %>
        <h2 id="mpg-h">Editar página</h2>
        <p class="small muted">O que ficar vazio não aparece na página.</p>
        <label>Como será a gravação<textarea name="intro" rows="5" maxlength="1200" placeholder="Ex.: uma conversa sobre gestão de clínicas, com abertura para perguntas da plateia no fim."><%= guest.audience_intro || '' %></textarea></label>
        <label>Horário de chegada da plateia <small class="muted">(a gravação está marcada para <%= guest.proposed_at ? fmt.formatDateTime(guest.proposed_at) : 'data a definir' %>)</small><input type="time" name="arrival" value="<%= P.arrivalInput %>"></label>
        <fieldset class="stack">
          <legend class="small muted">Bloco extra (opcional)</legend>
          <label>Título<input type="text" name="extra_title" maxlength="80" value="<%= guest.audience_extra_title || '' %>" placeholder="Ex.: O que levar"></label>
          <label>Texto<textarea name="extra" rows="4" maxlength="1500"><%= guest.audience_extra || '' %></textarea></label>
        </fieldset>
        <div class="row modal-actions"><button class="btn primary" type="submit">Salvar</button><button class="btn ghost" type="button" data-modal-close>Cancelar</button></div>
      </form>
    </dialog>
    <dialog class="modal" id="modal-parceiro" aria-labelledby="mpa-h">
      <form method="post" action="" class="stack" data-fill-form>
        <%- csrfF %>
        <h2 id="mpa-h"><span data-mode="new">Novo link de parceiro</span><span data-mode="edit">Editar link de parceiro</span></h2>
        <p class="small muted" data-mode="new">Quem pedir pelo link vê "participação isenta, convite de [parceiro]" e, se for selecionado, entra como isento. A seleção continua com vocês.</p>
        <label>Nome do parceiro <small class="muted">(aparece na página)</small><input type="text" name="name" maxlength="80" required placeholder="Ex.: Clínica Vida"></label>
        <label>Vagas isentas <small class="muted">(vazio = sem limite)</small><input type="number" name="slots" min="1" max="500" inputmode="numeric" placeholder="Ex.: 5"></label>
        <p class="small muted">Contam as vagas os pedidos em andamento e os selecionados. Quem não for selecionado ou desistir devolve a vaga.</p>
        <div class="row modal-actions"><button class="btn primary" type="submit"><span data-mode="new">Criar link</span><span data-mode="edit">Salvar</span></button><button class="btn ghost" type="button" data-modal-close>Cancelar</button></div>
      </form>
    </dialog>
    <% } %>
    <% } %>
  </div>
  <% } %>

  <% if (portalTab) { var PT = portalTab; var pg = PT.g; var pc = PT.c; var csrfP = '<input type="hidden" name="_csrf" value="' + csrf + '">'; var gFirst = fmt.firstName(guest.name); %>
  <div class="pane" id="pane-portal" data-pane-id="portal">
    <% if (!pg.portal_enabled) { %>
    <section class="card empty page-off">
      <%- include('../partials/pulse-line') %>
      <h2>Portal de <%= gFirst %></h2>
      <p class="muted">Uma página só de <%= gFirst %> que se atualiza sozinha durante a semana do episódio: o cronograma, os posts em collab (o sistema reconhece pelo @ no collab do Instagram), os cortes que não foram publicados como exclusivos, os links do episódio e as fotos que vocês escolherem.</p>
      <% if (canW) { %><form method="post" action="/convidados/<%= guest.id %>/portal" class="inline"><%- csrfP %><input type="hidden" name="on" value="1"><button class="btn primary" type="submit"><%- icon('globe') %> Ativar portal</button></form><% } %>
    </section>
    <% } else { %>
    <% if (PT.pending.length) { %>
    <section class="card notice-card">
      <div class="row spread">
        <div>
          <h2><%= PT.pending.length === 1 ? 'Um post novo' : PT.pending.length + ' posts novos' %> em collab para avisar</h2>
          <p class="small muted m-0"><%= PT.pending.map(function (p) { return p.title; }).join(' · ') %></p>
        </div>
        <form method="post" action="/convidados/<%= guest.id %>/portal/avisar" class="inline" target="_blank"><%- csrfP %><button class="btn primary" type="submit"><%- icon('message-circle') %> Avisar no WhatsApp</button></form>
      </div>
    </section>
    <% } %>
    <div class="grid-2 align-start">
      <div class="stack-lg">
        <section class="card">
          <div class="row spread"><h2>Portal</h2><span class="badge <%= pg.portal_sent_at ? 'b-gray' : 'b-amber' %>"><%= pg.portal_sent_at ? 'link enviado ' + fmt.formatDay(pg.portal_sent_at).slice(0, 5) : 'link não enviado' %></span></div>
          <p class="mono small page-url"><%= PT.url %></p>
          <div class="row">
            <% if (!pg.portal_sent_at) { %>
            <button class="btn primary" type="button" data-modal-open="modal-portal-enviar"><%- icon('send') %> Enviar link</button>
            <button class="btn ghost" type="button" data-copy="<%= PT.url %>"><%- icon('copy') %> Copiar</button>
            <% } else { %>
            <button class="btn <%= PT.pending.length ? '' : 'primary' %>" type="button" data-copy="<%= PT.url %>"><%- icon('copy') %> Copiar link</button>
            <a class="btn ghost" href="<%= PT.url %>" target="_blank" rel="noopener"><%- icon('external-link') %> Abrir</a>
            <% } %>
          </div>
          <% if (!pg.portal_sent_at) { %><p class="small muted top-gap">Mande quando os cortes começarem. Os posts em collab que já estiverem no ar entram no portal sem aviso; os seguintes geram aviso.</p><% } %>
          <dl class="kv top-gap">
            <dt>Cortes começam</dt><dd class="mono"><%= PT.dayLabel(pg.cuts_from) || '—' %><%= pg.cuts_from && !pg.cuts_from_set ? ' · automático' : '' %></dd>
            <dt>Episódio no ar</dt><dd class="mono"><%= PT.dayLabel(pg.release_on) || 'sem data' %><%= pg.release_on && !pg.release_on_set ? ' · do episódio' : '' %></dd>
            <dt>Exclusivos</dt><dd class="mono"><%= PT.dayLabel(pg.exclusive_from) || '—' %><%= pg.exclusive_from && !pg.exclusive_from_set ? ' · com o episódio' : '' %></dd>
            <dt>Aviso de post novo</dt><dd><%= PT.NOTIFY[pg.portal_notify] %><%= pg.portal_notify === 'auto' ? ' (' + PT.NOTIFY[PT.channel].toLowerCase() + ')' : '' %></dd>
          </dl>
          <% if (!pg.release_on) { %><p class="small muted">Sem data de veiculação no episódio: o cronograma aparece quando ela for preenchida (ou ajuste aqui).</p><% } %>
          <% if (canW) { %>
          <div class="row top-gap">
            <button class="btn sm" type="button" data-modal-open="modal-portal-ajustes"><%- icon('pencil', 14) %> Cronograma e aviso</button>
            <% if (pg.portal_sent_at) { %><button class="link small" type="button" data-modal-open="modal-portal-enviar">enviar de novo</button><% } %>
            <form method="post" action="/convidados/<%= guest.id %>/portal/novo-link" class="inline push-right" data-confirm="Gerar um link novo? O atual para de funcionar e é preciso mandar o novo para <%= gFirst %>."><%- csrfP %><button class="link small" type="submit">novo link</button></form>
            <form method="post" action="/convidados/<%= guest.id %>/portal" class="inline" data-confirm="Desativar o portal? O link deixa de abrir (dá para ativar de novo depois)."><%- csrfP %><input type="hidden" name="on" value="0"><button class="link small danger-link" type="submit">desativar</button></form>
          </div>
          <% } %>
        </section>

        <section class="card">
          <h2>Episódio em collab no YouTube</h2>
          <% if (pg.portal_yt_done_at) { %>
          <p><span class="badge b-gray">feita</span> <% if (PT.ytUrl) { %><a class="mono small" href="<%= PT.ytUrl %>" target="_blank" rel="noopener"><%= pg.portal_yt_channel %></a><% } %></p>
          <p class="small muted">No portal, o episódio aparece como collab também no YouTube.</p>
          <% if (canW) { %><form method="post" action="/convidados/<%= guest.id %>/portal/youtube" class="inline"><%- csrfP %><input type="hidden" name="feito" value="0"><button class="link small" type="submit">desmarcar</button></form><% } %>
          <% } else if (pg.portal_yt_requested_at) { %>
          <p class="notice"><%= gFirst %> pediu em <span class="mono"><%= fmt.formatDay(pg.portal_yt_requested_at).slice(0, 5) %></span> para o episódio sair em collab com o canal <a class="mono" href="<%= PT.ytUrl %>" target="_blank" rel="noopener"><%= pg.portal_yt_channel %></a>. Faça o convite no YouTube Studio e marque aqui.</p>
          <% if (canW) { %><form method="post" action="/convidados/<%= guest.id %>/portal/youtube" class="inline"><%- csrfP %><input type="hidden" name="feito" value="1"><button class="btn sm" type="submit"><%- icon('check', 14) %> Marcar como feita</button></form><% } %>
          <% } else { %>
          <p class="small muted">Pelo portal, <%= gFirst %> pode pedir que o episódio apareça também no canal dele no YouTube, antes ou depois de sair. O pedido chega como aviso.</p>
          <% if (canW) { %><form method="post" action="/convidados/<%= guest.id %>/portal/youtube" class="inline"><%- csrfP %><input type="hidden" name="feito" value="1"><button class="link small" type="submit">já fizemos a collab</button></form><% } %>
          <% } %>
        </section>
      </div>

      <section class="card">
        <h2>No portal agora</h2>
        <% if (!pc.handle) { %><p class="notice small">Sem @ do Instagram no cadastro: o sistema não tem como reconhecer os posts em collab.</p><% } %>
        <dl class="kv">
          <dt>Em collab</dt><dd class="mono"><%= pc.collab.length %> post<%= pc.collab.length === 1 ? '' : 's' %></dd>
          <dt>Outros posts</dt><dd class="mono"><%= pc.others.length %></dd>
          <dt>Episódio</dt><dd class="mono"><%= ['YouTube', 'Spotify', 'Instagram'].filter(function (k) { return pc.episode[k.toLowerCase()]; }).join(' · ') || 'links ainda não saíram' %></dd>
          <dt>Fotos</dt><dd><span class="mono"><%= pc.photos.length %> de <%= pc.photoChoices.length %></span><% if (canW && pc.photoChoices.length) { %> <button class="link small" type="button" data-modal-open="modal-portal-fotos">escolher</button><% } else if (!pc.photoChoices.length) { %> <span class="small muted">sem fotos no material do episódio</span><% } %></dd>
        </dl>
        <h3 class="top-gap">Cortes exclusivos <span class="mono small muted"><%= pc.exclusive.length %><%= pc.exclusiveOpen ? ' · à mostra' : (pg.exclusive_from ? ' · aparecem ' + PT.dayLabel(pg.exclusive_from) : '') %></span></h3>
        <% if (!pc.exclusive.length && !pc.clipsOut.length) { %><p class="small muted">Todo corte do episódio que não for publicado entra aqui como exclusivo de <%= gFirst %>.</p><% } %>
        <ul class="plain portal-clips">
          <% pc.exclusive.forEach(function (x) { %>
          <li><a href="/cortes/<%= x.id %>"><%= x.post_title || x.title %></a><% if (canW) { %><form method="post" action="/cortes/<%= x.id %>/convidado" class="inline"><%- csrfP %><input type="hidden" name="on" value="0"><input type="hidden" name="voltar" value="/convidados/<%= guest.id %>"><button class="link small" type="submit">tirar</button></form><% } %></li>
          <% }) %>
          <% pc.clipsOut.forEach(function (x) { %>
          <li class="is-off"><a href="/cortes/<%= x.id %>"><%= x.post_title || x.title %></a> <span class="mono small muted">fora do portal</span><% if (canW) { %><form method="post" action="/cortes/<%= x.id %>/convidado" class="inline"><%- csrfP %><input type="hidden" name="on" value="1"><input type="hidden" name="voltar" value="/convidados/<%= guest.id %>"><button class="link small" type="submit">voltar</button></form><% } %></li>
          <% }) %>
        </ul>
      </section>
    </div>

    <dialog class="modal" id="modal-portal-enviar" aria-labelledby="mpe-h">
      <div class="stack">
        <h2 id="mpe-h">Enviar o link do portal</h2>
        <p class="small muted">A mensagem apresenta o portal e explica que ele se atualiza durante a semana.</p>
        <% if (PT.hasEmail) { %><form method="post" action="/convidados/<%= guest.id %>/portal/enviar" data-busy="Enviando…"><%- csrfP %><input type="hidden" name="canal" value="email"><button class="btn primary" type="submit"><%- icon('mail') %> Enviar por e-mail</button> <span class="mono small muted"><%= guest.email %></span></form><% } %>
        <% if (PT.hasPhone) { %><form method="post" action="/convidados/<%= guest.id %>/portal/enviar" target="_blank"><%- csrfP %><input type="hidden" name="canal" value="whatsapp"><button class="btn <%= PT.hasEmail ? '' : 'primary' %>" type="submit"><%- icon('message-circle') %> Abrir no WhatsApp</button> <span class="mono small muted"><%= guest.phone %></span></form><% } %>
        <% if (!PT.hasEmail && !PT.hasPhone) { %><p class="notice small">Sem e-mail nem WhatsApp no cadastro. Copie o link e mande por onde vocês conversam.</p><% } %>
        <div class="row modal-actions"><button class="btn ghost" type="button" data-modal-close>Fechar</button></div>
      </div>
    </dialog>
    <% if (canW) { %>
    <dialog class="modal" id="modal-portal-ajustes" aria-labelledby="mpa2-h">
      <form method="post" action="/convidados/<%= guest.id %>/portal/datas" class="stack">
        <%- csrfP %>
        <h2 id="mpa2-h">Cronograma</h2>
        <p class="small muted">Vazio = automático: o episódio sai na data de veiculação, os cortes começam na segunda daquela semana e os exclusivos aparecem com o episódio.</p>
        <label>Cortes em collab começam<input type="date" name="cuts_from" value="<%= pg.cuts_from_set || '' %>"></label>
        <label>Episódio vai ao ar<input type="date" name="release_on" value="<%= pg.release_on_set || '' %>"></label>
        <label>Cortes exclusivos aparecem<input type="date" name="exclusive_from" value="<%= pg.exclusive_from_set || '' %>"></label>
        <div class="row modal-actions"><button class="btn primary" type="submit">Salvar cronograma</button><button class="btn ghost" type="button" data-modal-close>Cancelar</button></div>
      </form>
      <form method="post" action="/convidados/<%= guest.id %>/portal/aviso" class="stack top-gap">
        <%- csrfP %>
        <h2>Aviso de post novo em collab</h2>
        <div class="seg-radio" role="radiogroup" aria-label="Como avisar">
          <% Object.keys(PT.NOTIFY).forEach(function (k) { %><label><input type="radio" name="canal" value="<%= k %>" <%= pg.portal_notify === k ? "checked" : "" %>><%= PT.NOTIFY[k] %></label><% }) %>
        </div>
        <p class="small muted">Automático usa o e-mail; sem e-mail, o WhatsApp. O e-mail sai sozinho. No WhatsApp, a equipe recebe um lembrete e manda pela aba Portal.</p>
        <div class="row modal-actions"><button class="btn" type="submit">Salvar aviso</button></div>
      </form>
    </dialog>
    <% if (pc.photoChoices.length) { %>
    <dialog class="modal modal-wide" id="modal-portal-fotos" aria-labelledby="mpf-h">
      <form method="post" action="/convidados/<%= guest.id %>/portal/fotos" class="stack">
        <%- csrfP %>
        <h2 id="mpf-h">Fotos no portal</h2>
        <p class="small muted">Marque as que <%= gFirst %> pode ver e baixar. Fotografias e bastidores do material do episódio.</p>
        <ul class="plain portal-photo-pick">
          <% pc.photoChoices.forEach(function (f) { %>
          <li><label><input type="checkbox" name="fotos" value="<%= f.id %>" <%= f.for_guest ? 'checked' : '' %>><img src="/episodios/<%= pg.episode_id %>/arquivos/<%= f.id %>/previa" alt="<%= f.filename %>" loading="lazy" width="160" height="120"></label></li>
          <% }) %>
        </ul>
        <div class="row modal-actions"><button class="btn primary" type="submit">Salvar fotos</button><button class="btn ghost" type="button" data-modal-close>Cancelar</button></div>
      </form>
    </dialog>
    <% } %>
    <% } %>
    <% } %>
  </div>
  <% } %>

  <div class="pane" id="pane-historico" data-pane-id="historico">
    <section class="card" id="timeline">
      <h2>Linha do tempo</h2>
      <p class="small muted">Movimentos automáticos (etapas, convite, cliques). Para falar com a equipe, use os comentários.</p>
      <ol class="timeline">
        <% events.forEach(function (e) { %>
        <li class="ev ev-<%= e.type %>">
          <div class="ev-msg"><%= e.message %></div>
          <div class="ev-meta small muted"><%= fmt.formatDateTime(e.created_at) %><%= e.user_name ? ' · ' + e.user_name : '' %></div>
        </li>
        <% }) %>
      </ol>
    </section>
  </div>
</div>

<% if (canW) { %>
<dialog class="modal" id="modal-etapa" aria-labelledby="m-etapa-h">
  <form method="post" action="/convidados/<%= guest.id %>/status" class="stack">
    <%- csrfField %>
    <h2 id="m-etapa-h">Mudar a etapa</h2>
    <p class="small muted">Hoje: <strong><%= statusInfo.label %></strong>. Algumas etapas pedem dados; se faltar algo, abrimos a janela certa.</p>
    <div class="stage-pick" role="radiogroup" aria-label="Nova etapa">
      <% statuses.forEach(function (st) { %>
      <label class="choice"><input type="radio" name="status" value="<%= st.key %>" <%= guest.status === st.key ? 'checked' : '' %> data-current="<%= guest.status === st.key ? '1' : '' %>"><span><strong><%= st.label %></strong><small class="muted"><%= st.hint %></small></span></label>
      <% }) %>
    </div>
    <div class="row modal-actions"><button class="btn primary" type="submit" data-stage-confirm disabled>Confirmar mudança</button><button class="btn ghost" type="button" data-modal-close>Cancelar</button></div>
  </form>
</dialog>
<% } %>

<% if (canW) { %><%- include('../partials/photo-cropper') %><% } %>
<% if (canW) { var photoFor = pendingStage && ['em_agendamento', 'agendado'].indexOf(pendingStage) >= 0 ? pendingStage : null; %>
<dialog class="modal" id="modal-foto" aria-labelledby="m-foto-h" <%= openOnLoad('foto') %> data-image-scope>
  <div class="stack">
    <h2 id="m-foto-h">Foto <%= guest.gender === 'f' ? 'da convidada' : 'do convidado' %></h2>
    <p class="small muted"><%= photoFor ? 'Para ir para ' + statuses.find(function (s) { return s.key === photoFor; }).label + ', envie a foto de ' + fmt.firstName(guest.name) + '. Ela aparece na agenda da plateia e para os patrocinadores.' : 'A foto aparece na agenda da plateia e para os patrocinadores.' %></p>
    <% if (guest.photo_key) { %><img class="guest-photo md" src="/convidados/<%= guest.id %>/foto" alt="Foto atual" width="200" height="150"><% } %>
    <% if (!storageReady) { %><p class="small warn">O armazenamento de arquivos (Backblaze) não está configurado no servidor: não dá para enviar fotos.</p><% } %>
    <p class="small muted">PNG, JPEG ou WebP. Na próxima tela você enquadra a foto na moldura <span class="mono"><%= photoFrame.ratio %></span> (a mesma da plateia, do media kit e do portal).</p>
    <input type="file" accept="image/png,image/jpeg,image/webp" hidden data-image-input data-crop="<%= photoFrame.ratio %>" data-csrf="<%= csrf %>" data-base="/convidados/<%= guest.id %>/foto">
    <% if (photoFor) { %><form method="post" action="/convidados/<%= guest.id %>/avancar" hidden data-after-upload><%- csrfField %><%- hidden('para', photoFor) %></form><% } %>
    <div class="row modal-actions"><button class="btn primary" type="button" data-image-pick="" <%= storageReady ? '' : 'disabled' %>><%- icon('upload', 14) %> <%= guest.photo_key ? 'Trocar foto' : 'Enviar foto' %></button><button class="btn ghost" type="button" data-modal-close>Agora não</button></div>
  </div>
</dialog>

<dialog class="modal" id="modal-perda" aria-labelledby="m-perda-h" <%= openOnLoad('perda') %>>
  <form method="post" action="/convidados/<%= guest.id %>/avancar" class="stack">
    <%- csrfField %><%- hidden('para', 'perdido') %><%- hidden('perda', '1') %>
    <h2 id="m-perda-h">Marcar <%= fmt.firstName(guest.name) %> como perdido</h2>
    <p class="small muted">O motivo fica no histórico e ajuda a entender onde os convites param.</p>
    <div class="stage-pick" role="radiogroup" aria-label="Motivo da perda">
      <% Object.keys(lossReasons).forEach(function (k) { %>
      <label class="choice"><input type="radio" name="loss_reason" value="<%= k %>" required <%= guest.loss_reason === k || (!guest.loss_reason && outreachCtx.sm && outreachCtx.sm.state === 'possivel_perdido' && k === 'nunca_respondeu') ? 'checked' : '' %> data-loss-radio><span><strong><%= lossReasons[k] %></strong></span></label>
      <% }) %>
    </div>
    <label data-loss-note <%= guest.loss_reason === 'outros' ? '' : 'hidden' %>>Qual o motivo?<input type="text" name="loss_note" maxlength="500" value="<%= guest.loss_note || '' %>"></label>
    <div class="row modal-actions"><button class="btn primary" type="submit">Marcar como perdido</button><button class="btn ghost" type="button" data-modal-close>Cancelar</button></div>
  </form>
</dialog>
<% } %>

<% if (canW && guest.status === 'convite_enviado') { %><%- include('../partials/outreach-modal', outreachCtx) %><% } %>

<% if (canEmail) { %>
<dialog class="modal" id="modal-email" aria-labelledby="m-email-h" <%= openOnLoad('email') %>>
  <form method="post" action="/convidados/<%= guest.id %>/enviar" class="stack">
    <%- csrfField %>
    <h2 id="m-email-h"><%= guest.invite_sent_at ? 'Reenviar convite' : 'Enviar convite' %></h2>
    <p class="small muted">Para <strong><%= guest.email %></strong>. O e-mail leva o botão para o convite<%= guest.status === 'prospect' ? '; ao enviar, a etapa vira Convite enviado' : '' %>.</p>
    <label>Assunto<input type="text" name="assunto" maxlength="200" placeholder="(usa o assunto padrão)"></label>
    <label>Mensagem<textarea name="mensagem" rows="7" maxlength="2000"><%= defaultMessage %></textarea></label>
    <div class="row modal-actions"><button class="btn primary" type="submit">Enviar</button><button class="btn ghost" type="button" data-modal-close>Cancelar</button></div>
  </form>
</dialog>
<% } %>

<% if (canW) { %>
<dialog class="modal" id="modal-contato" aria-labelledby="m-contato-h" <%= openOnLoad('contato') %>>
  <form method="post" action="/convidados/<%= guest.id %>/avancar" class="stack">
    <%- csrfField %><%- hidden('para', 'em_agendamento') %>
    <h2 id="m-contato-h">Aceitou o convite</h2>
    <p class="small muted">Para combinar a data, precisamos de pelo menos um contato.</p>
    <div class="grid-2 tight">
      <label>WhatsApp<input type="text" name="phone" value="<%= guest.phone || '' %>" maxlength="40"></label>
      <label>E-mail<input type="email" name="email" value="<%= guest.email || '' %>" maxlength="254"></label>
    </div>
    <div class="row modal-actions"><button class="btn primary" type="submit">Salvar e seguir</button><button class="btn ghost" type="button" data-modal-close>Cancelar</button></div>
  </form>
</dialog>

<dialog class="modal" id="modal-agenda" aria-labelledby="m-agenda-h" <%= openOnLoad('agenda') %>>
  <% var resched = guest.status === 'agendado'; %>
  <form method="post" action="/convidados/<%= guest.id %>/avancar" class="stack">
    <%- csrfField %><%- hidden('para', 'agendado') %><%- hidden('agenda', '1') %>
    <h2 id="m-agenda-h"><%= resched ? 'Remarcar a gravação' : 'Data da gravação' %></h2>
    <p class="small muted"><%= resched ? 'Nova data, nova confirmação: marque de novo quem já confirmou. Sem as três, o convidado volta para Em agendamento.' : 'Com as três confirmações o convidado vai para Agendado e o episódio entra na produção. Sem elas, a data fica salva como proposta.' %></p>
    <label>Data e hora<input type="datetime-local" name="proposed_at" value="<%= fmt.toInputValue(guest.proposed_at) %>" required></label>
    <fieldset class="stack confirm-list">
      <legend>Data acertada com</legend>
      <label class="check"><input type="checkbox" name="scheduled_studio" value="1" <%= !resched && guest.scheduled_studio ? 'checked' : '' %>> Estúdio</label>
      <label class="check"><input type="checkbox" name="scheduled_hosts" value="1" <%= !resched && guest.scheduled_hosts ? 'checked' : '' %>> Hosts</label>
      <label class="check"><input type="checkbox" name="scheduled_guest" value="1" <%= !resched && guest.scheduled_guest ? 'checked' : '' %>> <%= guest.gender === 'f' ? 'Convidada' : 'Convidado' %></label>
    </fieldset>
    <div class="row modal-actions"><button class="btn primary" type="submit">Salvar agenda</button><button class="btn ghost" type="button" data-modal-close>Cancelar</button></div>
  </form>
</dialog>

<% } %>
<% if (canW) { %><script src="/static/cropper.js?v=<%= assetV %>" defer></script><% } %>
<%- include('../partials/foot') %>
