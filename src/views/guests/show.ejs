<%- include('../partials/head') %>
<div class="page-head">
  <div>
    <h1><%= guest.name %> <span class="badge b-st-<%= guest.status %>"><%= statusInfo.label %></span></h1>
    <p class="muted"><%= [guest.job_title, guest.company].filter(Boolean).join(' · ') %></p>
  </div>
  <div class="row">
    <a class="btn" href="/convidados">← Voltar</a>
    <% if (can('guests.write')) { %><a class="btn" href="/convidados/<%= guest.id %>/editar">Editar</a><% } %>
    <% if (can('guests.delete')) { %>
    <form method="post" action="/convidados/<%= guest.id %>/excluir" class="inline" data-confirm="Excluir <%= guest.name %> e todo o histórico? Esta ação não pode ser desfeita.">
      <input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn danger" type="submit">Excluir</button>
    </form>
    <% } %>
  </div>
</div>

<div class="grid-2 align-start">
  <div class="stack-lg">
    <section class="card">
      <h2>Dados</h2>
      <dl class="kv">
        <dt>E-mail</dt><dd><%= guest.email || '—' %></dd>
        <dt>Tratamento</dt><dd><%= guest.is_plural ? 'Dupla · ' : '' %><%= guest.gender === 'f' ? 'Feminino' : 'Masculino' %></dd>
        <dt>WhatsApp</dt><dd><%= guest.phone || '—' %></dd>
        <dt>Instagram</dt><dd><%= guest.instagram ? '@' + guest.instagram : '—' %></dd>
        <dt>Tema</dt><dd><%= guest.topic || '—' %></dd>
        <dt>Gravação</dt><dd><%= guest.proposed_at ? fmt.formatLong(guest.proposed_at) : '—' %></dd>
        <dt>Responsável</dt><dd><%= guest.owner_name || '—' %></dd>
        <% if (guest.bio) { %><dt>Bio</dt><dd class="pre"><%= guest.bio %></dd><% } %>
        <% if (guest.notes) { %><dt>Observações</dt><dd class="pre"><%= guest.notes %></dd><% } %>
        <% if (guest.rsvp_message) { %><dt>Recado do convidado</dt><dd class="pre">“<%= guest.rsvp_message %>”</dd><% } %>
      </dl>
      <% if (can('guests.write')) { %>
      <form method="post" action="/convidados/<%= guest.id %>/status" class="row top-gap">
        <input type="hidden" name="_csrf" value="<%= csrf %>">
        <select name="status">
          <% statuses.forEach(function (s) { %><option value="<%= s.key %>" <%= guest.status === s.key ? 'selected' : '' %>><%= s.label %></option><% }) %>
        </select>
        <button class="btn" type="submit">Mover de etapa</button>
      </form>
      <% } %>
    </section>

    <section class="card" id="timeline">
      <h2>Linha do tempo</h2>
      <% if (can('guests.write')) { %>
      <form method="post" action="/convidados/<%= guest.id %>/nota" class="row">
        <input type="hidden" name="_csrf" value="<%= csrf %>">
        <input type="text" name="nota" maxlength="1000" placeholder="Anotar contato, ligação, combinado…" class="grow">
        <button class="btn" type="submit">Anotar</button>
      </form>
      <% } %>
      <ol class="timeline">
        <% events.forEach(function (e) { %>
        <li class="ev ev-<%= e.type %>">
          <div class="ev-msg"><%= e.message %></div>
          <div class="ev-meta small muted"><%= fmt.formatDateTime(e.created_at) %><%= e.user_name ? ' · ' + e.user_name : '' %></div>
        </li>
        <% }) %>
      </ol>
    </section>
  </div>

  <section class="card" id="convite">
    <h2>Convite</h2>
    <% if (!guest.invite_token) { %>
      <p class="muted">Ainda não há link. Ao gerar, criamos uma página exclusiva do convite com os dados deste convidado<%= yourlsReady ? ' e um link curto' : '' %>.</p>
      <% if (can('guests.invite')) { %>
      <form method="post" action="/convidados/<%= guest.id %>/convite">
        <input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn primary" type="submit">🔗 Gerar link do convite</button>
      </form>
      <% } %>
    <% } else { %>
      <label class="copy-field">Link curto (para enviar)
        <div class="row">
          <input type="text" readonly value="<%= guest.short_url || longUrl %>" class="grow" data-select-on-focus>
          <button class="btn" type="button" data-copy="<%= guest.short_url || longUrl %>">Copiar</button>
        </div>
      </label>
      <% if (!guest.short_url) { %>
        <p class="small muted">Sem link curto (encurtador indisponível). Este é o link completo.
          <% if (can('guests.invite') && yourlsReady) { %>
          <form method="post" action="/convidados/<%= guest.id %>/convite" class="inline"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="link" type="submit">Tentar encurtar de novo</button></form>
          <% } %></p>
      <% } else { %>
        <p class="small muted">Link completo: <a href="<%= longUrl %>" target="_blank" rel="noopener"><%= longUrl %></a></p>
      <% } %>
      <ul class="plain small">
        <li>Gerado: <%= fmt.formatDateTime(guest.invite_generated_at) %></li>
        <li>Enviado por e-mail: <%= guest.invite_sent_at ? fmt.formatDateTime(guest.invite_sent_at) : 'ainda não' %></li>
        <li>Aberto pelo convidado: <%= guest.invite_viewed_at ? fmt.formatDateTime(guest.invite_viewed_at) : 'ainda não' %></li>
        <li>Resposta: <%= guest.responded_at ? fmt.formatDateTime(guest.responded_at) + ' — ' + (guest.status === 'confirmado' ? 'aceitou' : guest.status === 'recusou' ? 'recusou' : 'respondeu') : 'sem resposta' %></li>
      </ul>
      <div class="row">
        <a class="btn" href="/convidados/<%= guest.id %>/previa" target="_blank" rel="noopener">👁️ Ver convite</a>
        <% if (can('guests.invite')) { %>
        <form method="post" action="/convidados/<%= guest.id %>/convite" class="inline" data-confirm="Gerar um novo link? O link atual deixará de funcionar.">
          <input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="regenerar" value="1"><button class="btn" type="submit">Gerar novo link</button>
        </form>
        <% } %>
      </div>

      <% if (can('guests.invite')) { %>
      <hr>
      <h3>Enviar por e-mail</h3>
      <% if (!guest.email) { %>
        <p class="muted small">Cadastre o e-mail do convidado (em Editar) para enviar por aqui. Você também pode copiar o link e mandar pelo WhatsApp.</p>
      <% } else if (!mailReady) { %>
        <p class="muted small">SMTP não configurado neste servidor.</p>
      <% } else { %>
      <form method="post" action="/convidados/<%= guest.id %>/enviar" class="stack">
        <input type="hidden" name="_csrf" value="<%= csrf %>">
        <p class="small muted">Para: <strong><%= guest.email %></strong></p>
        <label>Assunto<input type="text" name="assunto" maxlength="200" placeholder="(usa o assunto do modelo)"></label>
        <label>Mensagem<textarea name="mensagem" rows="7" maxlength="2000"><%= defaultMessage %></textarea></label>
        <button class="btn primary" type="submit"><%= guest.invite_sent_at ? 'Reenviar convite' : 'Enviar convite' %></button>
      </form>
      <% } %>
      <% } %>
    <% } %>
  </section>
</div>
<%- include('../partials/foot') %>
