<%- include('partials/head') %>
<header class="hello">
  <span class="kicker"><%= fmt.todayLabel() %> · <%= podcastName %></span>
  <h1><%= fmt.greeting() %>, <%= currentUser.name.split(' ')[0] %>.</h1>
  <% if (can('guests.read')) { %>
    <p class="voz"><%= myOpen ? 'Você tem ' + myOpen + (myOpen === 1 ? ' convidado seu aguardando' : ' convidados seus aguardando') + ' convite ou resposta.' : 'Nenhum convidado seu aguardando convite ou resposta.' %></p>
  <% } else { %>
    <p class="voz">Bem-vindo(a) à gestão do <%= podcastName %>.</p>
  <% } %>
</header>

<% if (can('guests.read')) { %>
<section class="stat-grid" aria-label="Convidados por etapa">
  <% cards.forEach(function (c) { %>
    <a class="stat" href="/convidados?view=lista&status=<%= c.key %>">
      <span class="stat-label"><%= c.label %></span>
      <span class="stat-n <%= c.key === 'confirmado' && c.n ? 'hl' : '' %>"><%= c.n %></span>
    </a>
  <% }) %>
</section>

<div class="grid-2 tight">
  <section class="card">
    <h2>Próximas gravações</h2>
    <% if (!upcoming.length) { %>
      <div class="empty">
        <%- include('partials/pulse-line') %>
        <strong>Nenhuma gravação marcada</strong>
        <span>Confirme um convidado com data futura e ele aparece aqui.</span>
      </div>
    <% } %>
    <ul class="plain upcoming">
      <% upcoming.forEach(function (g) { %>
        <li>
          <span class="date-block"><span class="m"><%= fmt.monthShort(g.proposed_at) %></span><span class="d"><%= fmt.dayNum(g.proposed_at) %></span></span>
          <span>
            <a href="/convidados/<%= g.id %>"><strong><%= g.name %></strong></a><br>
            <span class="mono muted"><%= fmt.formatDateTime(g.proposed_at).slice(-5) %><%= g.topic ? ' · ' + g.topic : '' %></span>
          </span>
        </li>
      <% }) %>
    </ul>
  </section>

  <section class="card">
    <h2>Atividade recente</h2>
    <% if (!recent.length) { %>
      <div class="empty">
        <%- include('partials/pulse-line') %>
        <strong>Sem atividade ainda</strong>
        <span>Cadastros, convites e respostas aparecem aqui.</span>
      </div>
    <% } %>
    <ul class="plain feed">
      <% recent.forEach(function (e) { %>
        <li>
          <span><a href="/convidados/<%= e.guest_id %>"><strong><%= e.guest_name %></strong></a> <span class="muted">— <%= e.message %></span></span>
          <span class="mono muted"><%= fmt.formatDateTime(e.created_at) %><%= e.user_name ? ' · ' + e.user_name : '' %></span>
        </li>
      <% }) %>
    </ul>
  </section>
</div>
<% } %>
<%- include('partials/foot') %>
