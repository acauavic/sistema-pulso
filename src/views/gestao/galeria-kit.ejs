<%- include('../partials/head') %>
<%
  var csrfField = '<input type="hidden" name="_csrf" value="' + csrf + '">';
  var chosen = rows.filter(function (r) { return r.kit_featured && r.guest_id; }).length;
%>
<div class="page-head"><div><span class="kicker">Gestão · Convites e parcerias</span><h1>Galeria do media kit</h1></div></div>
<%- include('../partials/gestao-nav', { active: 'galeria' }) %>
<p class="lead">Escolha quais episódios gravados, publicados ou ainda em produção, aparecem em "Quem já sentou à mesa", no media kit dos patrocinadores e no convite dos convidados. Os dois mostram um convidado em destaque, trocando sozinho, e todos os escolhidos numa grade de fotos quadradas; no convite, quem tem cortes ganha "Ver cortes".</p>
<% var picked = clipChoices.filter(function (c) { return c.invite_pick_at; }); %>
<section class="card" id="cortes-convite">
  <div class="row spread"><h2>Cortes de exemplo no convite <span class="mono muted small"><%= picked.length %>/<%= maxPicks %></span></h2><% if (clipChoices.length) { %><button class="btn sm" type="button" data-modal-open="modal-cortes-convite"><%- icon('pencil', 14) %> Escolher cortes</button><% } %></div>
  <% if (picked.length) { %>
  <ul class="plain pick-grid top-gap">
    <% picked.forEach(function (c) { %><li><figure class="pick"><img src="/capas/<%= c.cover_id %>/imagem?w=640" alt="Capa de <%= c.shown_title %>" loading="lazy" width="108" height="192"><span class="small"><%= c.shown_title %></span><span class="mono small muted"><%= c.ep_number ? 'EP.' + String(c.ep_number).padStart(3, '0') : '' %> · <%= c.guest_name || '' %></span></figure></li><% }) %>
  </ul>
  <% } else { %>
  <p class="small muted">Nenhum escolhido: o convite mostra o corte publicado mais recente de cada episódio (só os que têm capa). Escolha até <%= maxPicks %> para mostrar os que mais representam o Pulso.</p>
  <% } %>
</section>
<dialog class="modal modal-wide" id="modal-cortes-convite" aria-labelledby="mcc-h">
  <form method="post" action="/gestao/galeria-kit/cortes" class="stack"><%- csrfField %>
    <h2 id="mcc-h">Cortes de exemplo no convite</h2>
    <p class="small muted">Marque até <%= maxPicks %>. Só aparecem cortes com capa (a capa é o que a pessoa vê antes de tocar). Os publicados nas redes vêm marcados com "no ar".</p>
    <% if (clipChoices.length > 12) { %><div class="row list-filter"><input type="search" placeholder="Buscar pelo título, convidado ou EP" aria-label="Buscar corte" data-list-filter="#kit-picks" autocomplete="off"><span class="mono small muted list-filter-count" data-list-filter-count></span></div><% } %>
    <ul class="plain pick-grid" id="kit-picks">
      <% clipChoices.forEach(function (c) { %>
      <li><label class="pick"><input type="checkbox" name="cortes" value="<%= c.id %>" <%= c.invite_pick_at ? 'checked' : '' %>><img src="/capas/<%= c.cover_id %>/imagem?w=640" alt="" loading="lazy" width="108" height="192"><span class="small"><%= c.shown_title %></span><span class="mono small muted"><%= c.ep_number ? 'EP.' + String(c.ep_number).padStart(3, '0') : '' %><%= c.posted ? ' · no ar' : '' %></span></label></li>
      <% }) %>
    </ul>
    <div class="row modal-actions"><button class="btn primary" type="submit">Salvar escolha</button><button class="btn ghost" type="button" data-modal-close>Cancelar</button></div>
  </form>
</dialog>

<% if (!rows.length) { %>
<div class="empty">
  <%- include('../partials/signal') %>
  <h2>Nenhum episódio gravado ainda</h2>
  <p>Assim que a primeira gravação virar episódio, ela aparece aqui para você escolher. Até lá, o media kit mostra a galeria padrão de lançamento.</p>
</div>
<% } else { %>
<p class="small muted"><span class="mono"><%= chosen %></span> de <span class="mono"><%= rows.length %></span> no media kit.<% if (!chosen) { %> Enquanto você não escolher nenhum, o kit mostra a galeria padrão de lançamento.<% } %></p>
<div class="table-wrap">
  <table>
    <thead><tr><th>Convidado</th><th>Episódio</th><th class="num">Alcance</th><th>No kit</th><th></th></tr></thead>
    <tbody>
    <% rows.forEach(function (r) { var cred = kit.credentialOf(r); var usable = Boolean(r.guest_id); %>
      <tr>
        <td>
          <div class="kit-who">
            <% if (r.has_photo) { %><img class="guest-photo" src="<%= photoUrl(r.guest_id) %>" alt="" width="64" height="48" loading="lazy"><% } else { %><span class="kit-nophoto" aria-hidden="true"><%- icon('user', 16) %></span><% } %>
            <div><strong><%= r.guest_name || 'Sem convidado ligado' %></strong><% if (r.instagram) { %><br><span class="small muted handle">@<%= String(r.instagram).replace(/^@/, '') %></span><% } %></div>
          </div>
        </td>
        <td><span class="mono small muted"><%= r.number ? 'EP.' + String(r.number).padStart(3, '0') : 'EP' %></span> <span class="badge b-st-<%= r.status %>"><%= statuses[r.status] %></span><br><%= r.title %></td>
        <td class="num mono"><%= r.kit_audience || '—' %></td>
        <td>
          <% if (!usable) { %><span class="small muted">precisa de convidado</span>
          <% } else { %>
          <form method="post" action="/gestao/galeria-kit/<%= r.id %>/mostrar" class="inline"><%- csrfField %>
            <input type="hidden" name="mostrar" value="<%= r.kit_featured ? '0' : '1' %>">
            <% if (r.kit_featured) { %><button class="btn sm" type="submit" title="Tirar do media kit"><span class="badge b-green">no kit</span> Tirar</button>
            <% } else { %><button class="btn sm" type="submit">Mostrar no kit</button><% } %>
          </form>
          <% } %>
        </td>
        <td><% if (usable) { %><button class="icon-btn" type="button" data-modal-open="m-ep-<%= r.id %>" aria-label="Editar texto de <%= r.guest_name %>" title="Editar texto"><%- icon('pencil', 14) %></button><% } %></td>
      </tr>
    <% }) %>
    </tbody>
  </table>
</div>

<% rows.forEach(function (r) { if (!r.guest_id) return; %>
<dialog class="modal" id="m-ep-<%= r.id %>" aria-labelledby="m-ep-<%= r.id %>-h" <%= openId === r.id ? 'data-open-on-load' : '' %>>
  <form method="post" action="/gestao/galeria-kit/<%= r.id %>" class="stack"><%- csrfField %>
    <h2 id="m-ep-<%= r.id %>-h"><%= r.guest_name %></h2>
    <label>Alcance
      <input type="text" name="audience" maxlength="20" value="<%= r.kit_audience || '' %>" placeholder="+3,6M">
    </label>
    <p class="small muted">Seguidores somados, como quer que apareça. Em branco, o kit mostra um traço.</p>
    <label>Frase de apresentação
      <textarea name="credential" rows="3" maxlength="200" placeholder="<%= kit.credentialOf(Object.assign({}, r, { kit_credential: null })) %>"><%= r.kit_credential || '' %></textarea>
    </label>
    <p class="small muted">Duas linhas no máximo. Em branco, usa o cargo e a empresa do cadastro do convidado.</p>
    <div class="row modal-actions"><button class="btn primary" type="submit">Salvar</button><button class="btn ghost" type="button" data-modal-close>Cancelar</button></div>
  </form>
</dialog>
<% }) %>
<% } %>
<%- include('../partials/foot') %>
