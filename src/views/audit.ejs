<%- include('partials/head') %>
<div class="page-head"><div><span class="kicker">Gestão · Registro</span><h1>Logs</h1></div></div>
<%- include('partials/gestao-nav', { active: 'logs' }) %>
<p class="lead">Auditoria: as últimas 300 ações registradas no sistema (quem, o quê, quando e de onde).</p>
<div class="table-wrap">
<table>
  <thead><tr><th>Quando</th><th>Quem</th><th>Ação</th><th>Alvo</th><th>Detalhes</th><th>IP</th></tr></thead>
  <tbody>
    <% rows.forEach(function (r) { %>
    <tr>
      <td class="nowrap mono"><%= fmt.formatDateTime(r.created_at) %></td>
      <td><%= r.user_email || '—' %></td>
      <td><code><%= r.action %></code></td>
      <td><%= r.entity ? r.entity + (r.entity_id ? ' #' + String(r.entity_id).slice(0, 8) : '') : '—' %></td>
      <td class="small"><%= r.meta ? JSON.stringify(r.meta) : '' %></td>
      <td class="small"><%= r.ip || '' %></td>
    </tr>
    <% }) %>
  </tbody>
</table>
</div>
<%- include('partials/foot') %>
