<%- include('partials/head') %>
<div class="card <%= currentUser ? '' : 'auth-card' %>">
  <h1 class="mb-12"><%= title %></h1>
  <p class="muted"><%= message %></p>
  <div class="row mt-20">
    <button class="btn" type="button" data-go-back><%- typeof icon === 'function' ? icon('arrow-left') : '' %> Voltar</button>
    <a class="btn ghost" href="<%= currentUser ? '/' : '/login' %>"><%= currentUser ? 'Ir para o início' : 'Ir para o login' %></a>
  </div>
</div>
<%- include('partials/foot') %>
