<%- include('../partials/head') %>
<%- include('../partials/social-nav') %>
<%
  var badge = { revisao: 'b-amber', recusado: 'b-red', publicado: 'b-st-publicado', parcial: 'b-amber', agendado: 'b-st-agendado', erro: 'b-red', simulado: 'b-gray', enviando: 'b-amber' };
  var link = function (s, m) { var p = []; if (s) p.push('status=' + s); if (m) p.push('tipo=' + m); if (q) p.push('q=' + encodeURIComponent(q)); return '/social/publicacoes' + (p.length ? '?' + p.join('&') : ''); };
  var total = Object.keys(counts).reduce(function (n, k) { return n + counts[k]; }, 0);
%>
<div class="toolbar" data-list-memory="Publicações">
  <div class="seg" role="group" aria-label="Status">
    <a href="<%= link('', media) %>" class="<%= !status ? 'on' : '' %>">Todas <span class="mono"><%= total %></span></a>
    <% ['revisao', 'recusado', 'agendado', 'publicado', 'erro', 'simulado'].forEach(function (s) { if (!counts[s] && status !== s) return; %>
    <a href="<%= link(s, media) %>" class="<%= status === s ? 'on' : '' %>"><%= statusLabel[s] %> <span class="mono"><%= counts[s] || 0 %></span></a>
    <% }) %>
  </div>
</div>
<form method="get" action="/social/publicacoes" class="filters">
  <% if (status) { %><input type="hidden" name="status" value="<%= status %>"><% } %>
  <input type="search" name="q" value="<%= q %>" placeholder="Buscar pelo título, legenda, corte ou EP" aria-label="Buscar publicação" enterkeyhint="search">
  <select name="tipo" aria-label="Tipo" data-autosubmit>
    <option value="">Todos os tipos</option>
    <% Object.keys(MEDIA).forEach(function (m) { %><option value="<%= m %>" <%= media === m ? 'selected' : '' %>><%= MEDIA[m] %></option><% }) %>
  </select>
  <% if (q || media) { %><a class="link small" href="<%= status ? '/social/publicacoes?status=' + status : '/social/publicacoes' %>">Limpar</a><% } %>
</form>
<% if (counts.revisao && can('social.publish') && status !== 'revisao') { %><p class="flash flash-ok"><a href="/social/publicacoes?status=revisao"><strong class="mono"><%= counts.revisao %></strong> post<%= counts.revisao > 1 ? 's esperam' : ' espera' %> a sua aprovação.</a></p><% } %>

<% if (!pubs.length) { %>
<% if (q || media || status) { %>
<div class="empty card"><%- include('../partials/signal') %><p><strong>Nada com esse filtro.</strong></p><p class="muted small">Tente outra palavra ou <a href="/social/publicacoes">veja todas as publicações</a>.</p></div>
<% } else { %>
<div class="empty card"><%- include('../partials/signal') %><p><strong>Nada por aqui ainda.</strong></p><p class="muted small">Os cortes, posts, carrosséis e stories publicados ou agendados aparecem nesta lista.<% if (can('social.request')) { %> Comece em <a href="/social/novo">Novo post</a>.<% } %></p></div>
<% } %>
<% } else { %>
<div class="table-wrap">
  <table>
    <thead><tr><th>Quando</th><th>Tipo</th><th>Publicação</th><th>Redes</th><th>Status</th></tr></thead>
    <tbody>
      <% pubs.forEach(function (p) { %>
      <tr>
        <td class="mono nowrap"><%= p.scheduled_at && p.status === 'agendado' ? fmt.formatDateTime(p.scheduled_at) : fmt.formatDateTime(p.created_at) %></td>
        <td><span class="badge b-gray"><%= MEDIA[p.media] %></span></td>
        <td><a href="/social/publicacoes/<%= p.id %>"><strong><%= p.title %></strong></a><div class="small muted"><%= p.episode_id ? (p.episode_number ? 'EP.' + String(p.episode_number).padStart(3, '0') + ' · ' : '') + p.episode_title : 'Conteúdo avulso' %></div></td>
        <td class="small"><%= p.platforms.map(function (k) { return platforms[k] ? platforms[k].label : k; }).join(', ') %><% if (p.options && p.options.instagram && p.options.instagram.trial && p.platforms.indexOf('instagram') >= 0) { %> <span class="badge b-trial" title="Instagram como Reel de teste: aparece primeiro só para quem não segue">Reel de teste</span><% } %></td>
        <td><% if (p.retry_at) { %><span class="badge b-amber">Nova tentativa</span> <span class="mono small muted"><%= fmt.formatSoon(p.retry_at) %></span><% } else { %><span class="badge <%= badge[p.status] %>"><%= statusLabel[p.status] %></span><% } %></td>
      </tr>
      <% }) %>
    </tbody>
  </table>
</div>
<%- include('../partials/pager', { pager }) %>
<% } %>
<%- include('../partials/foot') %>
