<%- include('../partials/head') %>
<%- include('../partials/social-nav') %>
<%
  var csrfField = '<input type="hidden" name="_csrf" value="' + csrf + '">';
  var epNo = function (n) { return n ? 'EP.' + String(n).padStart(3, '0') : 'EP.—'; };
  var kindTag = { corte: 'CORTE', story: 'STORY', carrossel: 'CARROSSEL' }; // chip neutro (colchetes são para temas)
  var statusLabel = { sugerida: 'Sugeridas', aprovada: 'Aprovadas', feita: 'Feitas', descartada: 'Descartadas' };
  var groups = []; ideas.forEach(function (i) { var g = groups[groups.length - 1]; if (!g || g.id !== i.episode_id) groups.push(g = { id: i.episode_id, label: epNo(i.episode_number) + ' · ' + i.episode_title, items: [] }); g.items.push(i); });
  var act = function (i, acao, label, tone, confirm) { return '<form method="post" action="/social/ideias/' + i.id + '/' + acao + '" class="inline"' + (confirm ? ' data-confirm="' + confirm + '"' : '') + '>' + csrfField + '<button class="btn sm ' + (tone || '') + '" type="submit">' + label + '</button></form>'; };
%>
<%# Jornada: quem cuida das redes abre Ideias para ver o que a IA sugeriu e decidir (aprovar vira tarefa). Pedir mais ideias é
    eventual: botão + janela (antes, o formulário com 30 episódios ficava sempre aberto ao lado). %>
<div class="toolbar">
  <div class="seg" role="group" aria-label="Status das ideias">
    <% Object.keys(statusLabel).forEach(function (s) { %><a href="/social/ideias?status=<%= s %>" class="<%= status === s ? 'on' : '' %>"><%= statusLabel[s] %> <span class="mono"><%= counts[s] || 0 %></span></a><% }) %>
  </div>
  <% if (canIdeas) { %><button class="btn primary" type="button" data-modal-open="modal-ideias" <%= aiReady ? '' : 'disabled' %>><%- icon('sparkles') %> Pedir ideias</button><% } %>
</div>
<% if (!aiReady) { %><p class="flash flash-error">IA (Gemini) não configurada neste servidor.</p><% } %>
<% if (running) { %><p class="notice small"><%- icon('clock', 14) %> Um pedido de ideias está na fila. Você recebe uma notificação quando terminar.</p><% } %>

<% if (canIdeas) { var withText = episodes.filter(function (e) { return e.has_text; }); var noText = episodes.filter(function (e) { return !e.has_text; }); %>
<dialog class="modal modal-wide" id="modal-ideias" aria-labelledby="mid-h">
  <form method="post" action="/social/ideias/gerar" class="stack" data-check-all-scope data-busy="Gerando ideias…">
    <%- csrfField %>
    <h2 id="mid-h">Pedir ideias à IA</h2>
    <p class="small muted">A IA lê a conversa do episódio e sugere cortes, stories e carrosséis. Ela recebe a lista do que já foi feito ou sugerido e não repete.</p>
    <fieldset class="row wrap">
      <legend>O que sugerir</legend>
      <% Object.keys(kinds).forEach(function (k) { %><label class="check"><input type="checkbox" name="kinds" value="<%= k %>" checked> <%= kinds[k] %></label><% }) %>
    </fieldset>
    <fieldset>
      <legend>Episódios <span class="mono small muted"><%= withText.length %></span></legend>
      <% if (withText.length > 1) { %><label class="check"><input type="checkbox" data-check-all> Todos os que têm transcrição</label><% } %>
      <div class="check-list">
        <% withText.forEach(function (e) { %>
        <label class="check"><input type="checkbox" name="episodes" value="<%= e.id %>" data-check-item> <span class="mono"><%= epNo(e.number) %></span> <%= e.guest_name || e.title %><% if (e.ideas) { %> <span class="small muted">· <%= fmt.plural(e.ideas, 'ideia', 'ideias') %> já</span><% } %></label>
        <% }) %>
        <% if (!withText.length) { %><p class="muted small">Nenhum episódio com transcrição ainda. A transcrição sai na finalização do episódio.</p><% } %>
      </div>
      <% if (noText.length) { %><details class="top-gap"><summary class="small muted">Sem transcrição ainda <span class="mono"><%= noText.length %></span></summary><p class="small muted"><%= noText.map(function (e) { return epNo(e.number) + ' ' + (e.guest_name || e.title); }).join(' · ') %></p></details><% } %>
    </fieldset>
    <div class="row modal-actions"><button class="btn primary" type="submit"><%- icon('sparkles') %> Sugerir ideias</button><button class="btn ghost" type="button" data-modal-close>Cancelar</button></div>
  </form>
</dialog>
<% } %>

  <section class="ideas-list">
    <% if (!ideas.length) { %>
      <div class="empty card top-gap"><%- include('../partials/pulse-line') %><p><strong><%= status === 'sugerida' ? 'Nenhuma ideia esperando.' : 'Nada aqui.' %></strong></p><p class="muted small"><%= status === 'sugerida' ? 'Use “Pedir ideias” e escolha os episódios: a IA sugere cortes, stories e carrosséis.' : 'As ideias mudam de lista quando alguém aprova, marca como feita ou descarta.' %></p></div>
    <% } %>
    <% groups.forEach(function (g) { %>
      <h3 class="idea-ep kicker"><a href="/episodios/<%= g.id %>"><%= g.label %></a></h3>
      <div class="idea-list">
        <% g.items.forEach(function (i) { var b = i.body || {}; %>
        <article class="card idea">
          <span class="badge b-gray"><%= kindTag[i.kind] %></span>
          <h3><%= i.title %></h3>
          <% if (i.hook) { %><p class="small"><span class="muted">Gancho:</span> <%= i.hook %></p><% } %>
          <% if (b.frase) { %><p class="voz">&ldquo;<%= b.frase %>&rdquo;</p><% } %>
          <% if (b.inicio_seg != null) { %><p class="mono small">TRECHO <%= fmt.formatClock(b.inicio_seg * 1000) %> – <%= b.fim_seg != null ? fmt.formatClock(b.fim_seg * 1000) : '?' %></p><% } %>
          <% if ((b.slides || []).length) { %><ol class="small"><% b.slides.forEach(function (s) { %><li><%= s %></li><% }) %></ol><% } %>
          <% if (b.legenda) { %><p class="small muted pre"><%= b.legenda %></p><% } %>
          <% if (canIdeas) { %>
          <div class="row">
            <% if (i.status === 'sugerida') { %><%- act(i, 'aprovar', 'Aprovar e virar tarefa', '') %><%- act(i, 'feita', 'Já fizemos', 'ghost') %><%- act(i, 'descartar', 'Descartar', 'ghost') %>
            <% } else if (i.status === 'aprovada') { %><% if (i.task_id) { %><a class="btn sm" href="/tarefas/<%= i.task_id %>">Ver tarefa</a><% } %><%- act(i, 'feita', 'Marcar como feita', '') %>
            <% } else { %><%- act(i, 'reabrir', 'Reabrir', 'ghost') %><% } %>
          </div>
          <% } %>
        </article>
        <% }) %>
      </div>
    <% }) %>
  </section>
<script src="/static/social.js?v=<%= assetV %>" defer></script>
<%- include('../partials/foot') %>
