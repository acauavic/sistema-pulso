<%- include('../partials/head') %>
<%- include('../partials/social-nav') %>
<%
  var items = tipo === 'video' ? clips : tipo === 'imagem' ? images.posts : tipo === 'story' ? images.stories : images.carousels;
  var allowed = tipo === 'video' ? Object.keys(platforms).filter(function (k) { return platforms[k].clip; }) : (tipo === 'story' ? ['instagram'] : photoPlatforms);
  var preset = tipo === 'video' ? defaults.clip : ['instagram'];
  var hasConn = Object.keys(connected).length > 0;
  var epLabel = function (x) { return x.episode_id ? (x.episode_number ? 'EP.' + String(x.episode_number).padStart(3, '0') + ' · ' : '') + (x.episode_title || '') : 'Avulso'; };
  var dur = function (ms) { return ms ? Math.round(ms / 1000) + 's' : ''; };
  var fresh = function (list) { return list.filter(function (x) { return !x.pub; }).length; };
  var day = function (d) { return d ? new Intl.DateTimeFormat('pt-BR', { timeZone: 'America/Sao_Paulo', day: '2-digit', month: '2-digit' }).format(new Date(d)) : ''; };
  var usedChip = function (x) { if (!x.pub) return x.sugerido ? '<span class="badge b-gray">sugerido</span>' : ''; return '<span class="badge ' + (x.pub.stage === 'publicado' ? 'b-green' : 'b-st-agendado') + '">' + x.pub.label + '</span><span class="handle muted">' + x.pub.platforms.join(' · ') + (x.pub.at ? ' · ' + day(x.pub.at) : '') + '</span>'; };
  var withUsed = function (t) { return '/social/novo?tipo=' + t + (showUsed ? '&publicados=1' : ''); };
  var emptyText = { video: 'Todos os cortes prontos já foram publicados ou agendados. Envie novos em Conteúdo.', imagem: 'Nenhum post de imagem para postar. Os posts de frase saem da finalização do episódio; um post sob medida é um pedido em Conteúdo.', carrossel: 'Nenhum carrossel para postar. Gere na finalização do episódio ou peça em Conteúdo.', story: 'Nenhum story pronto. Story é pedido em Conteúdo (capas de corte e thumbnails não entram aqui).' };
%>
<div class="toolbar">
  <div class="seg" role="group" aria-label="Tipo de post">
    <% [['video', 'Corte', fresh(clips)], ['imagem', 'Post', fresh(images.posts)], ['carrossel', 'Carrossel', fresh(images.carousels)], ['story', 'Story', fresh(images.stories)]].forEach(function (t) { %>
    <a href="<%= withUsed(t[0]) %>" class="<%= tipo === t[0] ? 'on' : '' %>"><%= t[1] %> <span class="mono"><%= t[2] %></span></a>
    <% }) %>
  </div>
  <a class="link small" href="/social/novo?tipo=<%= tipo %><%= showUsed ? '' : '&publicados=1' %>"><%= showUsed ? 'Esconder os já publicados' : 'Ver também os já publicados' %></a>
</div>

<% var storyPosts = tipo === 'story' ? images.storyPosts : []; %>
<% if (!items.length && !storyPosts.length) { %>
<div class="empty card"><%- include('../partials/pulse-line') %><p><strong>Nada para postar aqui.</strong></p><p class="muted small"><%= emptyText[tipo] %></p><% if (tipo !== 'video') { %><p><a class="btn sm" href="/conteudo?pedir=<%= tipo === 'imagem' ? 'post' : tipo %>"><%- icon('plus', 14) %> Pedir ao editor</a></p><% } %></div>
<% } else { %>
<form method="post" action="/social/publicar" class="stack-lg" data-compose>
  <input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="tipo" value="<%= tipo %>">
  <section>
    <p class="small muted"><%= showUsed ? 'Mostrando também o que já saiu (marcado). Postar de novo é possível, mas confira se faz sentido.' : 'Só aparece o que ainda não foi publicado nem agendado. Os sugeridos vêm primeiro: do episódio que foi ao ar mais recentemente.' %> Escolha <%= tipo === 'carrossel' ? 'um carrossel' : 'um item' %>.</p>
    <div class="pick-grid">
      <% if (tipo === 'video') { clips.forEach(function (c) { %>
      <label class="pick <%= c.pub ? 'used' : '' %>">
        <input type="radio" name="clip_id" value="<%= c.id %>" data-episode="<%= c.episode_id || '' %>" required <%= String(pick) === String(c.id) ? 'checked' : '' %> data-title="<%= c.post_title || c.title %>" data-caption="<%= c.caption || '' %>">
        <% if (c.cover_id) { %><img src="/capas/<%= c.cover_id %>/imagem" alt="" loading="lazy"><% } else { %><span class="ph"><%- icon('film', 20) %></span><% } %>
        <strong><%= c.post_title || c.title %></strong>
        <span class="small muted"><%= c.request_id && !c.episode_id ? 'Avulso · ' + (requestKinds[c.request_kind] ? requestKinds[c.request_kind].label : 'pedido') : epLabel(c) %><%= c.duration_ms ? ' · ' + dur(c.duration_ms) : '' %></span>
        <span class="row small"><%- usedChip(c) %><% if (c.tested && !c.pub) { %><span class="badge b-gray">só testado</span><% } %></span>
      </label>
      <% }); } else if (tipo === 'carrossel') { images.carousels.forEach(function (g) { %>
      <label class="pick <%= g.pub ? 'used' : '' %>">
        <input type="radio" name="cover_ids" value="<%= g.slides.map(function (s) { return s.id; }).join(',') %>" data-episode="<%= g.episode_id || (g.slides[0] && g.slides[0].episode_id) || '' %>" required <%= String(pick) === g.slides.map(function (s) { return s.id; }).join(',') ? 'checked' : '' %> data-title="<%= g.label || 'Carrossel' %>">
        <span class="slides"><% g.slides.slice(0, 3).forEach(function (s) { %><img src="/capas/<%= s.id %>/imagem" alt="" loading="lazy"><% }) %></span>
        <strong><%= g.label || 'Carrossel' %></strong>
        <span class="small muted"><%= epLabel(g) %> · <span class="mono"><%= g.slides.length %></span> slides</span>
        <span class="row small"><%- usedChip(g) %></span>
      </label>
      <% }); } else { items.forEach(function (c) { %>
      <label class="pick <%= c.pub ? 'used' : '' %>">
        <input type="radio" name="cover_ids" value="<%= c.id %>" data-episode="<%= c.episode_id || '' %>" required <%= String(pick) === String(c.id) ? 'checked' : '' %> data-title="<%= c.label || (tipo === 'story' ? 'Story' : 'Post') %>">
        <img class="<%= tipo === 'imagem' ? 'sq' : '' %>" src="/capas/<%= c.id %>/imagem" alt="" loading="lazy">
        <strong><%= c.label || (c.kind === 'post_quote' ? 'Frase' : c.kind === 'post_split' ? 'Tela dividida' : tipo === 'story' ? 'Story' : 'Post') %></strong>
        <span class="small muted"><%= epLabel(c) %></span>
        <span class="row small"><%- usedChip(c) %></span>
      </label>
      <% }); } %>
    </div>
    <% if (storyPosts.length) { %>
    <details class="top-gap"<%= items.length ? '' : ' open' %>>
      <summary>Usar um post 4:5 como story <span class="mono muted"><%= storyPosts.length %></span></summary>
      <p class="small muted">O Instagram coloca o post no meio da tela, com faixas em cima e embaixo.</p>
      <div class="pick-grid">
        <% storyPosts.forEach(function (c) { %>
        <label class="pick">
          <input type="radio" name="cover_ids" value="<%= c.id %>" data-episode="<%= c.episode_id || '' %>" required data-title="<%= c.label || 'Story' %>">
          <img class="sq" src="/capas/<%= c.id %>/imagem" alt="" loading="lazy">
          <strong><%= c.label || (c.kind === 'post_split' ? 'Tela dividida' : 'Frase') %></strong>
          <span class="small muted"><%= epLabel(c) %></span>
        </label>
        <% }) %>
      </div>
    </details>
    <% } %>
  </section>

  <% if (canPublish) { %>
  <section class="card stack">
    <h2>Onde e quando</h2>
    <fieldset class="row wrap">
      <legend>Redes</legend>
      <% allowed.forEach(function (k) { var on = hasConn ? Boolean(connected[k]) && preset.indexOf(k) >= 0 : preset.indexOf(k) >= 0; %>
      <label class="check"><input type="checkbox" name="platforms" value="<%= k %>" <%= on ? 'checked' : '' %>> <%= tipo === 'video' && platforms[k].clipLabel ? platforms[k].clipLabel : platforms[k].label %><% if (hasConn && !connected[k]) { %> <span class="small muted">(não conectada)</span><% } %></label>
      <% }) %>
    </fieldset>
    <% if (tipo !== 'story') { %>
    <%- include('../partials/ig-people', { episodeId: null, photo: tipo !== 'video' }) %>
    <label><%= tipo === 'video' ? 'Título' : 'Título interno' %><input type="text" name="title" maxlength="300" data-fill="title" data-ai="titulo" data-ai-scope="form"></label>
    <label>Legenda<textarea name="description" rows="6" maxlength="5000" data-fill="caption" data-ai="descricao" data-ai-scope="form"></textarea></label>
    <% } else { %><input type="hidden" name="title" value="Story" data-fill="title"><% } %>
    <label>Agendar <small class="muted">(vazio = <%= direct ? 'publicar agora' : 'publicar assim que a gestão aprovar' %>)</small><input type="datetime-local" name="agendar"></label>
    <% if (direct) { %>
    <label class="check"><input type="checkbox" name="confirmar" value="1" required> Entendi que isto publica nas redes escolhidas</label>
    <div><button class="btn primary" type="submit"><%- icon('send') %> Publicar</button></div>
    <% } else { %>
    <p class="small muted">O post vai para a revisão da gestão antes de sair. Você recebe um aviso quando ele for aprovado ou devolvido.</p>
    <div><button class="btn primary" type="submit"><%- icon('send') %> Enviar para revisão</button></div>
    <% } %>
  </section>
  <% } else { %>
  <p class="muted small">Seu perfil não monta posts.</p>
  <% } %>
</form>
<% } %>
<script src="/static/social.js?v=<%= assetV %>" defer></script>
<%- include('../partials/ai-assist') %>
<%- include('../partials/foot') %>
