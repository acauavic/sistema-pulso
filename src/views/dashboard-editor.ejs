<%- include('partials/head') %>
<%
  var epNo = function (e) { return e.number ? 'EP.' + String(e.number).padStart(3, '0') : 'Episódio'; };
  var inEdit = mine.filter(function (e) { return e.status === 'em_edicao'; }).length;
  var inReview = mine.filter(function (e) { return e.status === 'em_revisao'; }).length;
%>
<header class="hello">
  <span class="kicker"><%= fmt.todayLabel() %> · <%= podcastName %></span>
  <h1><%= fmt.greeting() %>, <%= currentUser.name.split(' ')[0] %>.</h1>
  <p class="voz"><%= adjustCount ? adjustCount + (adjustCount === 1 ? ' episódio seu tem' : ' episódios seus têm') + ' ajustes pedidos.' : (queue.length ? queue.length + (queue.length === 1 ? ' episódio espera' : ' episódios esperam') + ' na fila de edição.' : 'Nada na fila de edição agora.') %></p>
</header>
<%- include('partials/app-card') %>

<section class="stat-grid" aria-label="Produção">
  <a class="stat" href="/episodios?view=lista"><span class="stat-label">Na fila</span><span class="stat-n <%= queue.length ? 'hl' : '' %>"><%= queue.length %></span></a>
  <a class="stat" href="/episodios?view=lista&editor=eu"><span class="stat-label">Em edição</span><span class="stat-n"><%= inEdit %></span></a>
  <a class="stat" href="/episodios?view=lista&editor=eu"><span class="stat-label">Ajustes pedidos</span><span class="stat-n <%= adjustCount ? 'hl-bad' : '' %>"><%= adjustCount %></span></a>
  <a class="stat" href="/episodios?view=lista&editor=eu"><span class="stat-label">Em revisão</span><span class="stat-n"><%= inReview %></span></a>
</section>

<div class="grid-2 tight">
  <section class="card">
    <h2>Fila de edição</h2>
    <% if (!queue.length) { %>
      <div class="empty"><%- include('partials/pulse-line') %><strong>Fila vazia</strong><span>Quando um episódio for liberado para edição, ele aparece aqui e você recebe um aviso.</span></div>
    <% } else { %>
    <ul class="plain today-list two-col">
      <% queue.forEach(function (e) { %>
      <li><span><a href="/episodios/<%= e.id %>"><strong><%= epNo(e) %> · <%= e.title %></strong></a><% if (e.recorded_on) { %><br><span class="mono small muted">GRAVADO <%= fmt.shortDate(e.recorded_on).toUpperCase() %></span><% } %></span><span class="badge b-st-disponivel_edicao">disponível</span></li>
      <% }) %>
    </ul>
    <% } %>
  </section>

  <section class="card">
    <h2>Meus episódios</h2>
    <% if (!mine.length) { %>
      <div class="empty"><%- include('partials/pulse-line') %><strong>Nenhum episódio com você</strong><span>Abra um da fila e use "Assumir a edição".</span></div>
    <% } else { %>
    <ul class="plain today-list two-col">
      <% mine.forEach(function (e) { %>
      <li><span><a href="/episodios/<%= e.id %>"><strong><%= epNo(e) %> · <%= e.title %></strong></a><% if (e.review_round) { %><br><span class="mono small muted"><%= e.review_round %>ª REVISÃO</span><% } %></span>
        <% if (e.status === 'em_edicao' && e.review_round > 0) { %><span class="badge b-red">ajustes pedidos</span><% } else { %><span class="badge b-st-<%= e.status %>"><%= EPISODE_STATUSES[e.status] %></span><% } %></li>
      <% }) %>
    </ul>
    <% } %>
  </section>
</div>

<section class="card top-gap">
  <div class="today-head"><h2>Pedidos de conteúdo</h2><a class="small" href="/conteudo?vista=pedidos">Ver todos</a></div>
  <% if (!requests.length) { %><p class="small muted">Nenhum pedido com você. Trailers, vídeos avulsos e posts pedidos pela gestão aparecem aqui.</p><% } else { %>
  <ul class="plain today-list two-col">
    <% requests.forEach(function (r) { var iso = r.due_on ? new Date(r.due_on).toISOString().slice(0, 10) : ''; var late = iso && iso < today; %>
    <li><span><a href="/conteudo/pedidos/<%= r.id %>"><strong><%= r.title %></strong></a><br><span class="mono small <%= late ? 'err' : 'muted' %>"><%= requestKinds[r.kind].label.toUpperCase() %> · <%= iso ? 'ATÉ ' + iso.slice(8, 10) + '/' + iso.slice(5, 7) : 'SEM PRAZO' %></span></span>
      <% if (r.status === 'producao' && r.rounds) { %><span class="badge b-red">ajustes pedidos</span><% } else { %><span class="badge <%= { pedido: 'b-st-prospect', producao: 'b-st-em_edicao', revisao: 'b-st-em_revisao' }[r.status] %>"><%= r.status === 'pedido' ? (r.assignee_id ? 'para começar' : 'livre') : r.status === 'producao' ? 'em produção' : 'em revisão' %></span><% } %></li>
    <% }) %>
  </ul>
  <% } %>
</section>

<section class="card top-gap">
  <div class="today-head"><h2>Minhas tarefas</h2><a class="small" href="/tarefas">Ver todas</a></div>
  <% if (!tasks.length) { %><p class="small muted">Nenhuma tarefa aberta com você.</p><% } else { %>
  <ul class="plain today-list two-col">
    <% tasks.forEach(function (t) { %>
    <li><span><a href="/tarefas/<%= t.id %>"><strong><%= t.title %></strong></a><br><span class="mono small <%= t.late ? 'err' : 'muted' %>"><%= t.due_on ? 'ATÉ ' + fmt.shortDate(fmt.toInputDate(t.due_on) + 'T12:00:00').toUpperCase() + (t.due_time ? ' · ' + fmt.formatTime(t.due_time) : '') : 'SEM PRAZO' %></span></span><span class="badge b-gray"><%= t.status === 'fazendo' ? 'fazendo' : (t.status === 'bloqueada' ? 'bloqueada' : 'a fazer') %></span></li>
    <% }) %>
  </ul>
  <% } %>
</section>
<%- include('partials/foot') %>
