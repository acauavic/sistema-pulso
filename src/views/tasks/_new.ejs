<%# Janela "Nova tarefa". Variáveis: users, episodes, guests, sponsors, prefill, back %>
<dialog class="modal modal-wide" id="modal-task-new" aria-labelledby="nt-h" <%= openNew ? 'data-open-on-load' : '' %>>
  <form method="post" action="/tarefas" class="stack">
    <input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="voltar" value="<%= back %>">
    <h2 id="nt-h">Nova tarefa</h2>
    <%- include('../partials/project-field', { general: true, hint: 'Tarefa ligada a um episódio, convidado ou patrocinador fica no projeto dele.' }) %>
    <% if (voiceReady) { %>
    <div class="voice-bar" data-voice data-url="/tarefas/voz">
      <button class="btn sm" type="button" data-voice-btn><span data-voice-ic="mic"><%- icon('mic', 16) %></span><span data-voice-ic="stop" hidden><%- icon('square', 14) %></span> <span data-voice-label>Falar a tarefa</span></button>
      <span class="small muted" data-voice-status>Diga o que precisa ser feito, para quem e até quando. A IA organiza nos campos abaixo.</span>
    </div>
    <details class="small" data-voice-heard hidden><summary>O que eu ouvi</summary><p class="muted" data-voice-text></p></details>
    <% } %>
    <% if (locals.taskOn) { %>
    <%# Vindo de Mensagens ("Criar tarefa" na mensagem): a IA lê a mensagem (ou a thread) e preenche; tarefa-msg.js %>
    <input type="hidden" name="source_message_id" value="" data-tf-source><input type="hidden" name="source_scope" value="" data-tf-scope-input>
    <div class="voice-bar tf-bar" data-task-from hidden>
      <div class="seg" role="group" aria-label="O que a IA lê" data-tf-seg hidden><button type="button" data-tf-scope="mensagem">Esta mensagem</button><button type="button" data-tf-scope="thread">A thread inteira</button></div>
      <span class="small muted" data-tf-status role="status"></span>
    </div>
    <% } %>
    <label>O que fazer<input type="text" name="title" maxlength="200" required placeholder="Ex.: confirmar a pauta com o convidado"></label>
    <div class="field"><span class="field-label">Detalhes <small class="muted">(opcional)</small></span>
      <%- include('../partials/rich-editor', { name: 'description_html', attach: 'attachment_ids', placeholder: 'Descreva a tarefa. Cole imagens com Ctrl+V, anexe PDF, HTML ou ZIP, monte tabelas…', label: 'Detalhes da tarefa', size: 'sm' }) %>
    </div>
    <div class="form-grid form-grid-4">
      <label>Responsável<select name="assignee_id"><option value="">— ninguém —</option><% users.forEach(function (u) { %><option value="<%= u.id %>" <%= u.id === currentUser.id ? 'selected' : '' %>><%= u.name %></option><% }) %></select></label>
      <label>Vence em<input type="date" name="due_on"></label>
      <label>Hora<input type="time" name="due_time" title="Sem data, a hora vale para hoje"></label>
      <label>Categoria<select name="kind"><% Object.keys(C.TASK_KINDS).filter(function (k) { return !C.TASK_KINDS_OFF || !C.TASK_KINDS_OFF.has(k); }).forEach(function (k) { %><option value="<%= k %>"><%= C.TASK_KINDS[k] %></option><% }) %></select></label>
    </div>
    <label class="task-repeat">Repetir
      <select name="repete" data-native>
        <option value="">Não repete</option>
        <option value="dia_util">Todo dia útil</option>
        <option value="semana">Toda semana, no mesmo dia</option>
        <option value="mes">Todo mês, no mesmo dia</option>
      </select>
    </label>
    <details <%= prefill.episode_id || prefill.guest_id || prefill.sponsor_id ? 'open' : '' %>>
      <summary>Ligar a um episódio, convidado ou patrocinador</summary>
      <div class="form-grid form-grid-3 top-gap">
        <label>Episódio<select name="episode_id"><option value="">Nenhum</option><% episodes.forEach(function (e) { %><option value="<%= e.id %>" <%= String(prefill.episode_id) === String(e.id) ? 'selected' : '' %>><%= e.number ? 'EP.' + String(e.number).padStart(3, '0') + ' · ' : '' %><%= e.title %></option><% }) %></select></label>
        <label>Convidado<select name="guest_id"><option value="">Nenhum</option><% guests.forEach(function (g) { %><option value="<%= g.id %>" <%= String(prefill.guest_id) === String(g.id) ? 'selected' : '' %>><%= g.name %></option><% }) %></select></label>
        <label>Patrocinador<select name="sponsor_id"><option value="">Nenhum</option><% sponsors.forEach(function (s) { %><option value="<%= s.id %>" <%= String(prefill.sponsor_id) === String(s.id) ? 'selected' : '' %>><%= s.company %></option><% }) %></select></label>
      </div>
    </details>
    <div class="row modal-actions"><button class="btn primary" type="submit">Criar tarefa</button><button class="btn ghost" type="button" data-modal-close>Cancelar</button></div>
  </form>
</dialog>
