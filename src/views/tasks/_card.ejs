<%# Cartão de tarefa (quadro e calendário). Variáveis: t, compact %>
<% var due = isoOf(t.due_on); var late = due && due < today && t.status !== 'feito'; var edit = canEdit(t); %>
<article class="task-card st-<%= t.status %> <%= late ? 'late' : '' %> <%= t.status === 'bloqueada' ? 'is-blocked' : '' %>" data-task="<%= t.id %>" draggable="<%= edit ? 'true' : 'false' %>">
  <div class="tc-top">
    <a href="/tarefas/<%= t.id %>" class="tc-title"><%= t.title %></a>
    <%- include('../partials/dot', { type: 'task', id: t.id, user: t.assignee_id ? { id: t.assignee_id, name: t.assignee_name } : null, editable: edit }) %>
  </div>
  <p class="small err" data-reason <%= t.status === 'bloqueada' ? '' : 'hidden' %>><%= t.status === 'bloqueada' ? 'Bloqueada: ' + t.block_reason : '' %></p>
  <div class="tc-meta handle">
    <% if (due) { %><span class="<%= late ? 'err' : '' %>"><%- icon('clock', 12) %> <%= fmt.formatDayShort(t.due_on) %><%= late ? ' · atrasada' : '' %></span><% } %>
    <% if (t.episode_id) { %><span><%= t.episode_number ? 'EP.' + String(t.episode_number).padStart(3, '0') : 'Episódio' %></span><% } %>
    <% if (t.guest_id) { %><span><%= t.guest_name %></span><% } %>
    <% if (t.sponsor_id) { %><span><%= t.sponsor_name %></span><% } %>
    <% if (t.comments) { %><span><%- icon('message-square', 12) %> <%= t.comments %></span><% } %>
  </div>
</article>
