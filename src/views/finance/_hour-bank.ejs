<%# Banco de horas do estúdio (topo do Financeiro, só com o banco ligado). Variáveis: bank (hourBank.status()), hourBank, today. %>
<%
  var H = hourBank.fmtHours;
  var neg = hourBank.isOut(bank); // zerado ou negativo: acabou
  var barClass = neg ? 'is-neg' : (bank.low ? 'is-low' : '');
  var bar = neg ? 100 : (bank.purchasedHours > 0 ? Math.max(0, Math.min(100, Math.round(bank.availableHours / bank.purchasedHours * 100))) : 0);
  var bankCsrf = '<input type="hidden" name="_csrf" value="' + csrf + '">';
  // cota é orçamento por projeto: só aparece para quem vê mais de um
  var multiProj = (bank.byProject || []).length > 1;
  var overQuota = (bank.byProject || []).filter(function (l) { return l.over > 0; });
  // a janela abre na compra mais recente, com as cotas dela
  var lastQuota = (bank.lastPack && bank.quotas && bank.quotas.byPack[bank.lastPack.id]) || {};
%>
<% if (bank.low) { %>
<div class="notice<%= neg ? ' notice-bad' : '' %>" role="status"><%= hourBank.alertText(bank) %> <a href="#banco-de-horas">Ver o banco</a></div>
<% } %>
<section class="card bank-card" id="banco-de-horas" aria-labelledby="bank-h">
  <div class="row spread">
    <h2 id="bank-h">Banco de horas do estúdio</h2>
    <% if (can('finance.write')) { %>
    <span class="row tight">
      <button class="btn" type="button" data-modal-open="modal-banco-compra"><%- icon('plus') %> Registrar compra</button>
      <% if (multiProj && bank.lastPack) { %><button class="btn ghost" type="button" data-modal-open="modal-banco-cotas">Ajustar cotas</button><% } %>
    </span>
    <% } %>
  </div>
  <div class="bank-n"><span class="stat-n<%= neg ? ' hl-bad' : '' %>"><%= H(bank.availableHours) %></span> <span class="mono muted">de <%= H(bank.purchasedHours) %></span></div>
  <svg class="goal-bar bank-bar <%= barClass %>" viewBox="0 0 100 6" preserveAspectRatio="none" role="img" aria-label="<%= H(bank.availableHours) %> disponíveis de <%= H(bank.purchasedHours) %>"><rect class="bg" width="100" height="6" rx="3"/><rect class="fg" width="<%= bar %>" height="6" rx="3"/></svg>
  <p class="mono small muted bank-line">USADAS <%= H(bank.usedHours).toUpperCase() %> · RESERVADAS <%= H(bank.reservedHours).toUpperCase() %></p>
  <% if (multiProj) { %>
  <ul class="plain bank-projects">
    <% bank.byProject.forEach(function (l) { %>
    <li>
      <span><%= l.project.name %></span>
      <span class="mono small <%= l.over > 0 ? 'err' : 'muted' %>"><%= H(l.used) %> de <%= H(l.quota) %><%= l.reserved ? ' · ' + H(l.reserved) + ' reservadas' : '' %></span>
    </li>
    <% }) %>
  </ul>
  <% if (overQuota.length) { %>
  <p class="notice" role="status"><%= overQuota.map(function (l) { return l.project.name + ' passou ' + H(l.over) + ' da cota'; }).join(' · ') %>. A cota é orçamento: a despesa segue o uso.</p>
  <% } %>
  <% } %>
  <details class="more">
    <summary>Ver uso</summary>
    <div class="bank-use top-gap">
      <div>
        <h3 class="kicker">Usadas · gravações</h3>
        <% if (!bank.used.length) { %><p class="small muted">Nenhuma gravação no banco ainda.</p><% } %>
        <ul class="plain plan-list">
          <% bank.used.slice().reverse().forEach(function (u) { %>
          <li><span class="mono small"><%= fmt.formatDay(u.day) %></span><div class="plan-list-main"><a href="/episodios/<%= u.id %>#financeiro"><%= u.number ? prefixOf(u.project_id) + String(u.number).padStart(3, '0') + ' · ' : '' %><%= u.guest_name || u.title %></a></div><span class="mono small"><%= u.minutes %> min</span></li>
          <% }) %>
        </ul>
      </div>
      <div>
        <h3 class="kicker">Reservadas · gravações marcadas</h3>
        <% if (!bank.reserved.length) { %><p class="small muted">Nenhuma gravação marcada.</p><% } %>
        <ul class="plain plan-list">
          <% bank.reserved.forEach(function (g) { %>
          <li><span class="mono small"><%= g.proposed_on ? fmt.formatDay(g.proposed_on) : 'a definir' %></span><div class="plan-list-main"><a href="/convidados/<%= g.id %>"><%= g.name %></a></div><span class="mono small"><%= g.minutes %> min</span></li>
          <% }) %>
        </ul>
      </div>
      <div>
        <h3 class="kicker">Compras</h3>
        <ul class="plain plan-list">
          <% bank.packs.slice().reverse().forEach(function (p) { %>
          <li><span class="mono small"><%= fmt.formatDay(p.bought_on) %></span><div class="plan-list-main"><span><%= H(p.hours) %></span><% if (p.note) { %><span class="small muted"><%= p.note %></span><% } %></div><span class="mono small"><%= money(p.amount_cents) %></span></li>
          <% }) %>
        </ul>
      </div>
    </div>
  </details>
</section>

<% if (can('finance.write')) { %>
<dialog class="modal" id="modal-banco-compra" aria-labelledby="mbc-h">
  <form method="post" action="/financeiro/banco/compras" class="stack" data-busy="Registrando…">
    <%- bankCsrf %>
    <h2 id="mbc-h">Registrar compra de horas</h2>
    <p class="small muted">A compra entra como despesa paga de estúdio e as horas somam no banco. Se faltou hora, a compra cobre isso primeiro.</p>
    <div class="grid-3 tight">
      <label>Data *<input type="date" name="bought_on" value="<%= today %>" required></label>
      <label>Horas *<input type="text" name="hours" inputmode="decimal" required placeholder="ex.: 20"></label>
      <label>Valor (R$) *<input type="text" name="amount" inputmode="decimal" required placeholder="ex.: 5.000,00"></label>
    </div>
    <label>Observação<input type="text" name="note" maxlength="300" placeholder="ex.: renovação de dezembro"></label>
    <% if (multiProj) { %>
    <details class="more">
      <summary>Cota por projeto</summary>
      <div class="stack top-gap">
        <div class="grid-2 tight">
          <% bank.byProject.forEach(function (l) { %>
          <label><%= l.project.name %> (horas)<input type="text" name="cota_<%= l.project.id %>" inputmode="decimal" placeholder="ex.: 10"></label>
          <% }) %>
        </div>
        <p class="small muted">Em branco, a cota segue a proporção da compra anterior. Cota é orçamento e aviso: a despesa é dividida pelo uso.</p>
      </div>
    </details>
    <% } %>
    <div class="row modal-actions"><button class="btn primary" type="submit">Registrar compra</button><button class="btn ghost" type="button" data-modal-close>Cancelar</button></div>
  </form>
</dialog>

<% if (multiProj && bank.lastPack) { %>
<dialog class="modal" id="modal-banco-cotas" aria-labelledby="mbq-h">
  <form method="post" action="/financeiro/banco/cotas" class="stack">
    <%- bankCsrf %>
    <h2 id="mbq-h">Ajustar cotas</h2>
    <p class="small muted">Quantas horas da compra cada projeto pode usar. É orçamento e aviso: não muda dinheiro, porque a despesa é dividida pelo uso.</p>
    <label>Compra
      <select name="pack_id">
        <% bank.packs.slice().reverse().forEach(function (p) { %>
        <option value="<%= p.id %>"><%= fmt.formatDay(p.bought_on) %> · <%= H(p.hours) %><%= p.note ? ' · ' + p.note : '' %></option>
        <% }) %>
      </select>
    </label>
    <div class="grid-2 tight">
      <% bank.byProject.forEach(function (l) { %>
      <label><%= l.project.name %> (horas)<input type="text" name="cota_<%= l.project.id %>" inputmode="decimal" value="<%= lastQuota[l.project.id] ? String(lastQuota[l.project.id]).replace('.', ',') : '' %>" placeholder="ex.: 10"></label>
      <% }) %>
    </div>
    <div class="row modal-actions"><button class="btn primary" type="submit">Salvar cotas</button><button class="btn ghost" type="button" data-modal-close>Cancelar</button></div>
  </form>
</dialog>
<% } %>
<% } %>
