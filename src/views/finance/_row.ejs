<%# Uma linha de lançamento. Variáveis: e (lançamento), here (para voltar), history (bool). %>
<%
  var late = e.status === 'previsto' && e.due_on < today;
  var isIn = e.direction === 'entrada';
  var eJson = function (o) { return JSON.stringify(o).replace(/&/g, '&amp;').replace(/"/g, '&quot;').replace(/'/g, '&#39;').replace(/</g, '\\u003c'); };
  var brl = function (c) { return (Number(c) / 100).toFixed(2).replace('.', ','); };
  // de quem é: a sigla do projeto, ou o compartilhado (a divisão em "todos", a parte do projeto no recorte de um)
  var sp = (typeof splits !== 'undefined' && splits && splits[e.id]) || [];
  var tag = e.shared ? '' : (typeof projectTag === 'function' ? projectTag(e.project_id) : '');
  var sharedNote = '';
  if (e.shared) {
    if (projectScope.current || !sp.length) sharedNote = 'compartilhado · parte deste projeto';
    else sharedNote = 'compartilhado · ' + sp.map(function (s) { return Math.round(s.amount_cents / e.amount_cents * 100) + '%'; }).join('/');
  }
  var links = [];
  if (e.episode_id) links.push('<a href="/episodios/' + e.episode_id + '#financeiro">' + (e.episode_number ? prefixOf(e.project_id) + String(e.episode_number).padStart(3, '0') : 'Episódio') + '</a>');
  else if (e.guest_name) links.push('<a href="/convidados/' + e.guest_id + '">' + fmt.escHtml(e.guest_name) + '</a>');
  if (e.sponsor_id && e.sponsor_name) links.push('<a href="/patrocinadores/' + e.sponsor_id + '#financeiro">' + fmt.escHtml(e.sponsor_name) + '</a>');
%>
<li class="fin-row<%= e.status === 'cancelado' ? ' is-off' : '' %>">
  <div class="plan-list-main">
    <strong><%= e.description %></strong>
    <span class="small muted"><%= C.FIN_CATEGORIES[e.category] || e.category %><%= e.supplier ? ' · ' + e.supplier : '' %><% if (links.length) { %> · <%- links.join(' · ') %><% } %><%= e.auto_key ? ' · automático' : '' %><% if (tag) { %> · <span class="mono project-tag">[ <%= tag %> ]</span><% } %><% if (sharedNote) { %> · <%= sharedNote %><% } %><% if (e.account === 'parceiro') { %> · <span class="mono"><%= isIn ? 'recebido por' : 'pago por' %> <%= e.account_person || 'parceiro' %></span><% } %></span>
  </div>
  <span class="fin-when mono small <%= late ? 'err' : 'muted' %>">
    <% if (e.status === 'pago') { %><%= fmt.formatDayShort(e.paid_on) %> · <%= isIn ? 'recebido' : 'pago' %><% } else if (e.status === 'cancelado') { %>cancelado<% } else { %><%= fmt.formatDayShort(e.due_on) %><%= late ? ' · atrasado' : '' %><% } %>
  </span>
  <span class="fin-amt mono" <% if (e.shared && e.share_cents !== e.amount_cents) { %>title="Valor cheio: <%= money(e.amount_cents) %>"<% } %>><%= isIn ? '+' : '−' %> <%= money(e.share_cents) %></span>
  <span class="plan-list-tools">
    <%# comprovantes: o clipe aparece quando há algum, ou no lançamento já pago (onde não há mais a janela de pagar) %>
    <% var rc = (typeof receipts !== 'undefined' && receipts && receipts[e.id]) || [];
       if (rc.length || (typeof receipts !== 'undefined' && e.status === 'pago' && can('finance.write'))) { %>
    <details class="row-menu receipt-menu">
      <summary class="btn sm ghost" aria-label="Comprovantes de <%= e.description %>" title="Comprovantes"><%- icon('paperclip', 14) %><% if (rc.length) { %> <span class="mono"><%= rc.length %></span><% } %></summary>
      <div class="row-menu-list">
        <% rc.forEach(function (a) { %>
        <div class="receipt-row">
          <a href="/anexos/<%= a.id %>" target="_blank" rel="noopener"><%= a.filename %></a>
          <span class="mono small muted"><%= a.purpose === 'pagamento' ? 'PAGAMENTO' : 'CONTA' %></span>
          <% if (can('finance.write')) { %><form method="post" action="/financeiro/lancamentos/<%= e.id %>/comprovantes/<%= a.id %>/excluir" class="inline" data-confirm="Tirar este comprovante do lançamento?"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="voltar" value="<%= here %>"><button class="icon-btn row-del" type="submit" aria-label="Tirar <%= a.filename %>"><%- icon('trash-2', 14) %></button></form><% } %>
        </div>
        <% }) %>
        <% if (can('finance.write')) { %>
        <form method="post" action="/financeiro/lancamentos/<%= e.id %>/comprovantes" data-receipt-box>
          <input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="voltar" value="<%= here %>">
          <label class="link receipt-add"><%- icon('plus', 14) %> Anexar comprovante<input type="file" class="sr-only" data-receipt data-receipt-submit accept="application/pdf,image/png,image/jpeg,image/webp" multiple></label>
          <p class="small muted m-0" data-receipt-msg aria-live="polite"></p>
        </form>
        <% } %>
      </div>
    </details>
    <% } %>
    <% if (can('finance.write')) { %>
      <% if (e.status === 'previsto') { %>
        <button class="btn sm" type="button" data-fill-modal="modal-pagar" data-fill-mode="<%= e.direction %>" data-fill-action="/financeiro/lancamentos/<%= e.id %>/pagar" data-fill='<%- eJson({ _label: e.description, amount: brl(e.amount_cents), paid_on: today, voltar: here }) %>'><%= isIn ? 'Receber' : 'Pagar' %></button>
        <button class="btn sm ghost" type="button" aria-label="Editar <%= e.description %>" data-fill-modal="modal-lanc" data-fill-mode="edit" data-fill-action="/financeiro/lancamentos/<%= e.id %>"
          <% if (!e.auto_key) { %>data-fill-remove="/financeiro/lancamentos/<%= e.id %>/excluir" data-fill-remove-label="Excluir lançamento" data-fill-confirm="Excluir este lançamento?"<% } else { %>data-fill-remove="/financeiro/lancamentos/<%= e.id %>/cancelar" data-fill-remove-label="Anular este custo" data-fill-confirm="Anular este custo automático? Ele sai das contas e não volta sozinho."<% } %>
          data-fill='<%- eJson({ description: e.description, amount: brl(e.amount_cents), due_on: e.due_on, category: e.category, supplier: e.supplier || '', notes: e.notes || '', episode_id: e.episode_id ? String(e.episode_id) : '', sponsor_id: e.sponsor_id ? String(e.sponsor_id) : '', de_quem: e.shared ? 'compartilhado' : String(e.project_id || ''), pago_por: e.account === 'parceiro' ? 'parceiro:' + (e.account_person || '') : 'casa', voltar: here }) %>'><%- icon('pencil', 14) %></button>
      <% } else if (e.status === 'pago') { %>
        <form method="post" action="/financeiro/lancamentos/<%= e.id %>/desfazer" class="inline"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="voltar" value="<%= here %>"><button class="link small" type="submit">Desfazer</button></form>
      <% } else { %>
        <span class="badge b-st-cancelado">Cancelado</span>
      <% } %>
    <% } %>
  </span>
</li>
