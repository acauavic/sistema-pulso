<%#
  Instagram: collab (até 3) e marcação de pessoas, com busca e seleção múltipla. Só aparece quando o Instagram está marcado
  (o JS liga e desliga). Variáveis: episodeId (sugere o @ do convidado), photo (true = post/carrossel: marcação com posição na imagem),
  img (endereço da imagem para posicionar; no "Novo post" vem do item escolhido).
%>
<fieldset class="igp" data-ig-people data-episode="<%= locals.episodeId || '' %>" data-photo="<%= locals.photo ? '1' : '0' %>" data-img="<%= locals.img || '' %>" hidden>
  <legend><%- icon('instagram', 14) %> Instagram</legend>
  <div class="igp-field" data-igp="collab" data-max="3">
    <div class="igp-head"><strong>Collab</strong><span class="small muted">até 3 perfis · o post aparece também no perfil de quem aceitar o convite</span></div>
    <div class="igp-box">
      <span class="igp-chips" data-igp-chips></span>
      <input type="text" placeholder="Buscar convidado ou digitar @perfil" autocomplete="off" spellcheck="false" data-igp-input role="combobox" aria-autocomplete="list" aria-expanded="false" aria-label="Buscar perfil para collab">
    </div>
    <ul class="plain igp-list" data-igp-list role="listbox" hidden></ul>
  </div>
  <div class="igp-field" data-igp="tag" data-max="20">
    <div class="igp-head"><strong>Marcar pessoas</strong><span class="small muted"><%= locals.photo ? 'toque na imagem para posicionar cada marcação' : 'aparecem marcadas no vídeo' %></span></div>
    <div class="igp-box">
      <span class="igp-chips" data-igp-chips></span>
      <input type="text" placeholder="Buscar ou digitar @perfil" autocomplete="off" spellcheck="false" data-igp-input role="combobox" aria-autocomplete="list" aria-expanded="false" aria-label="Buscar perfil para marcar">
    </div>
    <ul class="plain igp-list" data-igp-list role="listbox" hidden></ul>
  </div>
  <% if (locals.photo) { %>
  <div class="igp-place" data-igp-place hidden>
    <div class="igp-stage" data-igp-stage><img alt="Imagem do post: toque para posicionar a marcação" data-igp-img></div>
    <p class="small muted" data-igp-hint></p>
  </div>
  <% } %>
  <template data-igp-icons><span data-i="x"><%- icon('x', 12) %></span><span data-i="map-pin"><%- icon('map-pin', 12) %></span></template>
</fieldset>
<script src="/static/igpeople.js?v=<%= assetV %>" defer></script>
