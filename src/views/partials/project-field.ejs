<%# Campo Projeto, o primeiro do formulário de criação: só aparece para quem participa de mais de um projeto e está em
    "Todos os projetos". Com um projeto escolhido no menu (ou um projeto só), o item nasce nele e nada aparece.
    Variáveis: value (id já escolhido, ao voltar de um erro); general: true mostra a opção "Geral" (tarefa sem projeto), já marcada;
    hint: frase curta embaixo (opcional). %>
<% if (projectScope && projectScope.multi && !projectScope.current) {
     var _pv = typeof value !== 'undefined' && value != null ? String(value) : '';
     var _general = typeof general !== 'undefined' && general;
     var _hint = typeof hint !== 'undefined' ? hint : ''; %>
<fieldset class="seg-radio project-field"><legend>Projeto<%= _general ? '' : ' *' %></legend>
  <% if (_general) { %><label><input type="radio" name="project_id" value=""<%= _pv === '' ? ' checked' : '' %>><span>Geral</span></label><% } %>
  <% projectScope.projects.forEach(function (p) { %><label><input type="radio" name="project_id" value="<%= p.id %>"<%= _pv === String(p.id) ? ' checked' : '' %><%= _general ? '' : ' required' %>><span><%= p.name %></span></label><% }) %>
  <% if (_hint) { %><small class="muted"><%= _hint %></small><% } %>
</fieldset>
<% } %>
