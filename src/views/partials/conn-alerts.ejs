<%# Contas de redes desconectadas ou para reconectar (res.locals.socialProblems, só para quem mexe com social ou integrações). %>
<% (locals.socialProblems || []).forEach(function (pr) { %><p class="conn-alert small" role="alert"><%- icon('unlink', 14) %> <span><strong><%= pr.text %>.</strong> Enquanto isso, as publicações nessa rede falham. <% if (locals.can && can('integrations.manage')) { %><a href="/integracoes#redes">Ver em Integrações</a> · <% } %><a href="<%= pr.dashboard %>" target="_blank" rel="noopener noreferrer">Reconectar no painel <%= pr.of %></a></span></p><% }) %>
