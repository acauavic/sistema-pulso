<%# Abas do painel de gestão. Variável: active (chave da aba). %>
<% var tabs = [
  ['geral', '/gestao', 'Visão geral', ['users.read', 'audit.read', 'notifications.manage', 'routines.manage', 'reminders.manage', 'search.manage', 'integrations.manage', 'plans.manage', 'outreach.manage']],
  ['usuarios', '/usuarios', 'Usuários', ['users.read']],
  ['cadencia', '/gestao/cadencia', 'Cadência', ['outreach.manage']],
  ['logs', '/auditoria', 'Logs', ['audit.read']],
  ['notificacoes', '/gestao/notificacoes', 'Notificações', ['notifications.manage']],
  ['rotinas', '/gestao/rotinas', 'Rotinas de tarefas', ['routines.manage']],
  ['lembretes', '/gestao/lembretes', 'Lembretes da gravação', ['reminders.manage']],
  ['planos', '/gestao/patrocinios', 'Planos de patrocínio', ['plans.manage']],
  ['busca', '/gestao/busca', 'Busca global', ['search.manage']],
  ['integracoes', '/integracoes', 'Integrações', ['integrations.manage']],
  ['sistema', '/gestao/sistema', 'Sistema', ['integrations.manage']],
]; %>
<nav class="subnav" aria-label="Painel de gestão">
  <% tabs.forEach(function (t) { if (!t[3].some(function (p) { return can(p); })) return; %><a href="<%= t[1] %>" class="<%= active === t[0] ? 'on' : '' %>"<%- active === t[0] ? ' aria-current="page"' : '' %>><%= t[2] %></a><% }) %>
</nav>
