<%# Marca do painel (Health Scale Studio; docs/design-system.md). variant 'menu': ícone + duas linhas em mono (recolhido, só o ícone).
    variant 'sign': a assinatura (logotipo Health Scale + filete + STUDIO) do login e das páginas sem menu. %>
<% if (variant === 'menu') { %><a class="brand brand-menu" href="/" aria-label="Health Scale Studio: início"><img class="brand-mark" src="/static/favicon.svg?v=<%= assetV %>" alt="" width="36" height="36"><span class="brand-text"><span class="brand-house">HEALTH SCALE</span><span class="brand-name">STUDIO</span></span></a><% } else { %><div class="brand brand-sign" role="img" aria-label="Health Scale Studio"><img class="brand-logo" src="/static/brand/studio/health-scale-logo.png?v=<%= assetV %>" alt="" width="720" height="114"><span class="brand-rule"></span><span class="brand-name">STUDIO</span></div><% } %>
