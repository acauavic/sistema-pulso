version: "3.8"

# Stack de referência (Docker Swarm + Traefik) do módulo "Pulso Gestão".
# Copie para stack.yml, preencha os valores reais (NUNCA commite o stack.yml com segredos)
# e ajuste rede overlay, domínios e resolver de certificado ao seu ambiente.
#
# Dois serviços com a MESMA imagem:
#   - pulso_gestao (ROLE=web): o painel. Pode ter várias réplicas (sessão, limitador e avisos ficam no Postgres).
#   - pulso_worker (ROLE=worker): fila em segundo plano (FFmpeg, transcrição, IA, e-mails) e rotinas automáticas
#     (publicar agendados, automações de comentários, avisos de tarefas, limpeza). 1 réplica basta; mais réplicas dividem a fila.
# Fila, rotinas, tempo real e limitador usam o Postgres (SKIP LOCKED, travas consultivas, LISTEN/NOTIFY): não precisa de Redis.
#
# Não usa basic auth do Traefik: o painel tem login próprio, e o convite (/convite/*) precisa ser público.

x-env: &env
  PORT: "3100"
  APP_BASE_URL: "https://gestao.podcastpulso.com"
  # Opcional: servir os convites em outro domínio (adicione o Host no router abaixo)
  PUBLIC_BASE_URL: ""
  PODCAST_NAME: "Podcast Pulso"
  SESSION_SECRET: ""
  PODCAST_DATABASE_URL: "postgresql://usuario:senha@postgres:5432/pulso"
  BREVO_SERVER: "smtp-relay.brevo.com"
  BREVO_PORT: "587"
  BREVO_USER: ""
  BREVO_CHAVE_SMTP: ""
  BREVO_EMAIL: ""
  YOURLS_LINK: "link.podcastpulso.com"
  YOURLS_KEY: ""
  TZ: "America/Sao_Paulo"

services:
  pulso_gestao:
    image: pulso-gestao:1
    networks:
      - BrunoNet
    environment:
      <<: *env
      ROLE: "web"
    deploy:
      replicas: 2
      restart_policy:
        condition: any
        delay: 5s
      labels:
        - "traefik.enable=true"
        - "traefik.http.routers.pulso_gestao.rule=Host(`gestao.podcastpulso.com`)"
        # Se usar PUBLIC_BASE_URL em outro domínio, troque a regra acima por:
        # Host(`gestao.podcastpulso.com`) || (Host(`kit.podcastpulso.com`) && (PathPrefix(`/convite`) || PathPrefix(`/static`)))
        - "traefik.http.routers.pulso_gestao.entrypoints=websecure"
        - "traefik.http.routers.pulso_gestao.tls.certresolver=letsencryptresolver"
        - "traefik.http.services.pulso_gestao.loadbalancer.server.port=3100"
        - "traefik.http.services.pulso_gestao.loadbalancer.passhostheader=1"

  pulso_worker:
    image: pulso-gestao:1
    networks:
      - BrunoNet
    environment:
      <<: *env
      ROLE: "worker"
    deploy:
      replicas: 1
      restart_policy:
        condition: any
        delay: 5s
      resources:
        limits:
          memory: 2G # FFmpeg e leitura de vídeo

networks:
  BrunoNet:
    external: true
